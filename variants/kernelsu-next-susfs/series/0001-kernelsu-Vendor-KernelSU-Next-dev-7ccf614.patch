+#define STATX_F_INO		STATX_INO
+#define STATX_F_NLINK		STATX_NLINK
+#define STATX_F_SIZE		STATX_SIZE
+#define STATX_F_BLOCKS		STATX_BLOCKS
+
+struct susfs_statx_offs {
+	unsigned short dev, dev_minor, ino, nlink, size, blksize, blocks;
+	unsigned short atime_sec, atime_nsec, mtime_sec, mtime_nsec,
+		       ctime_sec, ctime_nsec, mask;
+};
+
+static const struct susfs_statx_offs kstat_statx_offs = {
+	.dev = offsetof(struct statx, stx_dev_major),
+	/* statx is the one family that hands out the two device halves separately; the table
+	 * stores the encoded value st_dev carries, so the lookup key has to be rebuilt from
+	 * both halves before the lookup below. */
+	.dev_minor = offsetof(struct statx, stx_dev_minor),
+	.ino = offsetof(struct statx, stx_ino),
+	.nlink = offsetof(struct statx, stx_nlink),
+	.size = offsetof(struct statx, stx_size),
+	.blksize = offsetof(struct statx, stx_blksize),
+	.blocks = offsetof(struct statx, stx_blocks),
+	.atime_sec = offsetof(struct statx, stx_atime),
+	.atime_nsec = offsetof(struct statx, stx_atime) + offsetof(struct timespec64, tv_nsec),
+	.mtime_sec = offsetof(struct statx, stx_mtime),
+	.mtime_nsec = offsetof(struct statx, stx_mtime) + offsetof(struct timespec64, tv_nsec),
+	.ctime_sec = offsetof(struct statx, stx_ctime),
+	.ctime_nsec = offsetof(struct statx, stx_ctime) + offsetof(struct timespec64, tv_nsec),
+	.mask = offsetof(struct statx, stx_mask),
+};
+
+static_assert(offsetof(struct statx, stx_mask) == 0x00, "statx.stx_mask");
+static_assert(offsetof(struct statx, stx_blksize) == 0x04, "statx.stx_blksize");
+static_assert(offsetof(struct statx, stx_attributes) == 0x08, "statx.stx_attributes");
+static_assert(offsetof(struct statx, stx_nlink) == 0x10, "statx.stx_nlink");
+static_assert(offsetof(struct statx, stx_ino) == 0x20, "statx.stx_ino");
+static_assert(offsetof(struct statx, stx_size) == 0x28, "statx.stx_size");
+static_assert(offsetof(struct statx, stx_blocks) == 0x30, "statx.stx_blocks");
+static_assert(offsetof(struct statx, stx_atime) == 0x40, "statx.stx_atime");
+static_assert(offsetof(struct statx, stx_btime) == 0x50, "statx.stx_btime");
+static_assert(offsetof(struct statx, stx_ctime) == 0x60, "statx.stx_ctime");
+static_assert(offsetof(struct statx, stx_mtime) == 0x70, "statx.stx_mtime");
+
+static_assert(offsetof(struct statx, stx_dev_major) == 0x88, "statx.stx_dev_major");
+static_assert(offsetof(struct statx, stx_dev_minor) == 0x8c, "statx.stx_dev_minor");
+static_assert(offsetof(struct statx, stx_mnt_id) == 0x90, "statx.stx_mnt_id");
+static_assert(sizeof(struct statx) == 256, "statx size");
+static_assert(sizeof(((struct statx *)0)->stx_ino) == 8, "statx stx_ino is u64");
+static_assert(sizeof(((struct statx *)0)->stx_size) == 8, "statx stx_size is u64");
+
+/* Read a field of the buffer, write the spoofed value back only when the mask carries the field. */
+#define STATX_FIELD_U64(off, val, mbit)						\
+	do {									\
+		if (eff & (mbit)) {						\
+			u64 __v = (u64)(val);					\
+										\
+			if (copy_to_user((void __user *)(sbuf + (off)), &__v,	\
+					 sizeof(__v))) {			\
+				atomic_inc(&st->cnt->uaccess);			\
+				return false;					\
+			}							\
+			rewrote = true;						\
+		}								\
+	} while (0)
+
+#define STATX_FIELD_S32(off, val, mbit)						\
+	do {									\
+		if (eff & (mbit)) {						\
+			s32 __v = (s32)(val);					\
+			u32 __u = (u32)__v;					\
+										\
+			if (copy_to_user((void __user *)(sbuf + (off)), &__u,	\
+					 sizeof(__u))) {			\
+				atomic_inc(&st->cnt->uaccess);			\
+				return false;					\
+			}							\
+			rewrote = true;						\
+		}								\
+	} while (0)
+
+#define STATX_FIELD_U32(off, val, mbit)						\
+	do {									\
+		if (eff & (mbit)) {						\
+			u32 __v = (u32)(val);					\
+										\
+			if (copy_to_user((void __user *)(sbuf + (off)), &__v,	\
+					 sizeof(__v))) {			\
+				atomic_inc(&st->cnt->uaccess);			\
+				return false;					\
+			}							\
+			rewrote = true;						\
+		}								\
+	} while (0)
+
+/* returns true when the buffer was really changed */
+static bool susfs_kstat_spoof_statx(struct kstat_call_state *st, unsigned long sbuf,
+				    u32 req_mask)
+{
+	const struct susfs_statx_offs *o = &kstat_statx_offs;
+	struct sus_kstat_snapshot snap;
+	const struct sus_kstat_snapshot *e = &snap;
+	unsigned long ino = 0;
+	unsigned int dev = 0;
+	u32 dev_major = 0, dev_minor = 0;
+	u32 buf_mask = 0, eff;
+	bool rewrote = false;
+
+	if (susfs_kstat_table_empty()) {
+		atomic_inc(&st->cnt->miss_empty);
+		return false;
+	}
+	if (!susfs_kstat_gate_ok()) {
+		atomic_inc(&st->cnt->miss_gate);
+		return false;
+	}
+
+	if (copy_from_user(&ino, (void __user *)(sbuf + o->ino), sizeof(ino))) {
+		atomic_inc(&st->cnt->uaccess);
+		return false;
+	}
+	/* statx reports the device as two halves, while the table stores the ENCODED value the
+	 * other stat families put in st_dev (sus_kstat_entry.dev): read both halves and encode
+	 * them the same way, or the lookup key can never match and the whole statx spoof is dead.
+	 * (Reading only stx_dev_major here is exactly that bug.) */
+	if (copy_from_user(&dev_major, (void __user *)(sbuf + o->dev), sizeof(dev_major))) {
+		atomic_inc(&st->cnt->uaccess);
+		return false;
+	}
+	if (copy_from_user(&dev_minor, (void __user *)(sbuf + o->dev_minor), sizeof(dev_minor))) {
+		atomic_inc(&st->cnt->uaccess);
+		return false;
+	}
+	dev = new_encode_dev(MKDEV(dev_major, dev_minor));
+	if (copy_from_user(&buf_mask, (void __user *)(sbuf + o->mask), sizeof(buf_mask))) {
+		atomic_inc(&st->cnt->uaccess);
+		return false;
+	}
+
+	if (!susfs_kstat_lookup(ino, dev, &snap)) {
+		atomic_inc(&st->cnt->miss_lookup);
+		return false;
+	}
+	if (!susfs_kstat_rule_allows(&snap))
+		return false;
+
+	eff = req_mask | buf_mask;
+
+	if (e->flags & KSTAT_SPOOF_INO)
+		STATX_FIELD_U64(o->ino, e->spoofed_ino, STATX_F_INO);
+	if (e->flags & KSTAT_SPOOF_NLINK)
+		STATX_FIELD_U32(o->nlink, e->spoofed_nlink, STATX_F_NLINK);
+	if (e->flags & KSTAT_SPOOF_SIZE)
+		STATX_FIELD_U64(o->size, e->spoofed_size, STATX_F_SIZE);
+	if (e->flags & KSTAT_SPOOF_BLOCKS)
+		STATX_FIELD_U64(o->blocks, e->spoofed_blocks, STATX_F_BLOCKS);
+
+	if (e->flags & KSTAT_SPOOF_BLKSIZE) {
+		s32 v = (s32)e->spoofed_blksize;
+
+		if (copy_to_user((void __user *)(sbuf + o->blksize), &v, sizeof(v))) {
+			atomic_inc(&st->cnt->uaccess);
+			return false;
+		}
+		rewrote = true;
+	}
+	if (e->flags & KSTAT_SPOOF_ATIME_TV_SEC)
+		STATX_FIELD_S32(o->atime_sec, e->spoofed_atime_tv_sec, STATX_ATIME);
+	if (e->flags & KSTAT_SPOOF_ATIME_TV_NSEC)
+		STATX_FIELD_U32(o->atime_nsec, e->spoofed_atime_tv_nsec, STATX_ATIME);
+	if (e->flags & KSTAT_SPOOF_MTIME_TV_SEC)
+		STATX_FIELD_S32(o->mtime_sec, e->spoofed_mtime_tv_sec, STATX_MTIME);
+	if (e->flags & KSTAT_SPOOF_MTIME_TV_NSEC)
+		STATX_FIELD_U32(o->mtime_nsec, e->spoofed_mtime_tv_nsec, STATX_MTIME);
+	if (e->flags & KSTAT_SPOOF_CTIME_TV_SEC)
+		STATX_FIELD_S32(o->ctime_sec, e->spoofed_ctime_tv_sec, STATX_CTIME);
+	if (e->flags & KSTAT_SPOOF_CTIME_TV_NSEC)
+		STATX_FIELD_U32(o->ctime_nsec, e->spoofed_ctime_tv_nsec, STATX_CTIME);
+
+	if ((e->flags & KSTAT_SPOOF_DEV) && (eff & STATX_BASIC_STATS)) {
+		unsigned int enc = (unsigned int)e->spoofed_dev;
+		/* stx_dev_major/minor are u32 each: write all four bytes of each half.  Writing a u16
+		 * per half would leave the upper bytes of the real device number behind for any minor
+		 * that does not fit 16 bits. */
+		unsigned int maj = (enc & 0xfff00u) >> 8;
+		unsigned int min = MINOR(new_decode_dev(enc));
+
+		if (copy_to_user((void __user *)(sbuf + o->dev), &maj, sizeof(maj))) {
+			atomic_inc(&st->cnt->uaccess);
+			return false;
+		}
+		if (copy_to_user((void __user *)(sbuf + o->dev_minor), &min, sizeof(min))) {
+			atomic_inc(&st->cnt->uaccess);
+			return false;
+		}
+		rewrote = true;
+	}
+
+	if (!rewrote) {
+		atomic_inc(&st->cnt->match_noflag);
+		return false;
+	}
+
+	atomic_inc(&st->cnt->rewrite);
+	return true;
+}
+
+/* The post-check, called at the TAIL of the table-entry wrapper (see kstat_hooks[] below) instead
+ * of from a entry tail.  Two features ride it, exactly as before: the stat family below,
+ * and sus_path's directory-listing rewrite.  The listing side still needs its own gate - see the
+ * note above sus_path_dirent_layout_id(): a syscall number alone does not identify a call (arm64's
+ * native 141 is getpriority where AArch32 numbers getdents 141), so the number is only ever read
+ * together with the caller's ABI - and here the ABI is not a guess, it is which table the wrapper
+ * was installed in.
+ *
+ * WHAT CHANGED, AND WHY.  As a tracepoint this ran for EVERY syscall exit, so is_compat_task(),
+ * syscall_get_nr() and the two classifiers below were paid on all of them - measured at ~28 ns per
+ * syscall when the stat family moved onto it (getpid 113 -> 141 ns), and re-measured at the time of
+ * this change as 126 ns without the tracepoint vs 151 ns with it (three runs each, +25..31 ns), on
+ * the same device the module ships to.  As a wrapper tail it runs only for the thirteen numbers in
+ * kstat_hooks[], and both the "which ABI" and the "which syscall" questions are answered by which
+ * table entry was called rather than by a test that every syscall has to pay for.  Nothing is lost:
+ * the arguments arrive from the wrapper, which copies them out of regs BEFORE calling the original
+ * (a syscall's return value lands in regs->regs[0], so reading them afterwards would hand the
+ * spoofers the return value in place of the first argument).
+ *
+ * The old KNOWN BOUNDARY (ptrace) went away with the tracepoint: arch/arm64/kernel/syscall.c
+ * writes regs->syscallno = scno before syscall_trace_enter(), so a tracer that rewrote a getdents64
+ * into another syscall was still classified as getdents64 here.  A tracer cannot rewrite which
+ * table entry the kernel calls, so this dispatch is on what was really called.
+ *
+ * `out` is the wrapper's answer and starts at the original's return value: the stat family rewrites
+ * the caller's buffer and leaves the return value alone, while the listing filter shortens the count
+ * and must hand that back - the tracepoint did it with syscall_set_return_value(), which a wrapper
+ * has no regs to do it with. */
+static __nocfi void susfs_kstat_post(long nr, bool compat, const unsigned long *args,
+				     long ret, long *out)
+{
+	struct kstat_call_counters *c;
+	struct kstat_call_state st;
+	int lay = sus_path_dirent_layout_id(nr, compat);
+
+	if (lay >= 0) {
+		long rc;
+
+		/* Nothing to rewrite when the syscall produced no bytes (an error, or the end of
+		 * the directory), and the arguments must not be read before the gate said this
+		 * really is a listing call: the filter is told "no buffer, nothing produced" and
+		 * returns without touching the caller's memory.
+		 * The number alone does not identify the call (native 141 is getpriority, not
+		 * the AArch32 getdents): sus_path_dirent_layout_id() gates it on the ABI, so
+		 * anything that is not really a listing leaves here before the arguments are
+		 * read.
+		 * The armed flag is not tested here any more: sus_path_dirent_filter() checks
+		 * it itself, together with ret <= 0 and a NULL buffer, so a second gate at this
+		 * call site only duplicated it while looking like coverage. */
+		if (ret <= 0) {
+			sus_path_dirent_filter(lay, 0, ret);
+			return;
+		}
+		/* The arguments come from the wrapper now - see the note above. */
+		rc = sus_path_dirent_filter(lay,
+					    compat ? (unsigned long)compat_ptr((u32)args[1])
+						   : args[1],
+					    ret);
+		if (rc != ret)
+			*out = rc;
+		return;
+	}
+
+	/* ---- stat family: number -> counters -> argument positions ----
+	 * Gated on the ABI for the same reason as the listing numbers above: on arm64 the native
+	 * table's 195/196/197 are shmctl/shmat/shmdt, and shmat's second argument is a mapped
+	 * address - read as a compat struct stat64 buffer it would hand back whatever the caller
+	 * happens to have there, and on a rule hit rewrite it. */
+	if (compat) {
+		switch (nr) {
+		case COMPAT_FSTATAT64_NR:
+			c = &cnt_fstatat64;
+			break;
+		case COMPAT_STAT64_NR:
+			c = &cnt_stat64;
+			break;
+		case COMPAT_LSTAT64_NR:
+			c = &cnt_lstat64;
+			break;
+		case COMPAT_FSTAT64_NR:
+			c = &cnt_fstat64;
+			break;
+		case COMPAT_STAT_NR:
+		case COMPAT_LSTAT_NR:
+		case COMPAT_FSTAT_NR:
+			/* struct compat_stat, NOT struct stat64 - see the offsets and the widths
+			 * above; the two differ in every field after st_ino. */
+			c = &cnt_compat_stat;
+			break;
+		case COMPAT_STATX_NR:
+			/* A counter of its own: "64-bit statx is spoofed" says nothing about the
+			 * 32-bit one, and mixing them is how a 32-bit-only gap stayed invisible. */
+			c = &cnt_compat_statx;
+			break;
+		default:
+			c = NULL;
+			break;
+		}
+	} else {
+		switch (nr) {
+		case __NR_newfstatat:
+			c = &cnt_nfstatat;
+			break;
+		case __NR_fstat:
+			/* fstat(fd, statbuf): the buffer is args[1], not args[2]. */
+			c = &cnt_nfstat;
+			break;
+		case __NR_statx:
+			c = &cnt_statx;
+			break;
+		default:
+			c = NULL;
+			break;
+		}
+	}
+
+	if (!c) {
+		/* A listing number cannot reach this point any more: the gate at the top of this
+		 * function answers both getdents ABIs before the stat switch, so only the stat
+		 * range is worth noting here. */
+		if (nr >= KSTAT_NR_SCAN_LO && nr <= KSTAT_NR_SCAN_HI)
+			kstat_note_unlisted(nr);
+		return;
+	}
+
+	/* Whitelisted: from here on only this number's counters move. */
+	if (ret != 0) {
+		atomic_inc(&c->ret_err);
+		return;
+	}
+	atomic_inc(&c->calls);
+
+	st.cnt = c;
+	st.compat = compat;	/* the ABI that selected the number above */
+
+	/* The statbuf argument is NOT the same one for every syscall, so the NULL check has to live
+	 * inside each branch: fstat64(fd, statbuf) keeps it in args[1], and checking args[2] first
+	 * made every 32-bit fstat64() return early - the rule applied to fstatat64, not to fstat64. */
+	/* Argument positions differ per number, so this stays a number switch - but only numbers
+	 * the gate above selected for THIS ABI can reach it, and the two ABIs' number sets
+	 * (79/80/291 native; 106/107/108, 195/196/197, 327, 397 compat) do not overlap, so it needs
+	 * no gate of its own. */
+	switch (nr) {
+	case __NR_newfstatat:
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[2]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_statbuf(&st, args[2]);
+		return;
+	case __NR_fstat:
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[1]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_statbuf(&st, args[1]);
+		return;
+	case __NR_statx:
+	case COMPAT_STATX_NR:	/* 397 IS the native statx body: same buffer, same mask, 32-bit ptr */
+
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[4]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_statx(&st,
+			st.compat ? (unsigned long)compat_ptr((u32)args[4]) : args[4],
+			(u32)args[3]);
+		return;
+	case COMPAT_FSTATAT64_NR:
+
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[2]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_compat_statbuf(&st, (unsigned long)compat_ptr((u32)args[2]));
+		return;
+	case COMPAT_STAT64_NR:
+	case COMPAT_LSTAT64_NR:
+	case COMPAT_FSTAT64_NR:
+
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[1]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_compat_statbuf(&st, (unsigned long)compat_ptr((u32)args[1]));
+		return;
+	case COMPAT_STAT_NR:
+	case COMPAT_LSTAT_NR:
+	case COMPAT_FSTAT_NR:
+
+		/* stat(path, statbuf), lstat(path, statbuf), fstat(fd, statbuf): the buffer is
+		 * args[1] in all three (fs/stat.c: COMPAT_SYSCALL_DEFINE2(newstat, filename,
+		 * statbuf) and DEFINE2(newfstat, fd, statbuf)).  struct compat_stat, so the
+		 * write-back is susfs_kstat_spoof_compat_stat(), not the one above. */
+		/* The arguments come from the wrapper now - see the note above. */
+		if (!args[1]) {
+			atomic_inc(&c->no_buf);
+			return;
+		}
+		susfs_kstat_spoof_compat_stat(&st, (unsigned long)compat_ptr((u32)args[1]));
+		return;
+	}
+}
+
+/* ==== the sys_call_table entries that drive the post-check above ==== */
+/*
+ * This is what replaced the stat layer's table entries.  Thirteen entries, one per (number, ABI)
+ * pair, because the two questions that tracepoint had to answer on EVERY syscall - "which ABI is
+ * the caller" and "which number is this" - are both answered here by which entry was called: a
+ * 32-bit task never reaches sys_call_table, and the compat table does not share its numbering with
+ * the native one (AArch32 141 is getdents where arm64's 141 is getpriority; its 195/196/197 are
+ * stat64/lstat64/fstat64 where the native ones are shmctl/shmat/shmdt).
+ *
+ * WHY IT MOVED.  As a tracepoint the callback ran on every syscall exit and paid
+ * is_compat_task(), syscall_get_nr() and two classifiers for all of them.  Measured on the device
+ * before this change, on the getpid line of susfs_bench (no entry of ours is involved there, so it
+ * is the cost of whatever fires on every syscall):
+ *
+ *     kstat layer forced off (fail_layer=10)   126 / 126 / 126 ns   <- no tracepoint
+ *     everything armed                        151 / 150 / 151 ns   <- tracepoint registered
+ *
+ * i.e. +25..31 ns per syscall, on every syscall, whether or not it is one this module cares about.
+ * Now only these thirteen numbers pay anything, and both classifiers went away with the tracepoint.
+ *
+ * Arguments are copied out of regs BEFORE the original runs: a syscall's return value is written
+ * into regs->regs[0] (arch/arm64/kernel/syscall.c, and the compat entry point does the same), so
+ * reading them afterwards would hand the spoofers the return value in place of the first argument.
+ *
+ * __nocfi is mandatory on the wrapper, for the reason susfs_opath.c states at length: it is reached
+ * by an indirect call out of the kernel's table, and it calls the original the same way.  The NULL
+ * test on the slot is not about publish order - susfs_fp_install() publishes the original before it
+ * writes the table - it is what turns a future mistake there into one failed syscall instead of a
+ * jump to address 0.
+ *
+ * nr < 0 means "this number exists in the compat table only" (struct susfs_fp_hook spells that
+ * out); every AArch32 entry below is one of those, because its native namesake is a different
+ * syscall.  The .sym fields are for the diagnostic dump only - susfs_fp_dump_entry() resolves them
+ * by name - so one that does not match what this kernel calls the entry shows up as "no symbol"
+ * there and changes nothing about the hook itself.
+ */
+static susfs_syscall_fn_t kstat_orig_nfstatat;
+static susfs_syscall_fn_t kstat_orig_fstat;
+static susfs_syscall_fn_t kstat_orig_statx;
+static susfs_syscall_fn_t kstat_orig_getdents64;
+static susfs_syscall_fn_t kstat_orig_compat_stat64;
+static susfs_syscall_fn_t kstat_orig_compat_lstat64;
+static susfs_syscall_fn_t kstat_orig_compat_fstat64;
+static susfs_syscall_fn_t kstat_orig_compat_fstatat64;
+static susfs_syscall_fn_t kstat_orig_compat_stat;
+static susfs_syscall_fn_t kstat_orig_compat_lstat;
+static susfs_syscall_fn_t kstat_orig_compat_fstat;
+static susfs_syscall_fn_t kstat_orig_compat_statx;
+static susfs_syscall_fn_t kstat_orig_compat_getdents64;
+static susfs_syscall_fn_t kstat_orig_compat_getdents;
+
+#define SUSFS_KSTAT_WRAPPER(fn, slot, nrval, combat)			\
+	static __nocfi long fn(const struct pt_regs *regs)		\
+	{								\
+		susfs_syscall_fn_t orig = READ_ONCE(slot);		\
+		unsigned long a[6];					\
+		long ret, out;						\
+									\
+		if (!orig)						\
+			return -ENOSYS;					\
+		/* susfs_syscall_fn_t takes a const regs (the table's own type) while	\
+		 * syscall_get_arguments() asks for a non-const one it only reads - the	\
+		 * cast is what that difference costs, and nothing here writes regs. */	\
+		syscall_get_arguments(current, (struct pt_regs *)regs, a);	\
+		ret = orig(regs);					\
+		out = ret;						\
+		susfs_kstat_post(nrval, combat, a, ret, &out);		\
+		return out;						\
+	}
+
+SUSFS_KSTAT_WRAPPER(kstat_wrap_nfstatat, kstat_orig_nfstatat, __NR_newfstatat, false)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_fstat, kstat_orig_fstat, __NR_fstat, false)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_statx, kstat_orig_statx, __NR_statx, false)
+/* getdents64 does NOT use the shared macro: sus_dirent.c can answer it without the original
+ * ever writing to the caller's buffer, which is what removes the two tells the post-hoc
+ * filter leaves (the d_ino = 0 placeholder, and the scrub that can be faulted).  When that
+ * layer declines - unresolved symbol, prefilter=0 - this falls back to exactly what the
+ * macro does, so hiding continues either way. */
+static __nocfi long kstat_wrap_getdents64(const struct pt_regs *regs)
+{
+	susfs_syscall_fn_t orig = READ_ONCE(kstat_orig_getdents64);
+	unsigned long a[6];
+	long ret, out;
+
+	if (!orig)
+		return -ENOSYS;
+	if (susfs_dirent_prefilter(regs, &out, false))
+		return out;
+	syscall_get_arguments(current, (struct pt_regs *)regs, a);
+	ret = orig(regs);
+	out = ret;
+	susfs_kstat_post(__NR_getdents64, false, a, ret, &out);
+	return out;
+}
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_stat64, kstat_orig_compat_stat64, COMPAT_STAT64_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_lstat64, kstat_orig_compat_lstat64, COMPAT_LSTAT64_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_fstat64, kstat_orig_compat_fstat64, COMPAT_FSTAT64_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_fstatat64, kstat_orig_compat_fstatat64, COMPAT_FSTATAT64_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_stat, kstat_orig_compat_stat, COMPAT_STAT_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_lstat, kstat_orig_compat_lstat, COMPAT_LSTAT_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_fstat, kstat_orig_compat_fstat, COMPAT_FSTAT_NR, true)
+SUSFS_KSTAT_WRAPPER(kstat_wrap_compat_statx, kstat_orig_compat_statx, COMPAT_STATX_NR, true)
+static __nocfi long kstat_wrap_compat_getdents64(const struct pt_regs *regs)
+{
+	susfs_syscall_fn_t orig = READ_ONCE(kstat_orig_compat_getdents64);
+	unsigned long a[6];
+	long ret, out;
+
+	if (!orig)
+		return -ENOSYS;
+	if (susfs_dirent_prefilter(regs, &out, false))
+		return out;
+	syscall_get_arguments(current, (struct pt_regs *)regs, a);
+	ret = orig(regs);
+	out = ret;
+	susfs_kstat_post(SUS_NR_GETDENTS64_COMPAT, true, a, ret, &out);
+	return out;
+}
+
+static __nocfi long kstat_wrap_compat_getdents(const struct pt_regs *regs)
+{
+	susfs_syscall_fn_t orig = READ_ONCE(kstat_orig_compat_getdents);
+	unsigned long a[6];
+	long ret, out;
+
+	if (!orig)
+		return -ENOSYS;
+	if (susfs_dirent_prefilter(regs, &out, true))
+		return out;
+	syscall_get_arguments(current, (struct pt_regs *)regs, a);
+	ret = orig(regs);
+	out = ret;
+	susfs_kstat_post(SUS_NR_GETDENTS_COMPAT, true, a, ret, &out);
+	return out;
+}
+
+static struct susfs_fp_hook kstat_hooks[] = {
+	{ .nr = __NR_newfstatat, .nr_compat = 0, .name = "kstat/newfstatat",
+	  .sym = "__arm64_sys_newfstatat",
+	  .wrapper = kstat_wrap_nfstatat, .orig_slot = &kstat_orig_nfstatat },
+	{ .nr = __NR_fstat, .nr_compat = 0, .name = "kstat/fstat",
+	  .sym = "__arm64_sys_fstat",
+	  .wrapper = kstat_wrap_fstat, .orig_slot = &kstat_orig_fstat },
+	{ .nr = __NR_statx, .nr_compat = 0, .name = "kstat/statx",
+	  .sym = "__arm64_sys_statx",
+	  .wrapper = kstat_wrap_statx, .orig_slot = &kstat_orig_statx },
+	{ .nr = __NR_getdents64, .nr_compat = 0, .name = "kstat/getdents64",
+	  .sym = "__arm64_sys_getdents64",
+	  .wrapper = kstat_wrap_getdents64, .orig_slot = &kstat_orig_getdents64 },
+
+	/* The AArch32 half.  nr stays -1 for every one of them. */
+	{ .nr = -1, .nr_compat = COMPAT_STAT64_NR, .name = "kstat/compat stat64",
+	  .sym = "__arm64_compat_sys_stat64",
+	  .wrapper = kstat_wrap_compat_stat64, .orig_slot_compat = &kstat_orig_compat_stat64 },
+	{ .nr = -1, .nr_compat = COMPAT_LSTAT64_NR, .name = "kstat/compat lstat64",
+	  .sym = "__arm64_compat_sys_lstat64",
+	  .wrapper = kstat_wrap_compat_lstat64, .orig_slot_compat = &kstat_orig_compat_lstat64 },
+	{ .nr = -1, .nr_compat = COMPAT_FSTAT64_NR, .name = "kstat/compat fstat64",
+	  .sym = "__arm64_compat_sys_fstat64",
+	  .wrapper = kstat_wrap_compat_fstat64, .orig_slot_compat = &kstat_orig_compat_fstat64 },
+	{ .nr = -1, .nr_compat = COMPAT_FSTATAT64_NR, .name = "kstat/compat fstatat64",
+	  .sym = "__arm64_compat_sys_fstatat64",
+	  .wrapper = kstat_wrap_compat_fstatat64, .orig_slot_compat = &kstat_orig_compat_fstatat64 },
+	{ .nr = -1, .nr_compat = COMPAT_STAT_NR, .name = "kstat/compat stat",
+	  .sym = "__arm64_compat_sys_newstat",
+	  .wrapper = kstat_wrap_compat_stat, .orig_slot_compat = &kstat_orig_compat_stat },
+	{ .nr = -1, .nr_compat = COMPAT_LSTAT_NR, .name = "kstat/compat lstat",
+	  .sym = "__arm64_compat_sys_newlstat",
+	  .wrapper = kstat_wrap_compat_lstat, .orig_slot_compat = &kstat_orig_compat_lstat },
+	{ .nr = -1, .nr_compat = COMPAT_FSTAT_NR, .name = "kstat/compat fstat",
+	  .sym = "__arm64_compat_sys_newfstat",
+	  .wrapper = kstat_wrap_compat_fstat, .orig_slot_compat = &kstat_orig_compat_fstat },
+	{ .nr = -1, .nr_compat = COMPAT_STATX_NR, .name = "kstat/compat statx",
+	  .sym = "__arm64_compat_sys_statx",
+	  .wrapper = kstat_wrap_compat_statx, .orig_slot_compat = &kstat_orig_compat_statx },
+	{ .nr = -1, .nr_compat = SUS_NR_GETDENTS64_COMPAT, .name = "kstat/compat getdents64",
+	  .sym = "__arm64_compat_sys_getdents64",
+	  .wrapper = kstat_wrap_compat_getdents64, .orig_slot_compat = &kstat_orig_compat_getdents64 },
+	{ .nr = -1, .nr_compat = SUS_NR_GETDENTS_COMPAT, .name = "kstat/compat getdents",
+	  .sym = "__arm64_compat_sys_getdents",
+	  .wrapper = kstat_wrap_compat_getdents, .orig_slot_compat = &kstat_orig_compat_getdents },
+};
+
+/* ---- path resolution + rule management (original SUSFS semantics) ---- */
+
+/* resolve <path> to its CURRENT (ino, encoded dev).  Sleeps - never call it with kstat_table_lock held. */
+static int susfs_kstat_resolve(const char *path, unsigned long *ino, dev_t *dev)
+{
+	struct path p;
+	struct inode *inode;
+	int err;
+
+	err = kern_path(path, 0, &p);
+	if (err)
+		return err;
+	inode = d_backing_inode(p.dentry);
+	if (!inode) {
+		path_put(&p);
+		return -ENOENT;
+	}
+	*ino = inode->i_ino;
+	*dev = new_encode_dev(inode->i_sb->s_dev);
+	path_put(&p);
+	return 0;
+}
+
+/* resolve <path> and fill the spoofed_* fields with its CURRENT stat (the generic_fillattr
+ * mapping).  Fills a DETACHED entry only: callers build here, then commit through one of the
+ * kstat_table_* helpers, so nothing half-built is ever visible to a reader. */
+static int susfs_kstat_fill_from_path(struct sus_kstat_entry *e, const char *path)
+{
+	struct path p;
+	struct inode *inode;
+	int err;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	/* 6.6 renamed the inode field to __i_ctime and marked it private ("use inode_*_ctime
+	 * accessors!"), so reading it stopped compiling: "no member named 'i_ctime' in 'struct inode'".
+	 * inode_get_ctime() returns the very same struct timespec64 by value, and this gate is
+	 * release-aligned as well as upstream-aligned: v6.6 added the accessor upstream and is also the
+	 * GKI tree boundary.  i_atime/i_mtime went the same way one move later: v6.11 split them into
+	 * time64_t i_atime_sec/i_mtime_sec plus u32 i_atime_nsec/i_mtime_nsec, read through
+	 * inode_get_atime()/inode_get_mtime() - which reassemble the very same struct timespec64 by
+	 * value, and are what the second #if below uses; reading the old fields directly no longer
+	 * compiles there.  The gate is on 6.12 rather than on 6.11 because 6.11 is not a GKI kernel:
+	 * the header trees this module is built against are 6.6 (old fields) and 6.12/6.18 (accessors). */
+	struct timespec64 ctime;
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+	struct timespec64 atime, mtime;
+#endif
+
+	err = kern_path(path, 0, &p);
+	if (err)
+		return err;
+	inode = d_backing_inode(p.dentry);
+	if (!inode) {
+		path_put(&p);
+		return -ENOENT;
+	}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	ctime = inode_get_ctime(inode);
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+	atime = inode_get_atime(inode);
+	mtime = inode_get_mtime(inode);
+#endif
+
+	e->target_ino = inode->i_ino;
+	e->target_dev = new_encode_dev(inode->i_sb->s_dev);
+	e->spoofed_ino = inode->i_ino;
+	e->spoofed_dev = new_encode_dev(inode->i_sb->s_dev);
+	e->spoofed_nlink = inode->i_nlink;
+	e->spoofed_size = inode->i_size;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+	e->spoofed_atime_tv_sec = atime.tv_sec;
+	e->spoofed_atime_tv_nsec = atime.tv_nsec;
+	e->spoofed_mtime_tv_sec = mtime.tv_sec;
+	e->spoofed_mtime_tv_nsec = mtime.tv_nsec;
+#else
+	e->spoofed_atime_tv_sec = inode->i_atime.tv_sec;
+	e->spoofed_atime_tv_nsec = inode->i_atime.tv_nsec;
+	e->spoofed_mtime_tv_sec = inode->i_mtime.tv_sec;
+	e->spoofed_mtime_tv_nsec = inode->i_mtime.tv_nsec;
+#endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	e->spoofed_ctime_tv_sec = ctime.tv_sec;
+	e->spoofed_ctime_tv_nsec = ctime.tv_nsec;
+#else
+	e->spoofed_ctime_tv_sec = inode->i_ctime.tv_sec;
+	e->spoofed_ctime_tv_nsec = inode->i_ctime.tv_nsec;
+#endif
+	e->spoofed_blocks = inode->i_blocks;
+	e->spoofed_blksize = 1 << inode->i_blkbits;
+
+	path_put(&p);
+	return 0;
+}
+
+/* re-resolve only target_ino/target_dev; spoofed values stay untouched.  Resolve first (sleeping),
+ * then re-target under the lock: a reader sees the old pair or the new pair, never ino-of-B with
+ * dev-of-A. */
+static int susfs_kstat_update(const char *path, bool full_clone)
+{
+	struct sus_kstat_entry *e;
+	unsigned long ino;
+	dev_t dev;
+	int err;
+
+	e = susfs_kstat_find_by_path(path);
+	if (!e)
+		return -ENOENT;
+	err = susfs_kstat_resolve(path, &ino, &dev);
+	if (err)
+		return err;
+	kstat_table_retarget((int)(e - kstat_entries), ino, dev,
+			     full_clone ? KSTAT_AUTO_SPOOF_FULL_CLONE
+					: KSTAT_AUTO_SPOOF);
+	return 0;
+}
+
+/* add/update a rule from its pathname; kstat_lock held */
+static int susfs_kstat_add(const char *path)
+{
+	struct sus_kstat_entry tmp;
+	struct sus_kstat_entry *e;
+	int err, idx;
+
+	if (strlen(path) >= KSTAT_PATH_MAX)
+		return -ENAMETOOLONG;
+
+	e = susfs_kstat_find_by_path(path);
+
+	memset(&tmp, 0, sizeof(tmp));
+	err = susfs_kstat_fill_from_path(&tmp, path);
+	if (err)
+		return err;
+	strscpy(tmp.target_pathname, path, KSTAT_PATH_MAX);
+	tmp.flags = KSTAT_AUTO_SPOOF;
+
+	if (e) {
+		kstat_table_put((int)(e - kstat_entries), &tmp);
+		return 0;
+	}
+	idx = kstat_table_append(&tmp);
+	return idx < 0 ? -ENOSPC : 0;
+}
+
+static void susfs_kstat_del(const char *path)
+{
+	struct sus_kstat_entry *e = susfs_kstat_find_by_path(path);
+
+	if (!e)
+		return;
+	kstat_table_del((int)(e - kstat_entries));
+}
+
+/* parse "default" -> *is_default=true, else parse signed 64-bit int */
+static int parse_override(const char *tok, bool *is_default, long long *val)
+{
+	if (!strcmp(tok, "default")) {
+		*is_default = true;
+		return 0;
+	}
+	*is_default = false;
+	return kstrtoll(tok, 10, val);
+}
+
+/* add_sus_kstat_statically: 12 fields follow the path, each a number or "default". */
+static int susfs_kstat_add_statically(char **argv, int argc)
+{
+	struct sus_kstat_entry tmp;
+	struct sus_kstat_entry *e;
+	long long val;
+	bool dflt;
+	int err, i, idx;
+	/* field index -> flag and setter, ordered as the CLI:
+	 * ino dev nlink size atime atime_nsec mtime mtime_nsec
+	 * ctime ctime_nsec blocks blksize */
+	static const unsigned int f_flags[12] = {
+		KSTAT_SPOOF_INO, KSTAT_SPOOF_DEV, KSTAT_SPOOF_NLINK,
+		KSTAT_SPOOF_SIZE, KSTAT_SPOOF_ATIME_TV_SEC,
+		KSTAT_SPOOF_ATIME_TV_NSEC, KSTAT_SPOOF_MTIME_TV_SEC,
+		KSTAT_SPOOF_MTIME_TV_NSEC, KSTAT_SPOOF_CTIME_TV_SEC,
+		KSTAT_SPOOF_CTIME_TV_NSEC, KSTAT_SPOOF_BLOCKS,
+		KSTAT_SPOOF_BLKSIZE,
+	};
+	const char *path = argv[1];
+
+	/* argv[2 + i] below reaches argv[13], so this needs argv[14]: assert it here rather than only
+	 * at the call site, which checks `argc == 14` against a 16-slot argv - a future caller that
+	 * forgot would read past the array. */
+	if (argc < 2 + (int)ARRAY_SIZE(f_flags))
+		return -EINVAL;
+
+	if (strlen(path) >= KSTAT_PATH_MAX)
+		return -ENAMETOOLONG;
+
+	e = susfs_kstat_find_by_path(path);
+
+	memset(&tmp, 0, sizeof(tmp));
+	/* start from the CURRENT stat; non-default fields override it */
+	err = susfs_kstat_fill_from_path(&tmp, path);
+	if (err)
+		return err;
+	strscpy(tmp.target_pathname, path, KSTAT_PATH_MAX);
+	tmp.flags = 0;
+
+	for (i = 0; i < 12; i++) {
+		err = parse_override(argv[2 + i], &dflt, &val);
+		if (err)
+			return err;
+		if (dflt)
+			continue;
+		tmp.flags |= f_flags[i];
+		switch (i) {
+		case 0: tmp.spoofed_ino = (unsigned long)val; break;
+		case 1: tmp.spoofed_dev = (unsigned long)val; break;
+		case 2: tmp.spoofed_nlink = (unsigned int)val; break;
+		case 3: tmp.spoofed_size = val; break;
+		case 4: tmp.spoofed_atime_tv_sec = (long)val; break;
+		case 5: tmp.spoofed_atime_tv_nsec = (unsigned long)val; break;
+		case 6: tmp.spoofed_mtime_tv_sec = (long)val; break;
+		case 7: tmp.spoofed_mtime_tv_nsec = (unsigned long)val; break;
+		case 8: tmp.spoofed_ctime_tv_sec = (long)val; break;
+		case 9: tmp.spoofed_ctime_tv_nsec = (unsigned long)val; break;
+		case 10: tmp.spoofed_blocks = val; break;
+		case 11: tmp.spoofed_blksize = (long)val; break;
+		}
+	}
+
+	if (e) {
+		kstat_table_put((int)(e - kstat_entries), &tmp);
+		return 0;
+	}
+	idx = kstat_table_append(&tmp);
+	return idx < 0 ? -ENOSPC : 0;
+}
+
+/* statically-add from the supercall ABI struct (is_statically=1): copy the caller's 12 spoofed
+ * fields + flags verbatim; resolve target ino/dev here. */
+static int susfs_kstat_add_statically_abi(struct st_susfs_sus_kstat *info)
+{
+	struct sus_kstat_entry tmp;
+	struct sus_kstat_entry *e;
+	int err, idx;
+
+	e = susfs_kstat_find_by_path(info->target_pathname);
+
+	memset(&tmp, 0, sizeof(tmp));
+	err = susfs_kstat_fill_from_path(&tmp, info->target_pathname);
+	if (err)
+		return err;
+	strscpy(tmp.target_pathname, info->target_pathname, KSTAT_PATH_MAX);
+
+	tmp.spoofed_ino = info->spoofed_ino;
+	tmp.spoofed_dev = info->spoofed_dev;
+	tmp.spoofed_nlink = info->spoofed_nlink;
+	tmp.spoofed_size = info->spoofed_size;
+	tmp.spoofed_atime_tv_sec = info->spoofed_atime_tv_sec;
+	tmp.spoofed_atime_tv_nsec = info->spoofed_atime_tv_nsec;
+	tmp.spoofed_mtime_tv_sec = info->spoofed_mtime_tv_sec;
+	tmp.spoofed_mtime_tv_nsec = info->spoofed_mtime_tv_nsec;
+	tmp.spoofed_ctime_tv_sec = info->spoofed_ctime_tv_sec;
+	tmp.spoofed_ctime_tv_nsec = info->spoofed_ctime_tv_nsec;
+	tmp.spoofed_blocks = info->spoofed_blocks;
+	tmp.spoofed_blksize = info->spoofed_blksize;
+	tmp.flags = info->flags;
+
+	if (e) {
+		kstat_table_put((int)(e - kstat_entries), &tmp);
+		return 0;
+	}
+	idx = kstat_table_append(&tmp);
+	return idx < 0 ? -ENOSPC : 0;
+}
+
+/* supercall: CMD_SUSFS_ADD_SUS_KSTAT / UPDATE / STATICALLY */
+void susfs_kstat_supercall(unsigned int cmd, void __user **arg)
+{
+	struct st_susfs_sus_kstat info = {0};
+	int err = -EINVAL;
+
+	if (copy_from_user(&info, (void __user *)*arg, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out;
+	}
+
+	/* All three commands key on target_pathname, and a caller may fill all 256 bytes of that field -
+	 * reject an unterminated one before any strlen() or kern_path() can walk off our stack copy. */
+	if (!susfs_abi_path_ok(info.target_pathname, sizeof(info.target_pathname))) {
+		info.err = -ENAMETOOLONG;
+		goto out;
+	}
+
+	mutex_lock(&kstat_lock);
+	switch (cmd) {
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+		err = susfs_kstat_add(info.target_pathname);
+		break;
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		err = susfs_kstat_add_statically_abi(&info);
+		break;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		err = susfs_kstat_update(info.target_pathname, false);
+		break;
+	}
+	mutex_unlock(&kstat_lock);
+	info.err = err;
+	/* Armed outside the lock and only after a rule actually landed: a hook that can never fire is worse than no hook. */
+	if (!err)
+		kstat_maps_arm();
+out:
+	/* Upstream (fs/susfs.c susfs_add_sus_kstat) writes back ONLY the err field for this
+	 * input-type command, never the whole struct: copying the full struct back would overrun a
+	 * caller whose own struct is smaller/differently laid out (the prebuilt ksu_susfs tool) and
+	 * corrupt its stack - match upstream exactly. */
+	if (copy_to_user(&((struct st_susfs_sus_kstat __user *)*arg)->err,
+			 &info.err, sizeof(info.err)))
+		pr_warn("kstat supercall copy_to_user failed\n");
+}
+
+/* ---- /proc/susfs_kstat: runtime rule management ---- */
+static int kstat_proc_show(struct seq_file *m, void *v);
+static int kstat_proc_open(struct inode *inode, struct file *file);
+static ssize_t kstat_proc_write(struct file *file, const char __user *buf,
+                                size_t len, loff_t *off);
+
+static const struct proc_ops kstat_proc_ops = {
+	.proc_open = kstat_proc_open,
+	.proc_read = seq_read,
+	.proc_write = kstat_proc_write,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
+static struct proc_dir_entry *kstat_proc_entry;
+
+/* How many of kstat_hooks[] are actually in place: this layer's armed state, and what its log line
+ * reports.  The entry tail that used to be registered here is gone - the entries' comment
+ * above says why and what it cost. */
+static int kstat_hooks_armed;
+
+int susfs_kstat_init(void)
+{
+	int rc;
+	int i;
+
+	/* The entries are armed UNCONDITIONALLY, and that is not cosmetic: the supercall interface
+	 * (CMD_SUSFS_ADD_SUS_KSTAT) can install rules with no /proc node at all, so skipping
+	 * registration when expose_proc=0 silently turned the whole feature into a no-op - rules
+	 * accepted, never applied.  expose_proc decides whether the node exists, nothing else.
+	 *
+	 * One entry at a time, and never fatal for the others - the same shape susfs_opath.c uses: a
+	 * number that cannot be installed leaves that one entry answering the kernel's own way while
+	 * the rest still work, and the log above names it.  Nothing here is a tracepoint any more, so
+	 * the reset rule in kernel/susfs_kprobe.h (about a probe's address field surviving a failed
+	 * registration) has no bearing on it. */
+	for (i = 0; i < (int)ARRAY_SIZE(kstat_hooks); i++) {
+		struct susfs_fp_hook *h = &kstat_hooks[i];
+
+		rc = susfs_fp_install(h);
+		if (rc) {
+			pr_warn("kstat: %s not installed (%d) - that entry answers the kernel's own way\n",
+				h->name, rc);
+			continue;
+		}
+		kstat_hooks_armed++;
+	}
+	if (!kstat_hooks_armed) {
+		pr_warn("kstat: none of the %u entries could be installed - the stat family and the dirent rewrite stay off\n",
+			(unsigned int)ARRAY_SIZE(kstat_hooks));
+		return -ENOENT;
+	}
+	if (kstat_hooks_armed < (int)ARRAY_SIZE(kstat_hooks))
+		pr_warn("kstat: %d of %u entries installed (the log above names the rest)\n",
+			kstat_hooks_armed, (unsigned int)ARRAY_SIZE(kstat_hooks));
+
+	/* 0777 is deliberate, not an oversight.  inode_permission() runs the DAC check BEFORE
+	 * security_inode_permission(), so a node the app cannot open hands it EACCES - "this exists,
+	 * you may not read it" - instead of the ENOENT sus_path is supposed to produce.  0777 lets DAC
+	 * pass and leaves the answer to sus_path's LSM layer, which then becomes the ONLY thing
+	 * between an app and a world-writable control node - so without that layer the node is not
+	 * created at all, see susfs_control_node_allowed(). */
+	if (susfs_control_node_allowed()) {
+		kstat_proc_entry = proc_create("susfs_kstat", 0777, NULL,
+					       &kstat_proc_ops);
+		if (!kstat_proc_entry)
+			pr_warn("proc_create(susfs_kstat) failed\n");
+	} else {
+		SUSFS_LOGI("susfs_kstat: /proc node not created (expose_proc=%d lsm=%d)\n",
+			(int)susfs_expose_proc, (int)sus_path_lsm_active());
+	}
+
+	SUSFS_LOGI("kstat armed: %d rules (%d/%u table entries installed, proc=%d); stat rewrite + sus_path dirent rewrite ride those entries\n",
+		nkstat, kstat_hooks_armed, (unsigned int)ARRAY_SIZE(kstat_hooks),
+		kstat_proc_entry != NULL);
+	return 0;
+}
+
+void susfs_kstat_exit(void)
+{
+	int i;
+
+	kstat_maps_disarm();
+
+	/* Every entry is restored first and the drain runs after all of them: restoring stops new
+	 * callers, and susfs_fp_drain() is what covers a task that already picked one of our wrappers
+	 * out of the table - the same order, and the same reason, as susfs_opath_exit().  Idempotent
+	 * (guarded on `installed` and on the count), because this runs both for the rollback of a
+	 * failed load and for the unload of a loaded module. */
+	for (i = 0; i < (int)ARRAY_SIZE(kstat_hooks); i++) {
+		struct susfs_fp_hook *h = &kstat_hooks[i];
+
+		if (!h->installed)
+			continue;
+		susfs_fp_remove(h);
+	}
+	if (kstat_hooks_armed) {
+		susfs_fp_drain();
+		kstat_hooks_armed = 0;
+	}
+	if (kstat_proc_entry) {
+		proc_remove(kstat_proc_entry);
+		kstat_proc_entry = NULL;
+	}
+	kstat_table_clear();
+}
+
+static int kstat_proc_show(struct seq_file *m, void *v)
+{
+	int i;
+
+	mutex_lock(&kstat_lock);
+	if (nkstat == 0) {
+		seq_puts(m, "(empty)\n");
+	} else {
+		for (i = 0; i < nkstat; i++) {
+			struct sus_kstat_entry *e = &kstat_entries[i];
+
+			seq_printf(m,
+				"%s ino=%lu dev=%lu flags=0x%x"
+				" [ino=%lu dev=%lu nlink=%u size=%lld"
+				" atime=%ld.%lu mtime=%ld.%lu ctime=%ld.%lu"
+				" blocks=%lld blksize=%ld]\n",
+				e->target_pathname, e->target_ino,
+				(unsigned long)e->target_dev, e->flags,
+				e->spoofed_ino, e->spoofed_dev, e->spoofed_nlink,
+				e->spoofed_size,
+				e->spoofed_atime_tv_sec, e->spoofed_atime_tv_nsec,
+				e->spoofed_mtime_tv_sec, e->spoofed_mtime_tv_nsec,
+				e->spoofed_ctime_tv_sec, e->spoofed_ctime_tv_nsec,
+				e->spoofed_blocks, e->spoofed_blksize);
+		}
+	}
+	mutex_unlock(&kstat_lock);
+
+	/* "armed" is not "fired": the maps hook has to be readable the same way the other feature
+	 * hooks are, or a rewrite that never happens looks identical to one that works. */
+	seq_printf(m, "maps: armed=%d hits=%d rewrites=%d\n",
+		   kstat_maps_registered, atomic_read(&n_kstat_map_hits),
+		   atomic_read(&n_kstat_map_rewrites));
+
+	{
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(kstat_nr_table); i++) {
+			struct kstat_call_counters *c = kstat_nr_table[i].cnt;
+
+			seq_printf(m,
+				   "stat nr %-16s (%ld): ok=%d rw=%d | err=%d nobuf=%d empty=%d gate=%d lookup=%d noflag=%d uacc=%d narrow=%d\n",
+				   kstat_nr_table[i].name, kstat_nr_table[i].nr,
+				   atomic_read(&c->calls), atomic_read(&c->rewrite),
+				   atomic_read(&c->ret_err), atomic_read(&c->no_buf),
+				   atomic_read(&c->miss_empty), atomic_read(&c->miss_gate),
+				   atomic_read(&c->miss_lookup), atomic_read(&c->match_noflag),
+				   atomic_read(&c->uaccess), atomic_read(&c->narrow));
+		}
+		seq_printf(m, "stat unlisted-nr hits=%d (stat-range numbers the dispatcher did not know: last %d seen: %ld %ld %ld %ld %ld %ld %ld %ld)\n",
+			   atomic_read(&n_kstat_unlisted), (int)KSTAT_UNLISTED_SEEN,
+			   kstat_unlisted_seen[0], kstat_unlisted_seen[1],
+			   kstat_unlisted_seen[2], kstat_unlisted_seen[3],
+			   kstat_unlisted_seen[4], kstat_unlisted_seen[5],
+			   kstat_unlisted_seen[6], kstat_unlisted_seen[7]);
+	}
+
+	{
+		char line[512];
+		int n = sus_path_dirent_stat_line(line, sizeof(line));
+
+		if (n > 0)
+			seq_write(m, line, min_t(int, n, (int)sizeof(line) - 1));
+	}
+	return 0;
+}
+
+static int kstat_proc_open(struct inode *inode, struct file *file)
+{
+	/* root-only, like kstat_proc_open() above - 0777 is deliberate (see susfs_kstat_init()) */
+	if (!susfs_control_visible())
+		return -ENOENT;
+	return single_open(file, kstat_proc_show, NULL);
+}
+
+static int split_ws(char *buf, char **argv, int max)
+{
+	int argc = 0;
+	char *p = buf;
+
+	while (argc < max) {
+		while (*p == ' ' || *p == '\t' || *p == '\n')
+			p++;
+		if (*p == '\0')
+			break;
+		argv[argc++] = p;
+		while (*p && *p != ' ' && *p != '\t' && *p != '\n')
+			p++;
+		if (*p)
+			*p++ = '\0';
+	}
+	return argc;
+}
+
+static ssize_t kstat_proc_write(struct file *file, const char __user *buf,
+                                size_t len, loff_t *off)
+{
+	char cmd[768];
+	char *argv[16];
+	int argc, err;
+
+	/* Same gate as kstat_proc_open(): open() alone is not enough - an fd opened by root and
+	 * handed on would keep working, which is why the sibling files check both. */
+	if (!susfs_control_visible())
+		return -ENOENT;
+
+	if (len >= sizeof(cmd))
+		len = sizeof(cmd) - 1;
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+	cmd[len] = 0;
+
+	argc = split_ws(cmd, argv, 16);
+	if (argc == 0)
+		return len;
+
+	mutex_lock(&kstat_lock);
+	err = -EINVAL;
+
+	if (!strcmp(argv[0], "add_sus_kstat") && argc == 2)
+		err = susfs_kstat_add(argv[1]);
+	else if (!strcmp(argv[0], "add_sus_kstat_statically") && argc == 14)
+		err = susfs_kstat_add_statically(argv, argc);
+	else if (!strcmp(argv[0], "update_sus_kstat") && argc == 2)
+		err = susfs_kstat_update(argv[1], false);
+	else if (!strcmp(argv[0], "update_sus_kstat_full_clone") && argc == 2)
+		err = susfs_kstat_update(argv[1], true);
+	else if (!strcmp(argv[0], "del") && argc == 2) {
+		susfs_kstat_del(argv[1]);
+		err = 0;
+	} else if (!strcmp(argv[0], "clear")) {
+		kstat_table_clear();
+		err = 0;
+	}
+
+	mutex_unlock(&kstat_lock);
+
+	if (!err)
+		kstat_maps_arm();
+
+	if (err) {
+		pr_warn("kstat proc write '%s' -> err %d\n", argv[0], err);
+		/* Reported to the writer: a command that did not take effect must not look like a
+		 * successful full write.  Success still returns len, so callers that expect a complete
+		 * write keep working. */
+		return err;
+	}
+	return len;
+}
diff --git a/KernelSU/kernel/susfs/susfs_kstat_view.h b/KernelSU/kernel/susfs/susfs_kstat_view.h
new file mode 100644
index 000000000000..134f1b910b84
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_kstat_view.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * susfs_kstat_view.h - value-only view for the kstat read decision
+ *
+ * F/P fill the view; L decides whether the stat read may enter the spoof
+ * table.  P still owns the table and the user-buffer rewrite.
+ */
+
+#ifndef __SUSFS_KSTAT_VIEW_H
+#define __SUSFS_KSTAT_VIEW_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <stdint.h>
+typedef uint32_t u32;
+#endif
+
+enum susfs_kstat_action {
+	SUSFS_KSTAT_SKIP,
+	SUSFS_KSTAT_LOOKUP,
+};
+
+struct susfs_kstat_view {
+	bool table_empty;
+	bool caller_is_umounted_app;
+	bool rule_matched;
+	bool buffer_ok;
+	u32 spoof_flags;
+};
+
+static inline bool
+susfs_kstat_gate_allowed(const struct susfs_kstat_view *v)
+{
+	return v && !v->table_empty && v->caller_is_umounted_app;
+}
+
+static inline enum susfs_kstat_action
+susfs_kstat_decide_core(const struct susfs_kstat_view *v)
+{
+	if (!susfs_kstat_gate_allowed(v))
+		return SUSFS_KSTAT_SKIP;
+	if (!v->rule_matched || !v->spoof_flags)
+		return SUSFS_KSTAT_SKIP;
+	return SUSFS_KSTAT_LOOKUP;
+}
+
+#endif /* __SUSFS_KSTAT_VIEW_H */
diff --git a/KernelSU/kernel/susfs/susfs_log.h b/KernelSU/kernel/susfs/susfs_log.h
new file mode 100644
index 000000000000..e89396246084
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_log.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SUSFS_LOG_H
+#define __SUSFS_LOG_H
+
+#include <linux/types.h>
+#include <linux/printk.h>
+
+#ifdef pr_fmt
+#undef pr_fmt
+#define pr_fmt(fmt) "susfs_guard_lkm: " fmt
+#endif
+
+/* ENABLE_LOG the way upstream has it: SUSFS_LOGI() is the informational channel (rule add/remove,
+ * hook arming, hit paths) behind the switch CMD_SUSFS_ENABLE_LOG / /proc/susfs_enable_log toggles -
+ * default ON, matching upstream's DEFINE_STATIC_KEY_TRUE(susfs_is_log_enabled).  pr_warn/pr_err stay
+ * unconditional: a failure must be visible whether or not logging is on (upstream's SUSFS_LOGE is
+ * unconditional too).  Measured before the fix: the flag had no readers, so `enable_log 0` plus a
+ * rule add still printed "susfs_guard_lkm: sus_path: ..." in dmesg - a root-side fingerprint. */
+bool susfs_log_enabled(void);
+
+#define SUSFS_LOGI(fmt, ...)						\
+	do {								\
+		if (susfs_log_enabled())				\
+			pr_info(fmt, ##__VA_ARGS__);			\
+	} while (0)
+
+#endif
diff --git a/KernelSU/kernel/susfs/susfs_main.c b/KernelSU/kernel/susfs/susfs_main.c
new file mode 100644
index 000000000000..1a54147e7c32
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_main.c
@@ -0,0 +1,541 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_main.c - SUSFS LKM entry point: the layer table plus this module's control nodes.
+ * Loaded via `ksud insmod`, with unexported symbols relocated via kallsyms.
+ */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/version.h>	/* LINUX_VERSION_CODE: the MODULE_IMPORT_NS spelling below */
+#include <linux/fs.h>		/* d_inode() for the control-node labels */
+#include <linux/namei.h>	/* kern_path() */
+#include <linux/path.h>		/* path_put() */
+#include <linux/security.h>	/* security_secctx_to_secid(): the nodes' SELinux label */
+
+#include "symbol_resolver.h"
+#include "ksu_allow_gate.h"	/* susfs_ksu_allow_kind: whether ksu_file applies at all */
+#include "patch_memory.h"	/* ksu_patch_memory_init(): the flush helper's name differs per kernel */
+#include "susfs_log.h"
+#include "ksu_umount_gate.h"
+#include "ksu_allow_gate.h"	/* KernelSU's allow predicate: the control-node gate */
+#include "btf_layout.h"		/* the SELinux inode_security_struct.sid offset, by BTF */
+#include "lsm_hook.h"
+#include "susfs.h"
+#include "susfs_opath.h"	/* SUSFS_OPATH_NODE + the layer's init/exit */
+#include "susfs_fp_hook.h"	/* susfs_fp_init: the sys_call_table cache every fp layer installs through */
+
+/* The module's own name lives in susfs.h (SUSFS_LKM_MODULE_NAME / SUSFS_LKM_SYSFS_DIR):
+ * /sys/module's directory and the rules that hide it (susfs_hide_syms.c) must agree, and the
+ * version lives there as well (SUSFS_LKM_VERSION) because the load-time guard can refuse the
+ * module before this file's banner runs. */
+
+/* The /proc/susfs_* control nodes are created by default and are 0777 on purpose.
+ * Measured on device, 0600 plus sus_path hiding does not work: `ls -l /proc/susfs_kstat`
+ * -> ENOENT (the inode_getattr hook fired) but `cat` -> Permission denied (it did not), with
+ * sus_path's perm counter stuck at 0 - inode_permission() runs the DAC check BEFORE
+ * security_inode_permission(), so a 0600 root-owned node fails DAC first, the LSM hook is
+ * never reached, and EACCES advertises that the node exists.  General to sus_path's path
+ * layer: it can only turn an ENOENT-shaped answer out of files DAC would have ALLOWED.
+ * Hence 0777: DAC passes, the LSM layer is the only thing that answers (ENOENT for every
+ * non-root caller).
+ * The nodes exist only when the layer that hides them is installed
+ * (susfs_control_node_allowed()), so an unprotected world-writable node cannot happen, and
+ * root-only access is enforced by the handlers' uid checks, not by the mode.  expose_proc=0
+ * removes the nodes entirely. */
+bool susfs_expose_proc = true;
+module_param_named(expose_proc, susfs_expose_proc, bool, 0600);
+
+static const char *const susfs_self_hide_paths[] = {
+    "/proc/susfs_kstat",
+    "/proc/susfs_open_redirect",
+    "/proc/susfs_enable_log",
+    "/proc/susfs_avc_spoof",
+    SUSFS_HIDE_MODULES_NODE,
+    SUSFS_HIDE_MOUNTS_NODE,
+    /* sus_path's own interface (the rule listing): it goes through the same table it
+     * prints, so a broken rule table is visible in the very view that reports it. */
+    SUSFS_PATH_NODE,
+    /* The O_PATH layer's node: it reports the four sys_call_table/compat_sys_call_table
+     * entries and the counters that say whether a wrapper ever ran. */
+    SUSFS_OPATH_NODE,
+    SUSFS_MAP_NODE,
+    /* The module's own sysfs directory is NOT here: it belongs to hide_module
+     * (susfs_hide_syms.c), which adds and drops that rule at runtime. */
+};
+
+/* Register our control nodes in sus_path's hidden set: probing them must answer ENOENT,
+ * not EACCES.  Runs after every feature init (the nodes must exist for kern_path() to
+ * resolve them) and after sus_path_init(), so the hooks are already patched. */
+void susfs_self_hide_nodes(void)
+{
+    int i;
+
+    if (!susfs_expose_proc)
+        return;
+
+    for (i = 0; i < ARRAY_SIZE(susfs_self_hide_paths); i++) {
+        int rc = sus_path_add_self_hidden(susfs_self_hide_paths[i]);
+
+        if (rc)
+            pr_warn("susfs_guard_lkm: self-hide %s failed %d\n",
+                    susfs_self_hide_paths[i], rc);
+    }
+}
+
+/* The control nodes are born with procfs's default label, u:object_r:proc:s0, whose policy refuses
+ * even an adb shell that this module's gate accepted (measured: `cat /proc/susfs_open_redirect`
+ * from u:r:shell:s0 is EACCES, while the same read from u:r:ksu:s0 works).  ksu_file is the type
+ * the KernelSU policy already grants to the processes that may use su - exactly the set these
+ * nodes exist for - so they are moved under it.
+ *
+ * There is no LSM interface for this: security_inode_setsecurity() has no inode_setsecurity hook
+ * registered on this kernel (it answers the framework default, -EOPNOTSUPP, for either spelling of
+ * the attribute name), and procfs has no xattr handler to go through the VFS.  What is left is the
+ * field SELinux itself reads: inode->i_security points at its private inode_security_struct (until
+ * the per-LSM blob split in 6.4), and the `sid` member is what every check uses.  The offset comes
+ * from BTF and the member's type is verified, so a kernel whose layout moved it is refused instead
+ * of being written at a guess.
+ *
+ * This runs once at load, on inodes nobody has opened yet; a plain 32-bit store needs no lock. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 4, 0)
+static const char susfs_control_selinux_ctx[] = "u:object_r:ksu_file:s0";
+static const char susfs_proc_selinux_ctx[] = "u:object_r:proc:s0";
+static size_t susfs_isec_base_offset;	/* SELinux's slot inside inode->i_security */
+static size_t susfs_isec_sid_offset;
+static u32 susfs_control_sid;
+static u32 susfs_proc_sid;
+
+static bool susfs_prepare_control_sid(void)
+{
+    unsigned long blob_sizes;
+    size_t lbs_inode_off;
+    int sel_off;
+    int rc;
+
+    if (security_secctx_to_secid(susfs_control_selinux_ctx,
+                                 strlen(susfs_control_selinux_ctx),
+                                 &susfs_control_sid) ||
+        !susfs_control_sid)
+        return false;
+    if (security_secctx_to_secid(susfs_proc_selinux_ctx,
+                                 strlen(susfs_proc_selinux_ctx),
+                                 &susfs_proc_sid) ||
+        !susfs_proc_sid)
+        return false;
+    /* Idempotent: the fsnotify layer has usually called this already. */
+    if (susfs_btf_layout_init())
+        return false;
+    /* Every Android 5.15 here carries the per-LSM blob allocation even though the split landed
+     * upstream later: inode->i_security is then a blob whose SELinux slot starts at
+     * selinux_blob_sizes.lbs_inode.  A kernel without that symbol is the older shape, where
+     * inode->i_security IS the struct and the base stays 0. */
+    blob_sizes = find_kernel_symbol_exact("selinux_blob_sizes");
+    if (blob_sizes) {
+        if (susfs_btf_member_offset("lsm_blob_sizes", "lbs_inode", "int",
+                                    &lbs_inode_off))
+            return false;
+        sel_off = READ_ONCE(*(int *)((char *)blob_sizes + lbs_inode_off));
+        if (sel_off < 0 || sel_off > 4096)
+            return false;
+        susfs_isec_base_offset = (size_t)sel_off;
+    }
+    rc = susfs_btf_member_offset("inode_security_struct", "sid", "uint",
+                                 &susfs_isec_sid_offset);
+    return !rc;
+}
+
+/* The write is only made where the field already holds the proc label: that is what proves the
+ * base, the offset and the blob ownership are all right on the kernel actually running.  Anything
+ * else is left alone - a wrong guess here would corrupt a live struct. */
+static void susfs_set_inode_sid(struct inode *inode, u32 sid)
+{
+    u32 *field;
+
+    if (!inode->i_security)
+        return;
+    field = (u32 *)((char *)inode->i_security + susfs_isec_base_offset +
+                    susfs_isec_sid_offset);
+    if (READ_ONCE(*field) != susfs_proc_sid)
+        return;
+    WRITE_ONCE(*field, sid);
+}
+#endif
+
+static void susfs_relabel_control_nodes(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+    /* The split is upstream here and the blob walk above is untested there, so the nodes keep their
+     * default (proc) label.  That is exactly why the gate must NOT widen here: susfs_control_visible()
+     * stays root-only until susfs_control_relabelled is set, because proc's policy answers EACCES to
+     * the shell and to su-granted apps - the gate letting them in would turn the nodes' ENOENT into
+     * an EACCES that proves they exist (susfs4ksu-lkm#108). */
+    return;
+#else
+    int i, found = 0, changed = 0;
+
+    if (!susfs_expose_proc)
+        return;
+    /* No KernelSU, no ksu_file label.  That label exists so the KernelSU predicate's set
+     * (shell, the manager, su-granted apps) may read the nodes; without the predicate there is
+     * nobody to widen to, so the nodes keep proc's own label and the gate stays the original
+     * root-only one.  susfs_prepare_control_sid() would otherwise succeed here on BTF alone -
+     * a Magisk device has no KernelSU predicate but does have SELinux - and stamp a label this
+     * build has no use for. */
+    if (READ_ONCE(susfs_ksu_allow_kind) != 1) {
+        SUSFS_LOGI("susfs: no KernelSU predicate - control nodes keep proc's label, gate stays root-only\n");
+        return;
+    }
+    if (!susfs_prepare_control_sid()) {
+        SUSFS_LOGI("susfs: no ksu_file label applied (context or BTF layout unavailable)\n");
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(susfs_self_hide_paths); i++) {
+        struct path p;
+        struct inode *inode;
+
+        if (kern_path(susfs_self_hide_paths[i], 0, &p))
+            continue;
+        found++;
+        inode = d_inode(p.dentry);
+        if (inode && inode->i_security) {
+            u32 *field = (u32 *)((char *)inode->i_security +
+                                 susfs_isec_base_offset +
+                                 susfs_isec_sid_offset);
+
+            if (READ_ONCE(*field) == susfs_proc_sid) {
+                susfs_set_inode_sid(inode, susfs_control_sid);
+                changed++;
+            }
+        }
+        path_put(&p);
+    }
+    SUSFS_LOGI("susfs: %d of %d control node(s) relabelled to %s\n",
+               changed, found, susfs_control_selinux_ctx);
+    /* Only a node that is actually relabelled may be widened to the KernelSU set: a node left under
+     * proc's label answers EACCES to exactly the callers the wider gate just admitted, and EACCES
+     * says "it is here" where ENOENT says "nothing here".  All-or-nothing on purpose - a partial
+     * relabel means the set is not usable, and root-only is what those labels say anyway. */
+    WRITE_ONCE(susfs_control_relabelled, found > 0 && changed == found);
+#endif
+}
+
+/* ---- layer table: arming order IS the teardown order, reversed --------------
+ * A failed load must leave NOTHING armed: when module_init() returns an error the kernel
+ * frees this module's memory, so anything still installed - a patched security_hook_heads
+ * slot above all - becomes a function pointer into freed memory that the next syscall goes
+ * through.  Hence the exits of the already-armed layers run before failing.
+ * Teardown runs in the exact reverse of arming, in one place, and the order matters:
+ * sus_path's LSM layer is what answers ENOENT for this module's own 0777 control nodes (see
+ * the expose_proc note), so unhooking it before the nodes are removed would expose them to
+ * every process during the unload - here the nodes go first and the LSM layer last.
+ * The load plan marks four layers as fatal: fp_hook, lsm_hook, sus_path and supercall; the
+ * rest log their own failure and degrade to "off".  The exits are idempotent, which lets one
+ * path serve rollback and unload alike. */
+static int layer_lsm_hook_init(void)
+{
+    ksu_lsm_hook_init();
+    if (!ksu_lsm_hook_ready()) {
+        pr_err("lsm_hook: the table hook insertion walks is not resolvable on this kernel - refusing to load\n");
+        return -ENOENT;
+    }
+    return 0;
+}
+
+/* Layer ids: the load order indexes susfs_layers[] through these, and susfs_load_plan[] below
+ * carries the per-layer FATAL bool passed to susfs_load_layer().  Keep the enum and the table in
+ * the same order. */
+enum susfs_layer_id {
+    SUSFS_L_FP_HOOK = 0,
+    SUSFS_L_KSU_UMOUNT_GATE,
+    SUSFS_L_KSU_ALLOW_GATE,
+    SUSFS_L_LSM_HOOK,
+    SUSFS_L_SUS_PATH,
+    SUSFS_L_CREATE_GATE,
+    SUSFS_L_OPATH,
+    SUSFS_L_DIRENT,
+    SUSFS_L_UNAME,
+    SUSFS_L_KSTAT,
+    SUSFS_L_SUS_MAP,
+    SUSFS_L_SUS_MOUNT,
+    SUSFS_L_CMDLINE,
+    SUSFS_L_OPEN_REDIRECT,
+    SUSFS_L_ENABLE_LOG,
+    SUSFS_L_AVC_SPOOF,
+    SUSFS_L_SUPERCALL,
+    SUSFS_L_HIDE_SYMS,
+    SUSFS_L_COUNT,
+};
+
+/* Not const: the `armed` flags live here (the pointers must outlive __init too). */
+static struct susfs_layer {
+    const char *name;
+    int (*init)(void);
+    void (*exit)(void);
+    bool armed;			/* exit is run for every layer that was attempted */
+    int feature;			/* enum susfs_feature armed on a successful init, or -1 */
+} susfs_layers[] = {
+    /* First, and FATAL: every fp-hook layer below (create_gate, opath, dirent, kstat, ...)
+     * installs its entries through this cache.  A module that loaded without it would accept
+     * rules that no fp-hook layer can ever apply - the "loaded but inert" shape this table
+     * exists to avoid - so a missing sys_call_table refuses the load.  The init is idempotent
+     * (the later layers' own susfs_fp_init() calls are no-ops once the cache is set), and
+     * there is no exit: only the pointer is cached, the entries are restored by their owner. */
+    { "fp_hook",	susfs_fp_init,			NULL,			false, -1 },
+    /* NOT fatal: this layer only decides whether KernelSU's predicate was found at load.
+     * When it was not, the gates answer the pre-#34 way and every other layer still works - so a
+     * failure here is a degradation, not a reason to refuse the module.  Skipping this init entirely
+     * (fail_layer=2) is safe for the same reason: the flag it sets defaults to the pre-#34 answer. */
+    { "ksu_umount_gate", susfs_ksu_umount_gate_init,	NULL,			false, -1 },
+    { "ksu_allow_gate",	susfs_ksu_allow_gate_init,	NULL,			false, -1 },
+    /* FATAL: every LSM layer below (sus_path first) inserts through this file's table hooks.
+     * A module that loads without it would accept rules no LSM layer can apply - the same
+     * "loaded but inert" shape fp_hook is fatal for.  ksu_lsm_hook_init() itself only
+     * reports; the refusal lives here, where a failure can fail the load. */
+    { "lsm_hook",	layer_lsm_hook_init,		ksu_lsm_hook_exit,	false, -1 },
+    { "sus_path",	sus_path_init,			sus_path_exit,		false, SUSFS_FEAT_SUS_PATH },
+    /* After sus_path, whose rule table and per-caller gate it asks.  NOT fatal: when it
+     * cannot arm, the create family keeps answering the kernel's own way (EEXIST for a
+     * hidden name) - the read paths are unaffected. */
+    { "create_gate",	susfs_create_gate_init,		susfs_create_gate_exit,	false, SUSFS_FEAT_SUS_PATH },
+    /* After sus_path, because this layer asks sus_path's rule table for every open it
+     * post-checks - arming it first would install table entries that answer from a table
+     * nobody has filled in yet.  NOT fatal: a failure here only means open(..., O_PATH) keeps
+     * answering the pre-layer way (which is what the layer exists to fix, not what makes the
+     * module useful), and every entry carries its own reason in the log. */
+    { "opath",		susfs_opath_init,		susfs_opath_exit,	false, SUSFS_FEAT_SUS_PATH },
+    /* After sus_path, whose rule table it asks.  NOT fatal: when it does not arm the
+     * post-hoc filter still hides, it is only detectable while doing so. */
+    { "dirent",		susfs_sus_dirent_init,		susfs_sus_dirent_exit,	false, SUSFS_FEAT_SUS_PATH },
+    { "uname",		susfs_uname_init,		susfs_uname_exit,	false, SUSFS_FEAT_SPOOF_UNAME },
+    { "kstat",		susfs_kstat_init,		susfs_kstat_exit,	false, SUSFS_FEAT_SUS_KSTAT },
+    { "sus_map",	susfs_sus_map_init,		susfs_sus_map_exit,	false, SUSFS_FEAT_SUS_MAP },
+    { "sus_mount",	susfs_sus_mount_init,		susfs_sus_mount_exit,	false, SUSFS_FEAT_SUS_MOUNT },
+    { "cmdline",	susfs_spoof_cmdline_init,	susfs_spoof_cmdline_exit, false, SUSFS_FEAT_SPOOF_CMDLINE },
+    { "open_redirect",	susfs_open_redirect_init,	susfs_open_redirect_exit, false, SUSFS_FEAT_OPEN_REDIRECT },
+    { "enable_log",	susfs_enable_log_init,		susfs_enable_log_exit,	false, SUSFS_FEAT_ENABLE_LOG },
+    { "avc_spoof",	susfs_avc_spoof_init,		susfs_avc_spoof_exit,	false, SUSFS_FEAT_AVC_SPOOF },
+    { "supercall",	susfs_supercall_init,		susfs_supercall_exit,	false, -1 },
+    { "hide_syms",	susfs_hide_syms_init,		susfs_hide_syms_exit,	false, SUSFS_FEAT_HIDE_SYMS },
+};
+
+/* Diagnostic: make one layer's init fail, by 1-based index, to exercise the rollback path
+ * on the device - a `fatal` layer failing must leave the load with nothing armed.
+ * `fail_layer=2` skips the ksu_umount_gate init WITHOUT failing the load (that layer is not fatal),
+ * which is safe only because its flag defaults to the pre-#34 answer - see ksu_umount_gate.c.
+ *
+ * Index map (keep this list and the fail_layer= references in tools/verify-gki.sh and the layer
+ * comments in sync whenever a layer is inserted):
+ *   1 fp_hook   2 ksu_umount_gate  3 ksu_allow_gate  4 lsm_hook   5 sus_path
+ *   6 create_gate  7 opath  8 dirent  9 uname  10 kstat  11 sus_map  12 sus_mount
+ *   13 cmdline  14 open_redirect  15 enable_log  16 avc_spoof  17 supercall  18 hide_syms
+ */
+static int fail_layer;
+module_param_named(fail_layer, fail_layer, int, 0644);
+
+/* Not __init/__exit: it is called from both, and an __exit callee in __init code is a
+ * modpost section mismatch. */
+/* noinline: its indirect calls through susfs_layers[] belong to this allow-listed function;
+ * inlined into module_exit they would land in cleanup_module, which the CFI gate does not allow. */
+static noinline void susfs_layers_down(int upto)
+{
+    int i;
+
+    for (i = upto; i >= 0; i--) {
+        if (!susfs_layers[i].armed)
+            continue;
+        susfs_layers[i].armed = false;
+        if (susfs_layers[i].exit)
+            susfs_layers[i].exit();
+    }
+}
+
+/* The load order and the fatal decision live here, not in the table: susfs_load_layer()
+ * receives the bool and owns the rollback-or-warn policy. */
+static const struct {
+    int id;
+    bool fatal;
+} susfs_load_plan[] = {
+    { SUSFS_L_FP_HOOK, true },
+    { SUSFS_L_KSU_UMOUNT_GATE, false },
+    { SUSFS_L_KSU_ALLOW_GATE, false },
+    { SUSFS_L_LSM_HOOK, true },
+    { SUSFS_L_SUS_PATH, true },
+    { SUSFS_L_CREATE_GATE, false },
+    { SUSFS_L_OPATH, false },
+    { SUSFS_L_DIRENT, false },
+    { SUSFS_L_UNAME, false },
+    { SUSFS_L_KSTAT, false },
+    { SUSFS_L_SUS_MAP, false },
+    { SUSFS_L_SUS_MOUNT, false },
+    { SUSFS_L_CMDLINE, false },
+    { SUSFS_L_OPEN_REDIRECT, false },
+    { SUSFS_L_ENABLE_LOG, false },
+    { SUSFS_L_AVC_SPOOF, false },
+    { SUSFS_L_SUPERCALL, true },
+    { SUSFS_L_HIDE_SYMS, false },
+};
+
+static int susfs_load_layer(int id, bool fatal)
+{
+    struct susfs_layer *l;
+    int ret;
+
+    if (id < 0 || id >= SUSFS_L_COUNT) {
+        susfs_layers_down(SUSFS_L_COUNT - 1);
+        return -EINVAL;
+    }
+    l = &susfs_layers[id];
+
+    /* Marked before the call: a layer that half-ran still has to be taken down. */
+    l->armed = true;
+    if (fail_layer == id + 1) {
+        pr_warn("susfs_guard_lkm: fail_layer=%d - forcing %s's init to fail (diagnostic)\n",
+                fail_layer, l->name);
+        ret = -EIO;
+    } else {
+        ret = l->init ? l->init() : 0;
+    }
+    if (!ret) {
+        if (l->feature >= 0)
+            susfs_supercall_arm_feature(l->feature);
+        return 0;
+    }
+    if (fatal) {
+        pr_err("susfs_guard_lkm: %s init failed %d, refusing to load\n", l->name, ret);
+        /* The kernel is about to free this module; a hook left behind points into it. */
+        susfs_layers_down(SUSFS_L_COUNT - 1);
+        return ret;
+    }
+    pr_warn("susfs_guard_lkm: %s init failed %d - that feature stays off\n", l->name, ret);
+    return 0;
+}
+
+static int __init susfs_init(void)
+{
+    int i;
+
+    /* First, before any layer runs and while nothing is armed: an import that was not filled in
+     * is an address this module would jump to on its first call through it.  See
+     * imports_guard.c - a loader that continues after an unresolved name leaves it zero, which
+     * the kernel accepts without a word. */
+    if (susfs_imports_guard())
+        return -EINVAL;
+
+    SUSFS_LOGI("init v%s\n", SUSFS_LKM_VERSION);
+
+    if (ksu_init_symbol_resolver())
+        return -ENODATA;
+
+    /* Dead man's switch: refuse loading if in-built SuSFS is present */
+    if (find_kernel_symbol_exact("susfs_is_inode_sus_path") ||
+        find_kernel_symbol_exact("susfs_sus_kstat_spoof_generic_fillattr")) {
+        pr_err("susfs_guard_lkm: in-built SuSFS is already active in kernel; refusing to load\n");
+        return -EEXIST;
+    }
+
+    /* Now that kallsyms lookups work, check the addresses themselves: see imports_guard.c. */
+    if (susfs_imports_crosscheck())
+        return -EINVAL;
+
+    /* Text/data patching needs a cache-flush helper whose name differs between kernels; resolve it
+     * here, before any layer can patch.  Not fatal by itself, but below 6.12 sus_path is a fatal
+     * layer and it installs its hooks by patching text, so a kernel carrying neither spelling ends
+     * up refusing to load the module - with the reason in the log right here.  On 6.12+ that path
+     * goes through static calls and this only costs the layers that do patch. */
+    if (ksu_patch_memory_init())
+        pr_warn("susfs_guard_lkm: patching unavailable on this kernel (see patch_memory.c)\n");
+
+    BUILD_BUG_ON(ARRAY_SIZE(susfs_layers) != SUSFS_L_COUNT);
+    BUILD_BUG_ON(ARRAY_SIZE(susfs_load_plan) != SUSFS_L_COUNT);
+    for (i = 0; i < (int)ARRAY_SIZE(susfs_load_plan); i++) {
+        if (susfs_load_plan[i].id != i) {
+            pr_err("susfs_guard_lkm: load plan entry %d names layer %d - refusing to load\n",
+                   i, susfs_load_plan[i].id);
+            return -EINVAL;
+        }
+    }
+
+    for (i = 0; i < (int)ARRAY_SIZE(susfs_load_plan); i++) {
+        int ret;
+
+        ret = susfs_load_layer(susfs_load_plan[i].id, susfs_load_plan[i].fatal);
+        if (ret) {
+            susfs_layers_down(SUSFS_L_COUNT - 1);
+            return ret;
+        }
+    }
+
+    /* Registered last and undone implicitly: these are entries in sus_path's table, which
+     * sus_path_exit() empties while its LSM layer still answers ENOENT for the nodes. */
+    susfs_self_hide_nodes();
+    susfs_relabel_control_nodes();
+
+    /* Operator note.  The module hides its own traces from EVERY caller, root included (a
+     * built-in SUSFS has no module entry, so hiding it only from non-root would leave a
+     * trace upstream does not have): `lsmod | grep susfs` stays empty and a second `insmod`
+     * fails with -EEXIST, which reads like a broken module.
+     * THE ONE LINE THAT IGNORES THE LOG SWITCH: everything else follows enable_log
+     * (susfs_log.h), but this is the only evidence the module came up and the one thing an
+     * operator greps for, so it stays unconditional even for a silent load - otherwise
+     * "loaded but logging off" is indistinguishable from "not loaded".  The prefix comes
+     * from pr_fmt (susfs_log.h), so the message must not repeat it. */
+    pr_info("loaded. This module is filtered out of /proc/modules for every caller including root, so `lsmod | grep susfs` stays empty - check /sys/module/%s instead (a second insmod fails with -EEXIST while it is loaded).\n",
+            SUSFS_LKM_MODULE_NAME);
+
+    /* A fallback kprobe on __arm64_sys_reboot is a visible breakpoint, not just an
+     * implementation detail.  Emit this after every layer has armed and only when the
+     * module is actually loaded; keep it unconditional (pr_warn, not SUSFS_LOGI) so it
+     * survives enable_log=0, like the loaded line above. */
+    if (susfs_supercall_kprobe_active())
+        pr_warn("supercall delivery fell back to the kprobe path: it leaves a breakpoint on __arm64_sys_reboot, visible through /sys/kernel/debug/kprobes/list and text/instruction inspection - treat this as a side channel.\n");
+
+    return 0;
+}
+
+static void __exit susfs_exit(void)
+{
+    susfs_layers_down((int)ARRAY_SIZE(susfs_layers) - 1);
+    SUSFS_LOGI("susfs_guard_lkm: exit\n");
+}
+
+module_init(susfs_init);
+module_exit(susfs_exit);
+MODULE_LICENSE("GPL");
+
+/* The VFS symbol namespace of this kernel's GKI builds.
+ *
+ * Four symbols this module imports - kern_path and ihold (fs/), override_creds and
+ * revert_creds (kernel/cred.c) - are exported as
+ * EXPORT_SYMBOL_NS(sym, ANDROID_GKI_VFS_EXPORT_ONLY), and the Android build maps that
+ * name to the long string below with a per-directory ccflag before the compiler
+ * stringifies it (fs/Makefile: subdir-ccflags-y += -DANDROID_GKI_VFS_EXPORT_ONLY=...,
+ * plus kernel/Makefile for cred.o on some releases).  A module that does not import the
+ * RESULTING string is refused by the kernel's module loader with
+ *   "module uses symbol (kern_path) from namespace VFS_internal_... but does not import
+ *    it"  ->  "Unknown symbol kern_path (err -22)"
+ * which is why plain insmod failed on the phone before this line existed.
+ *
+ * The long form must be written out literally: MODULE_IMPORT_NS(ns) stringifies its
+ * argument, so passing the macro name ANDROID_GKI_VFS_EXPORT_ONLY would import a
+ * namespace that no kernel ever creates.  (Measured on the built .ko: .modinfo carried
+ * no import_ns entry at all.)
+ *
+ * v6.13 turned that upside down: "module: Convert symbol namespace to string literal"
+ * (upstream cdd30ebb1b9f, also in the Android common trees) made the macro's argument a
+ * STRING LITERAL, so the old token form now stringifies into "\"VFS_...\"" and the import
+ * is refused.  Both spellings are kept below and chosen by version, so the same source
+ * builds from 5.10 through 6.18.
+ *
+ * Note this is necessary but NOT sufficient for plain insmod: further symbols we
+ * reference are not in the kernel's export table in any of the six supported GKI
+ * variants (kallsyms_lookup_name and friends, saved_boot_config, task_work_add, init_mm,
+ * __set_fixmap, copy_to_kernel_nofault), so loading without a
+ * helper still needs those to be resolved at runtime.  The userspace loader
+ * (tools/susfs_insmod.c) sidesteps the whole question by rewriting undefined symbols to
+ * absolute addresses, exactly as KernelSU's ksud does - see README. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 13, 0)
+MODULE_IMPORT_NS("VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver");
+#else
+MODULE_IMPORT_NS(VFS_internal_I_am_really_a_filesystem_and_am_NOT_a_driver);
+#endif
+MODULE_DESCRIPTION("SUSFS guard LKM (susfs_guard_lkm) v2.3.0-gki");
diff --git a/KernelSU/kernel/susfs/susfs_opath.c b/KernelSU/kernel/susfs/susfs_opath.c
new file mode 100644
index 000000000000..d9005579af06
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_opath.c
@@ -0,0 +1,774 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_opath.c - hide sus_path's files from open(..., O_PATH).
+ *
+ * Why the LSM layer cannot see an O_PATH open
+ * -------------------------------------------
+ * do_dentry_open() answers O_PATH before anything that could refuse: it sets
+ * f_mode = FMODE_PATH | FMODE_OPENED and f_op = &empty_fops and returns, and that return is
+ * BEFORE security_file_open() (fs/open.c:801-805 against :832 in the 5.15 tree this was
+ * written against).  Neither that early return nor the final-component walk of an O_PATH
+ * lookup makes a permission or LSM call, so a path sus_path answers ENOENT for still yields a
+ * usable descriptor: the fd cannot be read, but it proves the file exists
+ * (fstatat(AT_EMPTY_PATH), /proc/self/fd/N, an O_PATH fd as an *at() dirfd, ...), and that is
+ * all a detector needs.
+ *
+ * The only place left to answer is AFTER the kernel has made its own decision, so this layer
+ * post-checks: the open runs exactly as the kernel chose to run it, and if the file it
+ * produced is one of sus_path's, the descriptor is taken away again and the syscall is
+ * answered -ENOENT.  That is why the sys_call_table entries are the mechanism here (see
+ * susfs_fp_hook.c for why the table and not an inline hook, and for the ordering rules).
+ *
+ * Why f_mode and not the flags
+ * ----------------------------
+ * O_PATH is decided from the file the kernel produced, not from what the caller asked for:
+ * do_dentry_open() sets FMODE_PATH for an O_PATH open and for nothing else, so the bit IS the
+ * kernel's conclusion.  Reading the flags instead would mean reading user memory - openat2
+ * passes a struct open_how, so the flags, the mode and the resolve field all have to be
+ * copied in and validated first, and a caller can change them between the copy and the open -
+ * and it would have to be done twice, once per ABI (the 32-bit layouts differ).  None of that
+ * is needed: by the time this code runs, the question has already been answered.
+ *
+ * Why the inode and not a path
+ * ----------------------------
+ * The dentry/inode pair in f_path is what the kernel resolved, under the caller's own root,
+ * cwd and mount namespace.  Re-resolving a path string here would be a second lookup that a
+ * rename/rmdir/mount in between can point somewhere else - the TOCTOU this whole layer exists
+ * to avoid - and the path string is not even available: it would have to be read out of the
+ * caller's registers.  sus_path decides by identity, so the inode is the whole input.
+ *
+ * What this file must NOT do: no path resolution, no user memory access, no namespace work,
+ * and no instruction rewriting anywhere (only the data of the table entries - a rewritten
+ * .cfi_jt stub was measured as an unrecoverable "Oops - FPAC", see susfs_fp_hook.c).
+ */
+
+#include <linux/kernel.h>
+#include <linux/version.h>	/* LINUX_VERSION_CODE: close_fd_get_file() changed prototype in 6.1 */
+#include <linux/module.h>
+#include <linux/errno.h>
+#include <linux/fs.h>		/* struct file, FMODE_PATH */
+#include <linux/file.h>		/* fput() */
+#include <linux/fdtable.h>	/* files_struct/fdtable for atomic fd rollback */
+#include <linux/dcache.h>	/* d_inode() */
+#include <linux/atomic.h>
+#include <linux/cred.h>		/* current_uid(), for the control node */
+#include <linux/moduleparam.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/fcntl.h>	/* O_PATH, for the wrapper's flags fast path */
+#include <asm/unistd.h>		/* __NR_openat, __NR_openat2, __NR_syscalls */
+#include <asm/ptrace.h>		/* struct pt_regs: the wrappers read the caller's argument
+				 * registers.  Written out because nothing else here reaches it -
+				 * susfs_fp_hook.h only forward-declares the struct, and none of
+				 * <linux/fs.h>/<linux/cred.h>/<linux/mm.h> pulls asm/ptrace.h in
+				 * (the kprobe layers get it through <linux/kprobes.h>, sus_path.c
+				 * through <asm/syscall.h>). */
+
+#include "symbol_resolver.h"
+#include "susfs_log.h"
+#include "susfs.h"		/* susfs_control_node_allowed(), sus_path_inode_hidden_public() */
+#include "susfs_opath.h"
+#include "susfs_fp_hook.h"
+#include "susfs_or_entry.h"	/* open_redirect's name layer shares exactly these five entries */
+#include "ksu_allow_gate.h"	/* the control-node gate is su's own */
+
+/* The AArch32 numbers.  No arm64 header defines them as __NR_*: they are what
+ * arch/arm64/include/asm/unistd32.h is generated from, i.e.
+ * arch/arm/tools/syscall.tbl:19 (`5  common  open  sys_open`) and :339
+ * (`322  common  openat  sys_openat`).  The native numbers come from
+ * include/uapi/asm-generic/unistd.h:183 (openat 56) and :854 (openat2 437). */
+#define SUSFS_COMPAT_NR_OPEN		5
+#define SUSFS_COMPAT_NR_OPENAT		322
+/* The AArch32 openat2 slot carries the same number as the native one but is a DIFFERENT array
+ * element: arch/arm64/include/asm/unistd32.h:884-885 registers it as
+ * `__SYSCALL(__NR_openat2, sys_openat2)` - the NATIVE implementation, not a compat wrapper - and
+ * arch/arm64/kernel/sys32.c:130 turns that into
+ * `compat_sys_call_table[437] = __arm64_sys_openat2`.  Patching sys_call_table[437] therefore
+ * does not patch this element, and a 32-bit task calling openat2(..., O_PATH) would walk past
+ * the layer entirely.  It needs its own entry, its own wrapper and its own original slot even
+ * though both slots hold the same function. */
+#define SUSFS_COMPAT_NR_OPENAT2		437
+
+/* The BTI landing pad an indirect call into this module has to land on.  fp_has_landing_pad()
+ * in susfs_fp_hook.c is static and is what susfs_fp_install() refuses a wrapper with; the same
+ * test is written out here so opath_dump can report it on the device for a wrapper that is not
+ * installed at all - a dump whose answer only exists when the hook is already live would be
+ * useless for the step it is meant for. */
+#define SUSFS_ARM64_BTI_C	0xd503245fu
+
+static inline bool opath_has_landing_pad(const void *fn)
+{
+	return fn && READ_ONCE(*(const u32 *)fn) == SUSFS_ARM64_BTI_C;
+}
+
+/* Resolved by name at init and cached, exactly like sus_open_redirect.c does it.  fget_raw() is
+ * exported, but GKI's module symbol list is not a promise; the close-fd helpers are global
+ * symbols whose names are found by the module's resolver.  Their signatures differ by kernel
+ * generation, so each is called through its matching pointer and every caller carries __nocfi.
+ * susfs_opath_init() installs no table entry while either required capability is unresolved: a
+ * wrapper that cannot finish its post-check would deny nothing and only add a fault path. */
+static struct file *(*opath_fget_raw)(unsigned int fd);
+/* THREE shapes, not one function under three names - and the first two share a NAME, which is
+ * exactly what a by-name resolver cannot see:
+ *
+ *   5.10..5.15  int close_fd_get_file(unsigned int fd, struct file **res)
+ *               takes the fd out of the table and then get_file()s the file, so the caller owns
+ *               TWO references and the kernel-doc there asks for filp_close() and then an fput();
+ *   6.1..6.6    struct file *close_fd_get_file(unsigned int fd)
+ *               same name, different prototype, NO reference of its own.  Called through the
+ *               older prototype above the returned pointer was read as an int status -
+ *               non-zero, therefore "failed" - while the fd was already out of the caller's
+ *               table: the deny path then handed the caller its own dead descriptor number back
+ *               (open appears to succeed, the next fstat is EBADF) and never released the file
+ *               it had just been handed;
+ *   6.12..      struct file *file_close_fd(unsigned int fd)
+ *               renamed, and "Doesn't take a separate reference count."
+ *
+ * So the PROTOTYPE is chosen at build time, from the kernel this variant is compiled for (the
+ * one place the difference is visible), and the name is resolved into it at run time.  What that
+ * does NOT cover, and the comment used to claim it did: a kernel whose helper kept the NAME but
+ * took the OTHER prototype - a vendor backport of the 6.1 shape onto a 5.x baseline, or the
+ * reverse.  Resolving by name cannot see that, and the two directions fail differently: the first
+ * does a second fput() on a reference it owns (refcount underflow), the second calls the newer
+ * helper through the older prototype, which then writes its out-parameter through the register
+ * that was never set.  Every stock tree checked (mainline 5.11..5.15, v5.15.y, GKI 5.10/5.15) has
+ * the older shape, which is why the build-time choice is right there; a vendor tree that moved
+ * pick_file() back would have to be looked at, not trusted.
+ *
+ * The reference count is a run-time fact in turn: opath_close_fd_extra_ref records whether the
+ * helper that answered owes the caller a second fput(). */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+static struct file *(*opath_close_fd)(unsigned int fd);
+#else
+static int (*opath_close_fd_get_file)(unsigned int fd, struct file **res);
+#endif
+/* Set when the resolved helper took a reference of its own (the pre-6.1 close_fd_get_file()):
+ * the deny path then owes the file two fput()s, and one of them would leak it for good. */
+static bool opath_close_fd_extra_ref;
+/* Which name the kernel above answered to (see susfs_opath_init): only the log needs it, and a log
+ * that prints a pointer without the name it came from cannot tell close_fd_get_file from
+ * file_close_fd on a kernel where one of them is missing. */
+static const char *opath_close_fd_name = "close_fd_get_file";
+
+static bool opath_close_fd_resolved(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	return opath_close_fd != NULL;
+#else
+	return opath_close_fd_get_file != NULL;
+#endif
+}
+
+static void *opath_close_fd_pointer(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	return (void *)opath_close_fd;
+#else
+	return (void *)opath_close_fd_get_file;
+#endif
+}
+
+/* Take the fd out of the table under whichever name this kernel has.  NULL means it was not
+ * ours to take; a non-NULL file is owned by the caller, which must release it - once, or twice
+ * when opath_close_fd_extra_ref is set. */
+static __nocfi struct file *opath_take_fd(unsigned int fd)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	if (opath_close_fd)
+		return opath_close_fd(fd);
+#else
+	/* Declared inside this arm on purpose: the 6.1+ helper returns the file itself, so the
+	 * out-parameter this one is called with does not exist on those kernels and a variable for
+	 * it there is -Wunused-variable under the build's -Werror. */
+	struct file *f = NULL;
+
+	if (opath_close_fd_get_file && !opath_close_fd_get_file(fd, &f))
+		return f;
+#endif
+	return NULL;
+}
+
+/* Return a raced descriptor only while holding the fd-table lock.  fd_install() cannot be used
+ * here: another CLONE_FILES thread may fill the slot after opath_take_fd() releases the kernel's
+ * lock, and fd_install() BUG_ON()s when the slot is no longer empty.  A failed restore leaves the
+ * slot owner untouched; the caller drops the references it took and keeps the original answer. */
+static bool opath_restore_fd(unsigned int fd, struct file *file)
+{
+	struct files_struct *files = current->files;
+	struct fdtable *fdt;
+	unsigned int word;
+	bool restored = false;
+
+	spin_lock(&files->file_lock);
+	fdt = files_fdtable(files);
+	/* An open bit set with an empty slot means another thread has reserved this number and is
+	 * between alloc_fd() and its lockless fd_install().  Do not race that publisher. */
+	if (fd < fdt->max_fds && !test_bit(fd, fdt->open_fds) &&
+	    !rcu_access_pointer(fdt->fd[fd])) {
+		rcu_assign_pointer(fdt->fd[fd], file);
+		__set_bit(fd, fdt->open_fds);
+		word = fd / BITS_PER_LONG;
+		if (!~fdt->open_fds[word])
+			__set_bit(word, fdt->full_fds_bits);
+		if (fd < files->next_fd)
+			files->next_fd = fd;
+		restored = true;
+	}
+	spin_unlock(&files->file_lock);
+	return restored;
+}
+
+static void opath_drop_taken(struct file *file)
+{
+	fput(file);
+	if (opath_close_fd_extra_ref)
+		fput(file);
+}
+
+/* What the layer did, not what it is configured to do: a wrapper that never runs and one that
+ * runs and matches nothing look identical from the outside, and only these separate them. */
+static atomic_t n_opath_seen = ATOMIC_INIT(0);	/* wrapper calls, hidden or not */
+static atomic_t n_opath_opath = ATOMIC_INIT(0);	/* of those, the O_PATH ones */
+static atomic_t n_opath_hidden = ATOMIC_INIT(0);	/* of those, sus_path said hidden */
+static atomic_t n_opath_deny = ATOMIC_INIT(0);	/* of those, the fd was taken away */
+static atomic_t n_opath_err = ATOMIC_INIT(0);	/* lookups that failed, or an fd not ours */
+
+int opath_test;
+module_param_named(opath_test, opath_test, int, 0644);
+
+int opath_dump;
+module_param_named(opath_dump, opath_dump, int, 0644);
+
+/* Set by susfs_opath_exit() before it touches anything; read by the arm path.  There is no
+ * lock around it, and that is deliberate - see the note in susfs_opath_exit(). */
+static bool opath_exiting;
+
+/* The post-check every wrapper funnels into - and, since open_redirect's name layer returns an fd of
+ * its own from inside those wrappers, the entry point it calls too.  Whatever produced the answer,
+ * an O_PATH fd that names a sus_path-hidden file is taken away the same way.
+ *
+ * Context: the syscall of the task that opened the file, i.e. ordinary process context - not a
+ * tracepoint's atomic section.  That is what makes the layer possible at all: close_fd_get_file()
+ * takes files->file_lock and sus_path_inode_hidden_public() takes sus_path_lock, and neither may
+ * be taken from the contexts the kprobe layers have to live with. */
+__nocfi long susfs_opath_post_fd(long ret)
+{
+	struct file *f, *victim;
+	bool hidden;
+
+	/* Only a successful open produced an fd; an error is nobody's business here. */
+	if (ret < 0)
+		return ret;
+
+	/* fget_raw(), not fget(): fget() is __fget(fd, FMODE_PATH, 1) (fs/file.c:921-925) and that
+	 * mask is a REJECTION mask - __fget_files_rcu() drops any file whose f_mode carries one of
+	 * those bits.  do_dentry_open() gives an O_PATH file exactly FMODE_PATH | FMODE_OPENED
+	 * (fs/open.c:801-805), so fget() answers NULL for precisely the files this layer has to
+	 * look at, and the check below would never see one.  fget_raw() passes mask 0
+	 * (fs/file.c:927-931) and takes any fd. */
+	f = opath_fget_raw((unsigned int)ret);
+	if (!f)
+		return ret;
+
+	if (!(f->f_mode & FMODE_PATH)) {
+		/* Not an O_PATH open: leave the answer untouched - but drop the reference
+		 * first, or every ordinary open would leak one. */
+		fput(f);
+		return ret;
+	}
+	atomic_inc(&n_opath_opath);
+
+	hidden = sus_path_inode_hidden_public(d_inode(f->f_path.dentry));
+
+	if (!hidden) {
+		fput(f);
+		return ret;
+	}
+	atomic_inc(&n_opath_hidden);
+
+	/* The descriptor is taken BY NUMBER while this task's fget_raw() reference on f is still held,
+	 * and the result is compared against it.  files_struct is shared (CLONE_FILES), so another
+	 * thread of this task can close this very number and open something else over it between the
+	 * check above and the take below: taking by number alone would then remove - and fput - a file
+	 * this layer never inspected, while answering -ENOENT for an open that matched nothing.
+	 * Holding f across the take costs one reference for a few instructions and turns that race into
+	 * a comparison. */
+	victim = opath_take_fd((unsigned int)ret);
+	if (!victim) {
+		/* The number is gone: nothing was taken, so the kernel's own answer stands. */
+		fput(f);
+		atomic_inc(&n_opath_err);
+		return ret;
+	}
+
+	if (victim != f) {
+		/* The number changed hands.  What came out is not the hidden file, so it is not ours to
+		 * remove.  Restore it only if the slot is still empty; otherwise leave the other thread's
+		 * descriptor untouched and drop the references returned by the take.  Closing it instead
+		 * would take away a descriptor this layer was never asked about, and answering -ENOENT would
+		 * deny an open that matched nothing. */
+		if (!opath_restore_fd((unsigned int)ret, victim))
+			opath_drop_taken(victim);
+		else if (opath_close_fd_extra_ref)
+			fput(victim);
+		fput(f);
+		atomic_inc(&n_opath_err);
+		return ret;
+	}
+
+	/* Same file: this is the hidden one, so the descriptor goes away - and the reference
+	 * bookkeeping has to match the helper this kernel has.
+	 *
+	 * fput() and not filp_close(): the close-fd helper's normal contract asks for filp_close()
+	 * first, and for an O_PATH file that reduces to exactly this call - do_dentry_open()
+	 * set f_op = &empty_fops, so f_op->flush is NULL, and a file that was never opened for
+	 * reading can hold neither a POSIX lock nor a dnotify mark, which are the other two
+	 * things filp_close() would run before fput().
+	 *
+	 * Three references pass through here on a pre-6.1 kernel and two on 6.1+: fget_raw()'s, the
+	 * one the take handed over, and - before 6.1 - the one close_fd_get_file() added itself
+	 * (fs/file.c: get_file() after the fd is out of the table).  Releasing only one of them (as
+	 * this did) leaked a struct file on every deny, which is visible as nr_files and filp slab
+	 * objects that never come back down; on 6.1+ a third fput() would be a refcount underflow. */
+	fput(f);
+	fput(victim);
+	if (opath_close_fd_extra_ref)
+		fput(victim);
+
+	atomic_inc(&n_opath_deny);
+	return -ENOENT;
+}
+
+/* One wrapper and one original slot PER TABLE ENTRY, which is what the SUSFS_FP_WRAPPER macro
+ * did in susfs_fp_hook.c before that layer was reduced to install/remove: a shared slot cannot
+ * work here, because the compat entries have different originals AND a different calling
+ * convention - a wrapper that read the native slot on behalf of a 32-bit task would hand it a
+ * native syscall, i.e. a different syscall with a different argument layout.  Each wrapper
+ * reads only its own slot.
+ * __nocfi is mandatory on both the wrapper and susfs_opath_post_fd(): the wrapper is reached
+ * through an indirect call out of the kernel's table, and it calls the original and the two
+ * resolved kernel functions the same way.
+ * The NULL test on the slot is not about the publish order - susfs_fp_install() publishes the
+ * original before it writes the table, so a live entry always has one - it is what turns a
+ * future mistake there into one failed open (-ENOSYS) instead of a jump to address 0. */
+/* The third parameter is the REGISTER INDEX that holds this entry's flags (-1 = "not in a
+ * register", see openat2 below), because the register is NOT the same for every entry:
+ * arm64 puts a syscall's arguments in regs->regs[0..5] for native and compat alike
+ * (arch/arm64/include/asm/syscall_wrapper.h:13-16, used for COMPAT_SYSCALL_DEFINEx at :27), so
+ * the index is just the argument number counting from 0:
+ *   - openat (fs/open.c:1336) and the AArch32 openat (fs/open.c:1383) are (dfd, filename,
+ *     flags, mode): flags is argument 3 -> regs->regs[2];
+ *   - the AArch32 open (fs/open.c:1374) is COMPAT_SYSCALL_DEFINE3: there is no dirfd, so the
+ *     arguments are (filename, flags, mode) and the flags are argument 2 -> regs->regs[1].
+ *     Reading regs[2] there would test the MODE, which is 0 or 0644/0755 in practice, and the
+ *     layer would quietly skip every 32-bit open() it exists to catch.
+ *   - openat2 (fs/open.c:1344) has a struct open_how __user * as argument 3: no flags to read,
+ *     so it passes -1 and always runs the full post-check.  A fast path there would need a
+ *     copy_from_user() for a syscall libc never issues by itself, and a failed copy would have
+ *     to fall back to the full check anyway.
+ * With a readable register the flags test runs BEFORE fget_raw(), so an ordinary open pays one
+ * register read and one taken branch instead of an fget_raw()/fput() pair.  The skip is exact
+ * rather than a shortcut - do_dentry_open() sets FMODE_PATH only for an O_PATH open
+ * (fs/open.c:801-805), so an open whose flags lack O_PATH cannot return the kind of file this
+ * layer looks at.  O_PATH is 010000000 for both ABIs (include/uapi/asm-generic/fcntl.h:85; the
+ * ARM overrides in arch/arm64/include/uapi/asm/fcntl.h:23-26 exist BECAUSE of the 32-bit ABI and
+ * leave O_PATH alone), and the 32-bit flags reach build_open_how() untranslated
+ * (fs/open.c:1374-1377), so one constant is right for both sides.
+ * n_opath_seen is bumped before anything else in the wrapper, so that a skipped ordinary open - and
+ * an open that open_redirect's name layer took over - still shows up as "a wrapper ran".  That
+ * counter is what tells a device bring-up apart "the entry is not reached at all" from "the entry is
+ * reached and the O_PATH test says no". */
+#define SUSFS_OPATH_WRAPPER(fn, slot, flags_reg, kind)			\
+	static __nocfi long fn(const struct pt_regs *regs)		\
+	{								\
+		susfs_syscall_fn_t orig = READ_ONCE(slot);		\
+		susfs_or_entry_fn_t or_hook = READ_ONCE(susfs_or_entry_hook);	\
+		long ret;						\
+									\
+		if (!orig)						\
+			return -ENOSYS;					\
+		atomic_inc(&n_opath_seen);				\
+		/* open_redirect's name layer is asked first, and gets the same five entries: a	\
+		 * syscall entry can have only one wrapper, so it registers a hook instead of	\
+		 * installing its own.  When it redirects, the original syscall is not called at	\
+		 * all - it opens the target itself and returns the fd, and that fd goes through	\
+		 * susfs_opath_post_fd() right here, so an O_PATH answer is judged the same way	\
+		 * whichever of the two produced it (and a negative errno passes straight through	\
+		 * that function, which leaves anything that is not an fd alone). */		\
+		if (or_hook) {						\
+			ret = or_hook(regs, (kind));			\
+			if (ret != SUSFS_OR_ENTRY_PASS) {		\
+				if ((flags_reg) >= 0 && ret >= 0 &&	\
+				    !(regs->regs[flags_reg] & O_PATH))	\
+					return ret;			\
+				return susfs_opath_post_fd(ret);	\
+			}						\
+		}							\
+		ret = orig(regs);					\
+		if ((flags_reg) >= 0 && !(regs->regs[flags_reg] & O_PATH))	\
+			return ret;					\
+		return susfs_opath_post_fd(ret);			\
+	}
+
+static susfs_syscall_fn_t opath_orig_openat;
+static susfs_syscall_fn_t opath_orig_openat2;
+static susfs_syscall_fn_t opath_orig_compat_open;
+static susfs_syscall_fn_t opath_orig_compat_openat;
+static susfs_syscall_fn_t opath_orig_compat_openat2;
+
+SUSFS_OPATH_WRAPPER(susfs_opath_openat, opath_orig_openat, 2, SUSFS_OR_ENTRY_OPENAT)
+SUSFS_OPATH_WRAPPER(susfs_opath_openat2, opath_orig_openat2, -1, SUSFS_OR_ENTRY_OPENAT2)
+SUSFS_OPATH_WRAPPER(susfs_opath_compat_open, opath_orig_compat_open, 1, SUSFS_OR_ENTRY_COMPAT_OPEN)
+SUSFS_OPATH_WRAPPER(susfs_opath_compat_openat, opath_orig_compat_openat, 2, SUSFS_OR_ENTRY_COMPAT_OPENAT)
+SUSFS_OPATH_WRAPPER(susfs_opath_compat_openat2, opath_orig_compat_openat2, -1, SUSFS_OR_ENTRY_COMPAT_OPENAT2)
+
+/* The five entries.  nr < 0 means "no native entry": arm64 has no native open at all, and for
+ * the AArch32 open(5) the native number 5 is setxattr (include/uapi/asm-generic/unistd.h:47) -
+ * so the compat-only hooks carry their index in nr_compat and leave the native table alone.
+ * openat2 is the one syscall that needs an entry in BOTH tables (see SUSFS_COMPAT_NR_OPENAT2),
+ * which is why it appears twice: same number, two array elements, two hooks.
+ * The combinations, one line each (nr / nr_compat), which is also what struct susfs_fp_hook
+ * documents:
+ *   openat        :  56 / 0   - native only; the AArch32 openat is a different number (322) and
+ *                               its own entry below.
+ *   openat2       : 437 / 0   - native only.  A 32-bit task never reads this table - it
+ *                               dispatches through compat_sys_call_table
+ *                               (arch/arm64/kernel/syscall.c:185-189) - and the kernel fills
+ *                               that table's slot 437 with __arm64_sys_openat2 as well
+ *                               (arch/arm64/include/asm/unistd32.h:884-885).  Same function,
+ *                               DIFFERENT array element: patching the native slot leaves the
+ *                               32-bit one untouched, which is why the fifth line below exists.
+ *   compat open   :  -1 / 5   - compat only: there is no native open to patch.
+ *   compat openat :  -1 / 322 - compat only, same reason; native openat is 56.
+ *   compat openat2:  -1 / 437 - compat only, same number as the native slot but a different
+ *                               element (SUSFS_COMPAT_NR_OPENAT2).
+ *
+ * __NR_openat2 is used under #ifdef: the number only exists in a kernel that has the syscall,
+ * and the index handed to the table must be the kernel's own idea of it, never a constant
+ * written here.  A kernel without it simply has one entry fewer, the layer still arms, and the
+ * log says so - nothing else in this file depends on that entry. */
+static struct susfs_fp_hook opath_hooks[] = {
+	{
+		.nr		= __NR_openat,
+		.name		= "opath/openat",
+		.sym		= "__arm64_sys_openat",
+		.wrapper	= susfs_opath_openat,
+		.orig_slot	= &opath_orig_openat,
+	},
+#ifdef __NR_openat2
+	{
+		.nr		= __NR_openat2,
+		.name		= "opath/openat2",
+		.sym		= "__arm64_sys_openat2",
+		.wrapper	= susfs_opath_openat2,
+		.orig_slot	= &opath_orig_openat2,
+	},
+	/* The 32-bit side of the same syscall is a separate table element - see
+	 * SUSFS_COMPAT_NR_OPENAT2 - so it gets a hook of its own rather than an nr_compat on the
+	 * one above: the two are independent elements and either can be missing on a kernel of
+	 * its own, which is exactly what per-hook install/logging is for. */
+	{
+		.nr		= -1,
+		.nr_compat	= SUSFS_COMPAT_NR_OPENAT2,
+		.name		= "opath/compat openat2",
+		.sym		= "__arm64_sys_openat2",
+		.wrapper	= susfs_opath_compat_openat2,
+		.orig_slot_compat = &opath_orig_compat_openat2,
+	},
+#endif
+	{
+		.nr		= -1,
+		.nr_compat	= SUSFS_COMPAT_NR_OPEN,
+		.name		= "opath/compat open",
+		.sym		= "__arm64_compat_sys_open",
+		.wrapper	= susfs_opath_compat_open,
+		.orig_slot_compat = &opath_orig_compat_open,
+	},
+	{
+		.nr		= -1,
+		.nr_compat	= SUSFS_COMPAT_NR_OPENAT,
+		.name		= "opath/compat openat",
+		.sym		= "__arm64_compat_sys_openat",
+		.wrapper	= susfs_opath_compat_openat,
+		.orig_slot_compat = &opath_orig_compat_openat,
+	},
+};
+
+/* Whether the entries open_redirect's name layer needs actually carry this layer's wrapper.  "The
+ * layer is armed" has to mean those entries and not "the module came up": opath_dump=1 installs
+ * nothing at all, and opath_test=N installs at most the one entry it selects, while both report
+ * success.  The first two entries are the native openat/openat2, which is what every 64-bit caller
+ * goes through (every tree this module supports has __NR_openat2); a device carrying only the compat
+ * entries is not a configuration the name layer can work on.  Installed is written by
+ * susfs_fp_install()/susfs_fp_remove() under the same lock the layer arms under, and read here
+ * without it, hence the READ_ONCE. */
+bool susfs_opath_armed(void)
+{
+	/* The index is only used where the array really holds that entry: __NR_openat2 exists in every
+	 * tree this module supports, and the guard keeps a tree without it from asking about the compat
+	 * entry by mistake. */
+#ifdef __NR_openat2
+	return READ_ONCE(opath_hooks[0].installed) && READ_ONCE(opath_hooks[1].installed);
+#else
+	return READ_ONCE(opath_hooks[0].installed);
+#endif
+}
+
+/* Table entries are data, so this is a plain read - what it is for is telling "our wrapper is
+ * in there" from "the kernel's own stub is in there", which the address alone cannot answer on
+ * a kernel whose symbols are hidden from a non-root reader. */
+static void opath_dump_entry(const char *table_name, unsigned long table, int nr,
+			     const char *sym)
+{
+	char cfi_name[128];
+	susfs_syscall_fn_t entry;
+	unsigned long plain, cfi;
+
+	if (!table || nr < 0) {
+		pr_warn("opath dump: %s[%d] %s: no table (0x%lx) or no index\n",
+			table_name, nr, sym, table);
+		return;
+	}
+	entry = READ_ONCE(((susfs_syscall_fn_t *)table)[nr]);
+	plain = find_kernel_symbol_exact(sym);
+	snprintf(cfi_name, sizeof(cfi_name), "%s.cfi_jt", sym);
+	cfi = find_kernel_symbol_exact(cfi_name);
+
+	pr_info("opath dump: %s[%d] %s: entry=%px plain=%px cfi_jt=%px -> %s\n",
+		table_name, nr, sym, (void *)entry, (void *)plain, (void *)cfi,
+		entry == (susfs_syscall_fn_t)cfi ? "cfi_jt match" :
+		(entry == (susfs_syscall_fn_t)plain ? "plain match" : "neither"));
+}
+
+static void susfs_opath_dump_all(void)
+{
+	int i;
+
+	pr_info("opath dump: sys_call_table=%px compat_sys_call_table=%px, %u entries defined here\n",
+		(void *)susfs_fp_syscall_table(), (void *)susfs_fp_compat_syscall_table(),
+		(unsigned int)ARRAY_SIZE(opath_hooks));
+
+	for (i = 0; i < (int)ARRAY_SIZE(opath_hooks); i++) {
+		struct susfs_fp_hook *h = &opath_hooks[i];
+
+		pr_info("opath dump: [%d] %s nr=%d nr_compat=%d wrapper=%px bti_c=%d\n",
+			i + 1, h->name, h->nr, h->nr_compat,
+			(void *)h->wrapper, (int)opath_has_landing_pad((const void *)h->wrapper));
+
+		/* susfs_fp_dump_entry() prints the native table only, so the compat entries are
+		 * printed here - through the accessor, because the table pointer itself is
+		 * private to susfs_fp_hook.c. */
+		if (h->nr >= 0)
+			susfs_fp_dump_entry(h->nr, h->sym);
+		else
+			opath_dump_entry("compat_sys_call_table",
+					 susfs_fp_compat_syscall_table(),
+					 h->nr_compat, h->sym);
+	}
+}
+
+/* ---- /proc/susfs_opath ---- */
+static int opath_proc_show(struct seq_file *m, void *v);
+static int opath_proc_open(struct inode *inode, struct file *file);
+
+static const struct proc_ops opath_proc_ops = {
+	.proc_open = opath_proc_open,
+	.proc_read = seq_read,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
+static struct proc_dir_entry *opath_proc_entry;
+
+static int opath_proc_show(struct seq_file *m, void *v)
+{
+	int i;
+
+	for (i = 0; i < (int)ARRAY_SIZE(opath_hooks); i++) {
+		struct susfs_fp_hook *h = &opath_hooks[i];
+
+		seq_printf(m, "[%d] %s nr=%d nr_compat=%d installed=%d wrapper=%px orig=%px orig_compat=%px\n",
+			   i + 1, h->name, h->nr, h->nr_compat, (int)h->installed,
+			   (void *)h->wrapper, (void *)h->orig, (void *)h->orig_compat);
+	}
+
+	/* No "armed" flag of its own: `installed` above is the state, one line per entry.  The
+	 * counters are what a bring-up is judged by - seen without opath means the wrapper runs
+	 * and every open it sees is not an O_PATH one, and hidden without deny would mean the fd
+	 * was not taken away. */
+	seq_printf(m, "seen=%d opath=%d hidden=%d deny=%d err=%d (opath_test=%d opath_dump=%d)\n",
+		   atomic_read(&n_opath_seen), atomic_read(&n_opath_opath),
+		   atomic_read(&n_opath_hidden), atomic_read(&n_opath_deny),
+		   atomic_read(&n_opath_err), opath_test, opath_dump);
+	return 0;
+}
+
+static int opath_proc_open(struct inode *inode, struct file *file)
+{
+	/* Root-only, with 0777 on the node on purpose: DAC has to pass so that sus_path's LSM
+	 * layer is the only thing answering a non-root reader (ENOENT), see susfs_main.c and
+	 * susfs_kstat_init().  Created only when that layer is up (susfs_control_node_allowed). */
+	if (!susfs_control_visible())
+		return -ENOENT;
+	return single_open(file, opath_proc_show, NULL);
+}
+
+int susfs_opath_init(void)
+{
+	int i, attempted = 0, armed = 0, err;
+
+	if (opath_exiting) {
+		pr_warn("opath: init while the layer is being torn down - not arming\n");
+		return -ENODEV;
+	}
+
+	opath_fget_raw = (void *)find_kernel_symbol_exact("fget_raw");
+
+	/* Which close-fd helper this kernel has, under WHICH prototype.  close_fd_get_file() kept its
+	 * name across 6.1 and changed its signature there, so the prototype comes from the kernel
+	 * this variant is built for (see the note on the pointers above) and the name is resolved
+	 * into it.  file_close_fd() exists only where the old name does not, so it is tried after
+	 * it; resolving by name - rather than assuming a version's name set - is what still covers
+	 * a vendor backport of either helper. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	opath_close_fd = (void *)find_kernel_symbol_exact("close_fd_get_file");
+	opath_close_fd_name = "close_fd_get_file";
+	if (!opath_close_fd) {
+		opath_close_fd = (void *)find_kernel_symbol_exact("file_close_fd");
+		opath_close_fd_name = "file_close_fd";
+	}
+#else
+	opath_close_fd_get_file = (void *)find_kernel_symbol_exact("close_fd_get_file");
+	opath_close_fd_name = "close_fd_get_file";
+	/* Its result owns two references: the fd table's, and the one get_file() added. */
+	opath_close_fd_extra_ref = true;
+#endif
+
+	if (!opath_fget_raw || !opath_close_fd_resolved()) {
+		/* Refusing to install beats installing a wrapper that cannot finish: without these the
+		 * post-check could not take a descriptor away, so the layer would only have added a fault
+		 * path to every open on the system.  Every name is printed, because "the name is missing"
+		 * is only useful with which one. */
+		pr_warn("opath: fget_raw=%px close_fd_get_file=%px file_close_fd=%px - a name was not resolved, no table entry is installed and O_PATH stays visible\n",
+			(void *)opath_fget_raw,
+			(void *)find_kernel_symbol_exact("close_fd_get_file"),
+			(void *)find_kernel_symbol_exact("file_close_fd"));
+		atomic_inc(&n_opath_err);
+		return -ENOENT;
+	}
+
+	err = susfs_fp_init();
+	if (err) {
+		pr_warn("opath: susfs_fp_init failed %d - the layer stays off\n", err);
+		return err;
+	}
+
+	if (opath_dump) {
+		susfs_opath_dump_all();
+		/* Nothing is installed on purpose, and the layer is still "armed" for the
+		 * layer table: this mode exists to read the device's own answers (entry
+		 * values, symbols, the landing pad) before any entry is replaced. */
+		SUSFS_LOGI("opath: opath_dump=%d - diagnostics only, nothing installed\n", opath_dump);
+		return 0;
+	}
+
+	for (i = 0; i < (int)ARRAY_SIZE(opath_hooks); i++) {
+		struct susfs_fp_hook *h = &opath_hooks[i];
+
+		if (opath_test && opath_test != i + 1) {
+			SUSFS_LOGI("opath: [%d] %s skipped (opath_test=%d)\n",
+				i + 1, h->name, opath_test);
+			continue;
+		}
+		attempted++;
+
+		/* One entry at a time and never fatal for the others: the remaining entries
+		 * still answer the kernel's own way, which is what makes a first bring-up
+		 * readable instead of all-or-nothing. */
+		err = susfs_fp_install(h);
+		if (err) {
+			pr_warn("opath: [%d] %s not installed (%d) - that ABI stays visible\n",
+				i + 1, h->name, err);
+			continue;
+		}
+		armed++;
+	}
+
+	if (!attempted) {
+		pr_warn("opath: opath_test=%d selects none of the %u entries - the layer stays off\n",
+			opath_test, (unsigned int)ARRAY_SIZE(opath_hooks));
+		return -EINVAL;
+	}
+	if (!armed) {
+		/* Non-zero so the layer table records "not armed"; the caller's exit is
+		 * idempotent, so the entries that did go in are taken back out. */
+		pr_warn("opath: none of the %d selected table entries could be installed - O_PATH stays visible\n",
+			attempted);
+		return -ENOENT;
+	}
+	if (armed < attempted)
+		pr_warn("opath: %d of %d selected table entries installed - O_PATH is answered only for those (the log above names the rest)\n",
+			armed, attempted);
+
+
+	if (susfs_control_node_allowed()) {
+		opath_proc_entry = proc_create("susfs_opath", 0777, NULL, &opath_proc_ops);
+		if (!opath_proc_entry)
+			pr_warn("opath: proc_create(susfs_opath) failed\n");
+	} else {
+		SUSFS_LOGI("opath: /proc node not created (expose_proc=%d lsm=%d)\n",
+			(int)susfs_expose_proc, (int)sus_path_lsm_active());
+	}
+
+	SUSFS_LOGI("opath armed: %d/%d entries, proc=%d, fget_raw=%px %s=%px extra_ref=%d\n",
+		armed, attempted, opath_proc_entry != NULL,
+		(void *)opath_fget_raw, opath_close_fd_name,
+		opath_close_fd_pointer(), (int)opath_close_fd_extra_ref);
+	return 0;
+}
+
+void susfs_opath_exit(void)
+{
+	int i;
+
+	/* Idempotent: the flag is what makes it so, and it matters because this exit runs for
+	 * BOTH paths that can reach it - the rollback of a failed load and the unload of a
+	 * loaded module - and the drain below is a synchronize_rcu_tasks() that must not be
+	 * repeated for no reason.
+	 *
+	 * No lock around the flag, and none of the *_exiting-plus-mutex discipline
+	 * susfs_open_redirect.c needs: there, or_register() is reachable from a /proc write
+	 * whose fd holds no module reference, so a write already inside the handler can re-arm
+	 * a probe after the module has been freed.  This layer has no such path - its only arm
+	 * entry point is susfs_opath_init(), reached from susfs_init() before the module is
+	 * reachable by any caller and never again: no supercall, no /proc write and no other
+	 * layer installs a table entry here.  The flag is kept so the invariant is stated in
+	 * code rather than in a comment, and so a future arm path has to be added on purpose. */
+	if (opath_exiting)
+		return;
+	opath_exiting = true;
+
+	/* Before the entries come out: the name layer must stop being reachable from them at the same
+	 * moment, and susfs_or_entry_exit() (called from open_redirect's exit, which runs first because
+	 * the layer table is torn down in reverse) has already cleared its hook pointer. */
+
+	for (i = 0; i < (int)ARRAY_SIZE(opath_hooks); i++)
+		susfs_fp_remove(&opath_hooks[i]);
+
+	/* AFTER every entry is restored, never before: this waits until no CPU can still be
+	 * inside a wrapper, and an entry that still pointed at one of them would send the next
+	 * caller into module text the kernel is about to free.  Restoring the entries stops new
+	 * callers; only the drain covers the caller that already picked the wrapper out of the
+	 * table. */
+	susfs_fp_drain();
+
+	if (opath_proc_entry) {
+		proc_remove(opath_proc_entry);
+		opath_proc_entry = NULL;
+	}
+
+	SUSFS_LOGI("opath disarmed: seen=%d opath=%d hidden=%d deny=%d err=%d\n",
+		atomic_read(&n_opath_seen), atomic_read(&n_opath_opath),
+		atomic_read(&n_opath_hidden), atomic_read(&n_opath_deny),
+		atomic_read(&n_opath_err));
+}
diff --git a/KernelSU/kernel/susfs/susfs_opath.h b/KernelSU/kernel/susfs/susfs_opath.h
new file mode 100644
index 000000000000..24c2c7640466
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_opath.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * susfs_opath.h - the O_PATH layer: its control entry points only.
+ *
+ * The hidden decision this layer post-checks with belongs to sus_path and is declared
+ * there (susfs.h), next to sus_path_init()/sus_path_lsm_active(): a header for one layer
+ * must not pretend to own another layer's API.
+ */
+
+#ifndef __SUSFS_OPATH_H
+#define __SUSFS_OPATH_H
+
+/* Both are read at INIT, like fail_layer in susfs_main.c, so they belong on the insmod
+ * command line (`insmod susfs_guard_lkm.ko opath_test=2`); a later write to
+ * /sys/module/susfs_guard_lkm/parameters/ changes the variable and nothing else.
+ *
+ * opath_test: 1-based index of the ONE table entry to install, 0 = all of them.  One entry
+ * at a time is what makes a first bring-up diagnosable: a wrapper that faults shows up as a
+ * failure of that entry, with the other three still answering the kernel's own way.
+ * opath_dump: print the diagnostics (each entry's current value, the plain and .cfi_jt
+ * symbols, whether the wrapper starts with 'bti c') and install NOTHING - the readings a
+ * step has to be judged against have to come from the device, not from the build host. */
+extern int opath_test;
+extern int opath_dump;
+
+int susfs_opath_init(void);
+void susfs_opath_exit(void);
+
+/* The layer's control node: reading it is the only live view of the counters, and
+ * "armed" without a hit count cannot tell a wrapper that never runs from one that runs and
+ * matches nothing.  Registered in susfs_main.c's self-hide list like every other node of
+ * this module (0777 plus sus_path's LSM layer answering ENOENT, see susfs_main.c). */
+#define SUSFS_OPATH_NODE "/proc/susfs_opath"
+
+#endif /* __SUSFS_OPATH_H */
diff --git a/KernelSU/kernel/susfs/susfs_open_data.h b/KernelSU/kernel/susfs/susfs_open_data.h
