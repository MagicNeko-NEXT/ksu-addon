diff --git a/KernelSU/kernel/susfs/sus_mount_view.c b/KernelSU/kernel/susfs/sus_mount_view.c
new file mode 100644
index 000000000000..4c7f7b6890bc
--- /dev/null
+++ b/KernelSU/kernel/susfs/sus_mount_view.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * sus_mount_view.c - P-owned mount walk
+ *
+ * View contract: values only.  The walk holds rcu_read_lock() from begin to
+ * end and climbs mnt_parent only while staying in the starting namespace.  No
+ * path string is produced here yet, so V_PATH stays clear.
+ */
+
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/mount.h>
+#include <linux/dcache.h>
+#include <linux/rcupdate.h>
+#include <linux/version.h>
+
+#include "mount.h"
+#include "sus_mount_view.h"
+
+#define SUS_MOUNT_WALK_MAX_DEPTH 64
+
+struct sus_mount_walk {
+	struct mount *cur;
+	struct mnt_namespace *ns;
+	enum sus_mount_context ctx;
+	unsigned int depth;
+	bool ended;
+};
+
+static u32 sus_mount_ptr_cookie(const void *p)
+{
+	return p ? ((u32)((unsigned long)p >> 4) | 1u) : 0;
+}
+
+static void sus_mount_view_fill(struct sus_mount_view *out, struct mount *m,
+				     enum sus_mount_context ctx)
+{
+	struct dentry *root = m->mnt.mnt_root;
+	struct inode *inode = root ? d_inode(root) : NULL;
+
+	memset(out, 0, sizeof(*out));
+	out->ctx = ctx;
+	out->mnt_id = (int)m->mnt_id;
+	out->valid_mask |= SUS_MOUNT_V_MNT_ID;
+	if (m->mnt_parent && m->mnt_parent != m) {
+		out->parent_id = (int)m->mnt_parent->mnt_id;
+		out->valid_mask |= SUS_MOUNT_V_PARENT;
+	}
+	if (m->mnt.mnt_sb) {
+		out->s_dev = m->mnt.mnt_sb->s_dev;
+		out->valid_mask |= SUS_MOUNT_V_DEVID;
+	}
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 3, 0)
+	if (m->mnt.mnt_idmap) {
+		out->idmap_cookie = sus_mount_ptr_cookie(m->mnt.mnt_idmap);
+		out->valid_mask |= SUS_MOUNT_V_IDMAP_NS;
+	}
+#endif
+	if (m->mnt_ns) {
+		out->mnt_ns_cookie = sus_mount_ptr_cookie(m->mnt_ns);
+		out->valid_mask |= SUS_MOUNT_V_MNT_NS;
+		if (m->mnt_ns->user_ns) {
+			out->user_ns_cookie = sus_mount_ptr_cookie(m->mnt_ns->user_ns);
+			out->valid_mask |= SUS_MOUNT_V_USER_NS;
+		}
+	}
+	if (inode) {
+		out->root_ino = inode->i_ino;
+		out->valid_mask |= SUS_MOUNT_V_ROOT_INO;
+	}
+	if (m->mnt_devname) {
+		strscpy(out->source_devname, m->mnt_devname,
+			sizeof(out->source_devname));
+		out->source_len = (u16)strlen(out->source_devname);
+		out->source = out->source_len && out->source_devname[0] == '/'
+			       ? SUS_MOUNT_SRC_PATH : SUS_MOUNT_SRC_DEVNAME;
+		out->valid_mask |= SUS_MOUNT_V_DEVNAME;
+	}
+}
+
+void sus_mount_view_from_mount(struct sus_mount_view *out, struct mount *m,
+			       enum sus_mount_context ctx)
+{
+	if (out && m)
+		sus_mount_view_fill(out, m, ctx);
+}
+
+
+struct sus_mount_walk *sus_mount_walk_begin(struct mount *start,
+					    enum sus_mount_context ctx)
+{
+	struct sus_mount_walk *walk;
+
+	if (!start || !sus_mount_view_ctx_valid(ctx))
+		return NULL;
+	walk = kzalloc(sizeof(*walk), GFP_ATOMIC);
+	if (!walk)
+		return NULL;
+	walk->cur = start;
+	walk->ns = start->mnt_ns;
+	walk->ctx = ctx;
+	rcu_read_lock();
+	return walk;
+}
+
+bool sus_mount_walk_next(struct sus_mount_walk *walk, struct sus_mount_view *out,
+			 int *err)
+{
+	if (err)
+		*err = 0;
+	if (!walk || !out || walk->ended || !walk->cur)
+		return false;
+	sus_mount_view_fill(out, walk->cur, walk->ctx);
+	walk->depth++;
+	if (walk->depth >= SUS_MOUNT_WALK_MAX_DEPTH ||
+	    walk->cur->mnt_ns != walk->ns ||
+	    !walk->cur->mnt_parent || walk->cur->mnt_parent == walk->cur) {
+		walk->ended = true;
+	} else {
+		walk->cur = walk->cur->mnt_parent;
+	}
+	return true;
+}
+
+void sus_mount_walk_end(struct sus_mount_walk *walk)
+{
+	if (!walk)
+		return;
+	rcu_read_unlock();
+	kfree(walk);
+}
diff --git a/KernelSU/kernel/susfs/sus_mount_view.h b/KernelSU/kernel/susfs/sus_mount_view.h
new file mode 100644
index 000000000000..d89e6d95b2bf
--- /dev/null
+++ b/KernelSU/kernel/susfs/sus_mount_view.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * sus_mount_view.h - value view shared by sus_mount's layers
+ *
+ * The view carries values, never kernel object pointers.  The kernel build
+ * uses <linux/types.h>; the host-side view test uses fixed-width types.
+ */
+
+#ifndef __SUS_MOUNT_VIEW_H
+#define __SUS_MOUNT_VIEW_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/string.h>
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef uint32_t dev_t;
+typedef uint32_t uid_t;
+#endif
+
+#define SUS_MOUNT_VIEW_DEVNAME_MAX 128
+#define SUS_MOUNT_VIEW_PATH_MAX    512
+
+enum sus_mount_context {
+	SUS_MOUNT_CTX_SHOW,
+	SUS_MOUNT_CTX_SCAN,
+	SUS_MOUNT_CTX_RECORD,
+};
+
+enum sus_mount_source {
+	SUS_MOUNT_SRC_UNKNOWN,
+	SUS_MOUNT_SRC_DEVNAME,
+	SUS_MOUNT_SRC_PATH,
+};
+
+enum sus_mount_show_action {
+	SUS_MOUNT_SHOW_VISIBLE,
+	SUS_MOUNT_SHOW_HIDE,
+};
+
+enum sus_mount_record_action {
+	SUS_MOUNT_RECORD_SKIP,
+	SUS_MOUNT_RECORD_TAKE,
+};
+
+enum sus_mount_valid {
+	SUS_MOUNT_V_MNT_ID    = 1u << 0,
+	SUS_MOUNT_V_PARENT    = 1u << 1,
+	SUS_MOUNT_V_DEVID     = 1u << 2,
+	SUS_MOUNT_V_DEVNAME   = 1u << 3,
+	SUS_MOUNT_V_PATH      = 1u << 4,
+	SUS_MOUNT_V_MNT_NS    = 1u << 5,
+	SUS_MOUNT_V_USER_NS   = 1u << 6,
+	SUS_MOUNT_V_IDMAP_NS  = 1u << 7,
+	SUS_MOUNT_V_SU_DOMAIN = 1u << 8,
+	SUS_MOUNT_V_CONTROL   = 1u << 9,
+	SUS_MOUNT_V_ROOT_INO  = 1u << 10,
+};
+
+struct sus_mount_view {
+	u32 valid_mask;
+	enum sus_mount_context ctx;
+	int mnt_id;
+	int parent_id;
+	dev_t s_dev;
+	unsigned long root_ino;
+	u32 mnt_ns_cookie;
+	u32 user_ns_cookie;
+	u32 idmap_cookie;
+	char source_devname[SUS_MOUNT_VIEW_DEVNAME_MAX];
+	u16 source_len;
+	bool source_truncated;
+	char mountpoint_path[SUS_MOUNT_VIEW_PATH_MAX];
+	u16 path_len;
+	bool path_truncated;
+	bool path_unavailable;
+	bool prefix_matched;
+	enum sus_mount_source source;
+	bool caller_is_su_domain;
+	bool control_visible;
+};
+
+static inline bool sus_mount_view_has(const struct sus_mount_view *v, u32 bit)
+{
+	return v && (v->valid_mask & bit) == bit;
+}
+
+static inline void sus_mount_view_set_prefix(struct sus_mount_view *v,
+					     bool matched)
+{
+	if (v)
+		v->prefix_matched = matched;
+}
+
+static inline enum sus_mount_record_action
+sus_mount_record_decide(const struct sus_mount_view *v, bool devname_ours,
+			bool path_ours)
+{
+	if (v)
+		return v->prefix_matched ? SUS_MOUNT_RECORD_TAKE
+					 : SUS_MOUNT_RECORD_SKIP;
+	return (devname_ours || path_ours) ? SUS_MOUNT_RECORD_TAKE
+					   : SUS_MOUNT_RECORD_SKIP;
+}
+
+static inline enum sus_mount_show_action
+sus_mount_show_decide(const struct sus_mount_view *v, bool is_ours, bool su)
+{
+	(void)v;
+	if (!is_ours || su)
+		return SUS_MOUNT_SHOW_VISIBLE;
+	return SUS_MOUNT_SHOW_HIDE;
+}
+
+static inline bool sus_mount_view_ctx_valid(enum sus_mount_context ctx)
+{
+	return ctx == SUS_MOUNT_CTX_SHOW || ctx == SUS_MOUNT_CTX_SCAN ||
+	       ctx == SUS_MOUNT_CTX_RECORD;
+}
+
+/* Fields that each context is allowed to fill. */
+static inline u32 sus_mount_view_required(enum sus_mount_context ctx)
+{
+	switch (ctx) {
+	case SUS_MOUNT_CTX_SHOW:
+		return SUS_MOUNT_V_MNT_ID | SUS_MOUNT_V_PARENT |
+		       SUS_MOUNT_V_DEVID | SUS_MOUNT_V_ROOT_INO | SUS_MOUNT_V_DEVNAME |
+		       SUS_MOUNT_V_MNT_NS | SUS_MOUNT_V_USER_NS |
+		       SUS_MOUNT_V_IDMAP_NS | SUS_MOUNT_V_SU_DOMAIN |
+		       SUS_MOUNT_V_CONTROL;
+	case SUS_MOUNT_CTX_SCAN:
+	case SUS_MOUNT_CTX_RECORD:
+		return SUS_MOUNT_V_MNT_ID | SUS_MOUNT_V_PARENT |
+		       SUS_MOUNT_V_DEVID | SUS_MOUNT_V_ROOT_INO | SUS_MOUNT_V_DEVNAME |
+		       SUS_MOUNT_V_PATH | SUS_MOUNT_V_MNT_NS |
+		       SUS_MOUNT_V_USER_NS | SUS_MOUNT_V_IDMAP_NS;
+	default:
+		return 0;
+	}
+}
+
+static inline void sus_mount_view_set_path(struct sus_mount_view *out,
+					   const char *path, size_t len)
+{
+	size_t n;
+
+	if (!out || !path)
+		return;
+	n = len < sizeof(out->mountpoint_path) - 1 ?
+		len : sizeof(out->mountpoint_path) - 1;
+	memcpy(out->mountpoint_path, path, n);
+	out->mountpoint_path[n] = 0;
+	out->path_len = (u16)n;
+	out->path_truncated = len > n;
+	out->path_unavailable = false;
+	out->source = SUS_MOUNT_SRC_PATH;
+	out->valid_mask |= SUS_MOUNT_V_PATH;
+}
+
+#ifdef __KERNEL__
+struct mount;
+
+struct sus_mount_walk;
+
+struct sus_mount_walk *
+sus_mount_walk_begin(struct mount *start, enum sus_mount_context ctx);
+void sus_mount_view_from_mount(struct sus_mount_view *out, struct mount *m,
+			       enum sus_mount_context ctx);
+bool sus_mount_walk_next(struct sus_mount_walk *walk,
+			 struct sus_mount_view *out, int *err);
+void sus_mount_walk_end(struct sus_mount_walk *walk);
+#endif
+
+#endif /* __SUS_MOUNT_VIEW_H */
diff --git a/KernelSU/kernel/susfs/sus_path.c b/KernelSU/kernel/susfs/sus_path.c
new file mode 100644
index 000000000000..f6cecf0bdf34
--- /dev/null
+++ b/KernelSU/kernel/susfs/sus_path.c
@@ -0,0 +1,3013 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * sus_path.c - SUSFS SUS_PATH for the LKM, in two independent layers.
+ *
+ * Upstream sets AS_FLAGS_SUS_PATH on inode->i_mapping, skips the entry inside
+ * filldir64() (fs/readdir.c) and hides it from path-based access by patching
+ * fs/namei.c (link_path_walk returns -ENOENT; __lookup_slow/lookup_open redo the
+ * lookup with the fake qstr "..5.u.S").  This LKM can touch neither - filldir64 is
+ * static and LTO-inlined, namei.c is compiled into the kernel - so it reproduces
+ * both effects: the getdents64 buffer is rewritten on return (layer 1, by (ino,
+ * name) - a dirent record carries no dev, see sus_path_is_hidden()), and two LSM
+ * hooks answer registered inodes with -ENOENT (layer 2:
+ * inode_getattr for stat/fstatat/statx, inode_permission for
+ * open/exec/chmod/truncate/...).
+ *
+ * Matching mirrors upstream: exact inode identity (not name substrings), any number
+ * of registered paths, hidden wherever that inode is reached ('..', '//', relative
+ * paths, symlinks, hard links, /proc/self/root/...), and the upstream gate - app
+ * processes only and never a file owned by the caller (sus_path_entry_gate(),
+ * hide_from_apps=0 disables the gate for a root shell).  A path registered before it
+ * exists is kept and hidden once it appears, upstream's CMD_SUSFS_ADD_SUS_PATH_LOOP /
+ * LH_SUS_PATH_LOOP behaviour (sus_path_resolve_pending()).
+ *
+ * Upstream's FUSE_SUPER_MAGIC branch (susfs.c:71-84, :151-166, :195-212) has no
+ * equivalent here on purpose - see the note above sus_path_inode_hidden().
+ */
