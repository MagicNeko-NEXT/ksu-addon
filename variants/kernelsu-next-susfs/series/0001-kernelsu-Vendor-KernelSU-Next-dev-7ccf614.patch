diff --git a/KernelSU/kernel/susfs/HooKern/hk.c b/KernelSU/kernel/susfs/HooKern/hk.c
new file mode 100644
index 000000000000..c0c8dc2461bb
--- /dev/null
+++ b/KernelSU/kernel/susfs/HooKern/hk.c
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "hk.h"
+#include "hk_ptr.h"
+#include "hk_kprobe.h"
+#include "hk_kretprobe.h"
+#include "hk_redir.h"
+#include "hk_sighook.h"
+#include "hk_inline.h"
+#include "hk_patch.h"
+
+static struct hk_cfg g_cfg;
+static bool g_exiting;
+
+/*
+ * the body of a function whose address was taken is named name$type on a clang cfi
+ * build, and the suffix is not something a caller can know. the walk that used to
+ * find it goes through the kernel's symbol iterator, whose callback is four
+ * arguments on one kernel and three on another, and passing the wrong one is a cfi
+ * failure rather than a wrong answer. the stub the plain symbol names is a branch to
+ * that body, so the body is reached by following it, which costs no callback and no
+ * allocation and therefore also works from a probe handler
+ */
+#define HK_STUB_FOLLOW 8
+
+static u32 hk_read_insn(unsigned long addr)
+{
+	u32 insn = 0;
+
+	if (copy_from_kernel_nofault(&insn, (const void *)addr, sizeof(insn)))
+		return 0;
+	return insn;
+}
+
+static unsigned long __nocfi hk_follow_stub(unsigned long addr)
+{
+	int i;
+
+	for (i = 0; i < HK_STUB_FOLLOW; i++) {
+		u32 insn = hk_read_insn(addr);
+		long disp;
+
+		if (!insn)
+			return 0;
+		if (hk_insn_is_bti(insn)) {
+			addr += 4;
+			continue;
+		}
+		/* a bare branch at the entry is the stub the cfi build leaves behind */
+		if ((insn & 0xFC000000) != 0x14000000)
+			return addr;
+		disp = (long)(insn & 0x03FFFFFF) << 2;
+		if (disp & (1L << 27))
+			disp |= ~((1L << 28) - 1);
+		addr += disp;
+	}
+	return 0;
+}
+
+static unsigned long __nocfi hk_resolve_cfi(const char *name)
+{
+	unsigned long addr = 0;
+
+	/* asking hk_resolve here would ask this function again */
+	if (g_cfg.resolve && !g_exiting)
+		addr = g_cfg.resolve(name);
+	if (!addr || !hk_ker_addr_ok(addr))
+		return 0;
+	return hk_follow_stub(addr);
+}
+
+__nocfi noinline unsigned long hk_resolve(const char *name)
+{
+	unsigned long addr;
+
+	if (!name)
+		return 0;
+	if (g_cfg.resolve && !g_exiting) {
+		addr = g_cfg.resolve(name);
+		if (addr && hk_ker_addr_ok(addr))
+			return addr;
+	}
+	addr = hk_resolve_cfi(name);
+	if (addr && hk_ker_addr_ok(addr))
+		return addr;
+	return 0;
+}
+
+/* a compiler writes at most a bti and a pac prologue, so four words cover every
+ * entry; an entry whose first four words are all pads has no body behind them */
+#define HK_PAD_MAX 4
+
+int hk_kprobe_adjust_pad(unsigned long addr, void *arg, unsigned long *out)
+{
+	unsigned int i;
+
+	(void)arg;
+	if (!addr || !out)
+		return -EINVAL;
+	for (i = 0; i < HK_PAD_MAX; i++) {
+		u32 insn;
+
+		if (copy_from_kernel_nofault(&insn, (const void *)addr,
+					     sizeof(insn)))
+			return -EFAULT;
+		if (!hk_insn_is_pad(insn))
+			break;
+		addr += 4;
+	}
+	if (i == HK_PAD_MAX)
+		return -EOPNOTSUPP;
+	*out = addr;
+	return 0;
+}
+
+int hk_init(const struct hk_cfg *cfg)
+{
+	if (!cfg || !cfg->resolve)
+		return -EINVAL;
+	if (g_cfg.resolve && !g_exiting)
+		return -EALREADY;
+
+	g_cfg = *cfg;
+	g_exiting = false;
+	hk_patch_set_write(cfg->write);
+	/*
+	 * resolve the write path symbols here and not on first use: a lazy resolve
+	 * inside stop_machine would walk kallsyms from an atomic context
+	 */
+	hk_patch_init();
+	pr_info("[lkmhook] init\n");
+	return 0;
+}
+
+typedef void (*hk_synchronize_rcu_tasks_fn)(void);
+
+/*
+ * __nocfi on the body, not decoration: the symbol is resolved at runtime and the
+ * call is indirect, and the cfi typeid the compiler would check it against is not
+ * the one the kernel recorded. 5.10 panics on it, the target named in the message
+ */
+__nocfi /*
+ * the default notice is a warning, the level this library uses for a condition it
+ * refused and carried on from: the mistake belongs to the caller of the hook, not
+ * to the kernel, and a caller that wants it louder escalates in its own sink
+ */
+static void hk_notice_print(enum hk_notice what, const char *detail)
+{
+	static const char *const names[] = {
+		"free before disable",
+		"relo table",
+	};
+
+	pr_warn("[lkmhook] %s: %s\n",
+	       what < ARRAY_SIZE(names) ? names[what] : "notice",
+	       detail ? detail : "");
+}
+
+static hk_notify_fn g_notify = hk_notice_print;
+
+void hk_notice_set(hk_notify_fn fn)
+{
+	WRITE_ONCE(g_notify, fn);
+}
+
+void __nocfi hk_notice(enum hk_notice what, const char *detail)
+{
+	hk_notify_fn fn = READ_ONCE(g_notify);
+
+	if (fn)
+		fn(what, detail);
+}
+
+/*
+ * the call inside is indirect and cfi is off for it, and noinline is the other
+ * half of that: an inline would move the call into whatever caller lto picked, and
+ * the check __nocfi turned off would come back with it
+ */
+__nocfi noinline void hk_wait_tasks_rcu(void)
+{
+	hk_synchronize_rcu_tasks_fn fn;
+	unsigned long sym = hk_resolve("synchronize_rcu_tasks");
+
+	if (!sym || !hk_ker_addr_ok(sym)) {
+		pr_warn_once("[lkmhook] synchronize_rcu_tasks not found, "
+			     "a freed trampoline may still be running\n");
+		return;
+	}
+	fn = (hk_synchronize_rcu_tasks_fn)sym;
+	fn();
+}
+
+void hk_exit(void)
+{
+	/*
+	 * called by hk_exit_block in a loop, so a restore that failed is retried.
+	 * the flag keeps the injected resolver out of the retry, a consumer that
+	 * tears its resolver down before hk_exit_block would otherwise resolve
+	 * through a freed pointer, and it is what makes a clean shutdown
+	 * initialize again instead of -EALREADY
+	 */
+	g_exiting = true;
+	hk_sighook_exit();
+	hk_kprobe_exit();
+	hk_kretprobe_exit();
+	hk_ptr_exit();
+	hk_inline_exit();
+	pr_info("[lkmhook] exit\n");
+}
+
+/*
+ * rmmod unmaps module text and data as soon as the exit path returns, and the
+ * entry of a hook that could not be restored still branches into the trampoline
+ * allocated here. the module ends its exit path through this instead of
+ * returning to its caller while a hook is still live: the detour keeps its
+ * bytes, so the kernel stays correct, and the rmmod request is the only thing
+ * that is refused. it never returns
+ */
+void hk_exit_block(void)
+{
+	unsigned int left;
+
+	for (;;) {
+		/*
+		 * the calls inside a replacement are counted here too: their code is
+		 * this module's, and the reference they hold is what keeps the kernel
+		 * from unmapping it, so a clean exit waits for them as well
+		 */
+		left = hk_inline_pending() + hk_ptr_pending() +
+		       hk_kprobe_pending() + hk_kretprobe_pending() +
+		       hk_redir_pending() + hk_redir_inflight();
+		if (!left)
+			break;
+		pr_warn("[lkmhook] exit blocked, %u hook(s) still live\n", left);
+		ssleep(60);
+		hk_inline_exit();
+		hk_ptr_exit();
+		hk_kretprobe_exit();
+	}
+	pr_info("[lkmhook] exit clean\n");
+	g_exiting = false;
+}
diff --git a/KernelSU/kernel/susfs/HooKern/hk.h b/KernelSU/kernel/susfs/HooKern/hk.h
new file mode 100644
index 000000000000..ef3ef9369d08
--- /dev/null
+++ b/KernelSU/kernel/susfs/HooKern/hk.h
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#ifndef LKMHOOK_HK_H
+#define LKMHOOK_HK_H
+
+#include <linux/types.h>
+
+struct hk_cfg {
+	unsigned long (*resolve)(const char *name);
+	/*
+	 * how the library writes text when a caller does not name a path itself,
+	 * one of the hk_write_* primitives of hk_patch.h. NULL takes the kernel's
+	 * own primitive, which assumes nothing about the headers this module was
+	 * built with. the value is read once, in hk_init
+	 */
+	int (*write)(void *dst, const void *src, size_t len);
+};
+
+static inline bool hk_ker_addr_ok(unsigned long v)
+{
+	return v >= 0xffff000000000000UL;
+}
+
+/*
+ * a probe replaces the word it lands on with brk, and an entry that an indirect
+ * branch reaches starts with a landing pad, so the breakpoint takes the pad away
+ * and the caller traps before the probe runs. the pac prologue is a landing pad
+ * too, and behind it the link register is signed, which is the other half of the
+ * same problem. arm64 leaves arch_adjust_kprobe_addr weak, so the placement stays
+ * with the caller: a handle that names one of these runs it once at install time,
+ * and NULL keeps the plain address the kernel would have used
+ */
+typedef int (*hk_probe_adjust_fn)(unsigned long addr, void *arg,
+				  unsigned long *out);
+
+/* the kernel's own predicate from 6.6 on, spelled here because 5.10 has no macro */
+static inline bool hk_insn_is_bti(u32 insn)
+{
+	return (insn & 0xFFFFFF3Fu) == 0xD503241Fu;
+}
+
+/* the hint words an entry can start with that an indirect branch may target:
+ * the bti family and the two pac prologues, which act as the pad when the
+ * compiler writes one instead of a bti. bti r only answers a return, and is
+ * skipped with the rest because leaving a hint behind costs nothing */
+static inline bool hk_insn_is_pad(u32 insn)
+{
+	return hk_insn_is_bti(insn) || insn == 0xD503233Fu ||
+	       insn == 0xD503237Fu;
+}
+
+/*
+ * behind a pac prologue the link register is signed, so a handler that parks the
+ * pc or hands the call on has to strip it first or the cpu gets an address no
+ * branch can take. the strip is a hint, a no op on a cpu without pac, and an
+ * address that was never signed comes back unchanged
+ */
+static inline unsigned long hk_pac_strip(unsigned long v)
+{
+	register unsigned long lr asm("x30") = v;
+
+	asm("hint #7" : "+r"(lr));
+	return lr;
+}
+
+/* the kprobe preset: skip the pads and stop on the body word, which is before the
+ * frame is set up, so a handler that returns early leaves nothing to unwind. an
+ * entry without a pad lands as it came, and a run of four pads is refused */
+int hk_kprobe_adjust_pad(unsigned long addr, void *arg, unsigned long *out);
+
+int hk_init(const struct hk_cfg *cfg);
+void hk_exit(void);
+unsigned long hk_resolve(const char *name);
+
+/*
+ * the consumers run their own exit, the library only counts the failures it was
+ * told about and keeps the numbers for the next hk_exit. a module whose exit
+ * path left kernel text pointing into module memory must not unload, so it calls
+ * hk_exit_block at the end of its own exit and never returns
+ */
+void hk_exit_fail(int count);
+unsigned int hk_exit_failed(void);
+void hk_exit_block(void);
+
+/*
+ * the library refuses something and carries on, and says so here. a refused free
+ * of a live hook and an emitter that disagrees with the length table both leave the
+ * hook or the install in a state the caller wanted, so a caller that wants to count
+ * them, log them its own way or trip an assertion of its own installs a notice
+ * function. the default notice prints, which is the report a plain build has, and
+ * hk_notice_set(NULL) silences it for a build that trusts itself
+ */
+enum hk_notice {
+	HK_NOTICE_FREE_BEFORE_DISABLE = 0,	/* a free on a hook that is still live */
+	HK_NOTICE_RELO_TABLE,			/* an emitter and the length table disagree */
+};
+
+typedef void (*hk_notify_fn)(enum hk_notice what, const char *detail);
+
+/* called where the refusal happens: process context, and it must not sleep */
+void hk_notice_set(hk_notify_fn fn);
+void hk_notice(enum hk_notice what, const char *detail);
+
+/*
+ * one tasks rcu grace period: what has to pass between the moment code of this
+ * module is taken out of a path another core could be running and the moment it is
+ * freed. it is the flavour the kernel uses for its own text pokes, the symbol is
+ * resolved here, and a kernel without it says so once instead of waiting for
+ * nothing. the call inside is indirect and cfi is off for it, a direct call from a
+ * consumer needs nothing
+ */
+void hk_wait_tasks_rcu(void);
+#endif
diff --git a/KernelSU/kernel/susfs/HooKern/hk_binder.c b/KernelSU/kernel/susfs/HooKern/hk_binder.c
new file mode 100644
index 000000000000..b3c35a839fed
--- /dev/null
+++ b/KernelSU/kernel/susfs/HooKern/hk_binder.c
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <uapi/linux/android/binder.h>
+
+#include "hk.h"
+#include "hk_binder.h"
+#include "hk_cfi.h"
+#include "hk_inline.h"
+
+long __nocfi hk_binder_ioctl_wrap(struct file *filp, unsigned int cmd,
+				  unsigned long arg);
+unsigned long __nocfi hk_binder_copy_wrap(void *alloc, void *buffer,
+					  unsigned long buffer_offset,
+					  const void __user *from,
+					  size_t bytes);
+void __nocfi hk_binder_transaction_wrap(void *proc, void *thread,
+					struct binder_transaction_data *tr,
+					int reply,
+					unsigned long extra_buffers_size);
+
+typedef long (*binder_ioctl_fn)(struct file *filp, unsigned int cmd,
+				unsigned long arg);
+typedef unsigned long (*binder_copy_fn)(void *alloc, void *buffer,
+					unsigned long buffer_offset,
+					const void __user *from, size_t bytes);
+typedef void (*binder_transaction_fn)(void *proc, void *thread,
+				      struct binder_transaction_data *tr,
+				      int reply,
+				      unsigned long extra_buffers_size);
+
+struct hk_binder_state {
+	const struct hk_binder_callbacks *cb;
+	struct hk_inline ioctl;
+	struct hk_inline copy;
+	struct hk_inline transaction;
+	binder_ioctl_fn orig_ioctl;
+	binder_copy_fn orig_copy;
+	binder_transaction_fn orig_transaction;
+	atomic_t active;
+	wait_queue_head_t idle_wq;
+	bool draining;
+	bool inited;
+};
+
+static struct hk_binder_state g_binder;
+
+static void hk_binder_enter(void)
+{
+	atomic_inc(&g_binder.active);
+}
+
+static void hk_binder_leave(void)
+{
+	if (atomic_dec_and_test(&g_binder.active))
+		wake_up_all(&g_binder.idle_wq);
+}
+
+static void hk_binder_wait_idle(void)
+{
+	while (atomic_read(&g_binder.active) > 0)
+		wait_event_timeout(g_binder.idle_wq,
+				   atomic_read(&g_binder.active) == 0,
+				   msecs_to_jiffies(1000));
+}
+
+typedef void (*hk_synchronize_rcu_tasks_fn)(void);
+
+static __nocfi void hk_binder_synchronize_rcu_tasks(void)
+{
+	hk_synchronize_rcu_tasks_fn fn;
+
+	fn = (hk_synchronize_rcu_tasks_fn)hk_resolve("synchronize_rcu_tasks");
+	if (fn && hk_ker_addr_ok((unsigned long)fn))
+		fn();
+}
+
+struct hk_cfi_search {
+	const char *name;
+	size_t len;
+	unsigned long addr;
+};
+
+long __nocfi hk_binder_ioctl_wrap(struct file *filp, unsigned int cmd,
+				  unsigned long arg)
+{
+	long ret;
+
+	hk_binder_enter();
+
+	if (!READ_ONCE(g_binder.draining) && g_binder.cb &&
+	    g_binder.cb->ioctl)
+		g_binder.cb->ioctl(g_binder.cb->priv, filp, cmd, arg);
+
+	if (g_binder.orig_ioctl)
+		ret = g_binder.orig_ioctl(filp, cmd, arg);
+	else
+		ret = -ENOSYS;
+
+	hk_binder_leave();
+	return ret;
+}
+
+unsigned long __nocfi hk_binder_copy_wrap(void *alloc, void *buffer,
+					  unsigned long buffer_offset,
+					  const void __user *from,
+					  size_t bytes)
+{
+	unsigned long ret;
+
+	hk_binder_enter();
+
+	if (!READ_ONCE(g_binder.draining) && g_binder.cb &&
+	    g_binder.cb->copy_from_user)
+		g_binder.cb->copy_from_user(g_binder.cb->priv, alloc, buffer,
+					    buffer_offset, from, bytes);
+
+	if (g_binder.orig_copy)
+		ret = g_binder.orig_copy(alloc, buffer, buffer_offset, from,
+					 bytes);
+	else
+		ret = bytes;
+
+	hk_binder_leave();
+	return ret;
+}
+
+void __nocfi hk_binder_transaction_wrap(void *proc, void *thread,
+					struct binder_transaction_data *tr,
+					int reply,
+					unsigned long extra_buffers_size)
+{
+	struct hk_binder_transaction_event ev = { 0 };
+	size_t len = 0;
+	bool trace;
+
+	hk_binder_enter();
+
+	trace = !READ_ONCE(g_binder.draining) && g_binder.cb &&
+		g_binder.cb->transaction;
+
+	if (trace) {
+		if (tr) {
+			ev.code = tr->code;
+			ev.flags = tr->flags;
+			ev.data_size = tr->data_size;
+			ev.offsets_size = tr->offsets_size;
+			ev.target_handle = tr->target.handle;
+			ev.sender_pid = tr->sender_pid;
+			ev.sender_euid = tr->sender_euid;
+
+			if (tr->data_size && tr->data.ptr.buffer) {
+				len = min_t(size_t, tr->data_size,
+					    HK_BINDER_MAX_PAYLOAD);
+				if (copy_from_user(ev.payload,
+						   (const void __user *)(uintptr_t)tr->data.ptr.buffer,
+						   len)) {
+					memset(ev.payload, 0,
+					       sizeof(ev.payload));
+					len = 0;
+					ev.payload_truncated = true;
+				} else {
+					ev.payload_truncated =
+						tr->data_size >
+						HK_BINDER_MAX_PAYLOAD;
+				}
+			}
+		}
+		ev.payload_len = len;
+		g_binder.cb->transaction(g_binder.cb->priv, &ev);
+	}
+
+	if (g_binder.orig_transaction)
+		g_binder.orig_transaction(proc, thread, tr, reply,
+					  extra_buffers_size);
+
+	hk_binder_leave();
+}
+
+static int hk_binder_install(struct hk_inline *h, const char *sym,
+			     const char *wrap, unsigned long *orig)
+{
+	unsigned long addr;
+	int ret;
+
+	addr = hk_resolve(sym);
+	if (!addr)
+		return -ENOENT;
+
+	ret = hk_inline_hook(h, sym, wrap);
+	if (ret)
+		return ret;
+
+	*orig = h->orig;
+	return 0;
+}
+
+int hk_binder_init(const struct hk_binder_callbacks *cb)
+{
+	int ret;
+
+	if (!cb)
+		return -EINVAL;
+
+	memset(&g_binder, 0, sizeof(g_binder));
+	g_binder.cb = cb;
+	atomic_set(&g_binder.active, 0);
+	init_waitqueue_head(&g_binder.idle_wq);
+	hk_cfi_bypass();
+
+	ret = hk_binder_install(&g_binder.ioctl, "binder_ioctl",
+				"hk_binder_ioctl_wrap",
+				(unsigned long *)&g_binder.orig_ioctl);
+	if (ret)
+		goto err;
+
+	ret = hk_binder_install(&g_binder.copy,
+				"binder_alloc_copy_user_to_buffer",
+				"hk_binder_copy_wrap",
+				(unsigned long *)&g_binder.orig_copy);
+	if (ret)
+		goto err_ioctl;
+
+	ret = hk_binder_install(&g_binder.transaction, "binder_transaction",
+				"hk_binder_transaction_wrap",
+				(unsigned long *)&g_binder.orig_transaction);
+	if (ret == -ENOENT) {
+		ret = 0;
+	} else if (ret) {
+		goto err_copy;
+	}
+
+	g_binder.inited = true;
+	pr_info("[lkmhook] binder trace init\n");
+	return 0;
+
+err_copy:
+	hk_inline_unhook(&g_binder.copy);
+err_ioctl:
+	hk_inline_unhook(&g_binder.ioctl);
+err:
+	memset(&g_binder, 0, sizeof(g_binder));
+	pr_warn("[lkmhook] binder trace init failed %d\n", ret);
+	return ret;
+}
+
+void hk_binder_exit(void)
+{
+	if (!g_binder.inited)
+		return;
+
+	WRITE_ONCE(g_binder.draining, true);
+	hk_inline_disable(&g_binder.transaction);
+	hk_inline_disable(&g_binder.copy);
+	hk_inline_disable(&g_binder.ioctl);
+	hk_binder_synchronize_rcu_tasks();
+	hk_binder_wait_idle();
+	hk_inline_free(&g_binder.transaction);
+	hk_inline_free(&g_binder.copy);
+	hk_inline_free(&g_binder.ioctl);
+
+	memset(&g_binder, 0, sizeof(g_binder));
+	pr_info("[lkmhook] binder trace exit\n");
+}
diff --git a/KernelSU/kernel/susfs/HooKern/hk_binder.h b/KernelSU/kernel/susfs/HooKern/hk_binder.h
