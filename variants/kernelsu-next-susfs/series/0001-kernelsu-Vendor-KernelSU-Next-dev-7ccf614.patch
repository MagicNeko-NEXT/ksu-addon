diff --git a/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.c b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.c
new file mode 100644
index 000000000000..a4efeb6678c1
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.c
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * raana.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "raana.h"
+#include "../core.h"
+#include "../access.h"
+#include "../ks_dbg.h"
+#include "../hint.h"
+
+int kr_raana_discover(void)
+{
+	struct raana_ctx ctx;
+	const struct kallrecon_hint *h = kr_hint();
+	unsigned long ti = 0;
+	int i;
+
+#if defined(CONFIG_X86_64) && defined(CONFIG_KALLSYMS_ABSOLUTE_PERCPU)
+	/* pre 6.18 x86 stores rb - 1 - addr descending
+	 * the forward run machine cannot see it */
+	return 0;
+#endif
+
+	memset(&ctx, 0, sizeof(ctx));
+	spin_lock_init(&ctx.lock);
+	ctx.start = sprint_addr & ~KS_PAGE_MASK;
+	ctx.end = ctx.start + RAANA_TOKEN_RANGE;
+	ctx.nchunks = (int)((RAANA_TOKEN_RANGE + KS_WIN_SIZE - 1) /
+			    KS_WIN_SIZE);
+	ctx.sback = h->scan_back ? h->scan_back : KS_SCAN_BACK;
+	ctx.sfwd = h->scan_fwd ? h->scan_fwd : KS_SCAN_FWD;
+#ifdef KALLRECON_FIRST_HIT
+	ctx.first_hit = 1;
+#endif
+#ifdef KALLRECON_SCAN_RANGE
+	ctx.rlo = h->scan.lo;
+	ctx.rhi = h->scan.hi;
+	if (ctx.rlo && ctx.rhi > ctx.rlo)
+		ctx.range_active = 1;
+#endif
+	if (ctx.range_active) {
+		unsigned long lo = ctx.rlo > ctx.start ? ctx.rlo : ctx.start;
+		unsigned long hi = ctx.rhi < ctx.end ? ctx.rhi : ctx.end;
+
+		if (hi > lo) {
+			ctx.pri_idx = (int)((lo - ctx.start) / KS_WIN_SIZE);
+			ctx.pri_cnt = (int)((hi - 1 - ctx.start) /
+					    KS_WIN_SIZE) - ctx.pri_idx + 1;
+		} else {
+			ctx.range_active = 0;
+		}
+	}
+
+	if (h->token_index) {
+		unsigned short tibuf[256];
+
+		if (safe_read(tibuf, (void *)h->token_index, sizeof(tibuf)) ||
+		    !kr_check_ti_strong(tibuf)) {
+			kr_fail_set(KALLRECON_HINT_INVALID);
+			return 0;
+		}
+		ti = h->token_index;
+	} else {
+		if (!raana_run(&ctx) || !ctx.nti) {
+			kr_fail_set(KALLRECON_NO_TOKEN_INDEX);
+			return 0;
+		}
+		ti = ctx.ti_hits[0];
+		for (i = 1; i < ctx.nti; i++)
+			if (ctx.ti_hits[i] < ti)
+				ti = ctx.ti_hits[i];
+	}
+	ks_dbg("[raana] ti=0x%lx\n", ti);
+
+	if (!kr_setup_token_table(ti))
+		return 0;
+
+	if (h->offsets) {
+		unsigned long best_cand = 0;
+		int best_len = 0;
+
+		if (!kr_hint_commit_offsets(h, &best_cand, &best_len))
+			return 0;
+	} else {
+		raana_offsets_phase(&ctx, ti, kltable_addr);
+	}
+	if (!kloffs_addr)
+		return 0;
+
+	kr_layout_from_offsets(ti);
+	ks_dbg("[raana] offsets=0x%lx len=%u\n", kloffs_addr, klnum_val);
+	return 1;
+}
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.h b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.h
new file mode 100644
index 000000000000..48d83f595abd
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * raana.h
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#ifndef RAANA_H
+#define RAANA_H
+
+#include <linux/types.h>
+#include <linux/spinlock.h>
+#include <linux/completion.h>
+
+#include "../slide.h"
+#include "../discover.h"
+
+#define RAANA_MAX_WORKERS	8
+#define RAANA_TOKEN_RANGE	(32UL * 1024 * 1024)
+#define RAANA_MAX_TI		4
+#define RAANA_CROSS_PAD		0x1000
+
+struct raana_ctx {
+	unsigned long start;
+	unsigned long end;
+	int next;
+	int stop;
+	unsigned long ceil;	/* chunks starting above the lowest verified hit are skipped */
+	spinlock_t lock;
+	unsigned long ti_hits[RAANA_MAX_TI];
+	int nti;
+	unsigned long hit_cand;
+	int hit_len;
+	int hit_ok;
+	int pri_idx;
+	int pri_cnt;
+	int nchunks;
+	unsigned long rlo;
+	unsigned long rhi;
+	unsigned long sback;
+	unsigned long sfwd;
+	int range_active;
+	int first_hit;
+};
+
+struct raana_worker {
+	struct raana_ctx *ctx;
+	int id;
+	struct completion done;
+};
+
+struct kallrecon_hint;
+
+/* verifiers owned by discover.c */
+int kr_check_ti_strong(unsigned short *ti);
+int kr_commit_offsets(unsigned long cand, int len,
+		      unsigned long *best_cand, int *best_len);
+int kr_commit_selfrel(unsigned long cand, int len,
+		      unsigned long *best_cand, int *best_len);
+int kr_hint_commit_offsets(const struct kallrecon_hint *h,
+			   unsigned long *best_cand, int *best_len);
+
+/* executor battery */
+int raana_run(struct raana_ctx *ctx);
+
+int raana_token_worker(struct raana_worker *wk);
+void raana_offsets_phase(struct raana_ctx *ctx, unsigned long ti,
+			 unsigned long kltable);
+int kr_raana_discover(void);
+
+#endif
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_multi.c b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_multi.c
new file mode 100644
index 000000000000..2f5a9a25fe44
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_multi.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * raana_run_multi.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/kthread.h>
+#include <linux/slab.h>
+#include <linux/cpumask.h>
+
+#include "raana.h"
+
+static int raana_worker_thread(void *data)
+{
+	struct raana_worker *wk = data;
+
+	raana_token_worker(wk);
+	complete(&wk->done);
+	return 0;
+}
+
+int raana_run(struct raana_ctx *ctx)
+{
+	struct raana_worker *wks;
+	struct task_struct *tsk;
+	int n, i, started;
+
+	n = num_online_cpus();
+	if (n > RAANA_MAX_WORKERS)
+		n = RAANA_MAX_WORKERS;
+	if (n < 1)
+		n = 1;
+
+	wks = kcalloc(n, sizeof(*wks), GFP_KERNEL);
+	if (!wks)
+		return 0;
+
+	for (i = 0; i < n; i++) {
+		wks[i].ctx = ctx;
+		wks[i].id = i;
+		init_completion(&wks[i].done);
+	}
+
+	started = 0;
+	for (i = 0; i < n; i++) {
+		tsk = kthread_run(raana_worker_thread, &wks[i], "raana%d", i);
+		if (IS_ERR(tsk))
+			break;
+		started++;
+	}
+
+	if (!started)
+		raana_token_worker(&wks[0]);
+	for (i = 0; i < started; i++)
+		wait_for_completion(&wks[i].done);
+
+	kfree(wks);
+	return ctx->nti != 0;
+}
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_single.c b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_single.c
new file mode 100644
index 000000000000..ff9e393126ec
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_run_single.c
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * raana_run_single.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include "raana.h"
+
+int raana_run(struct raana_ctx *ctx)
+{
+	struct raana_worker wk = {
+		.ctx = ctx,
+	};
+
+	raana_token_worker(&wk);
+	return ctx->nti != 0;
+}
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_task.c b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_task.c
new file mode 100644
index 000000000000..ebbe6986fed0
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/raana/raana_task.c
@@ -0,0 +1,550 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * raana_task.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <asm/page.h>
+
+#include "raana.h"
+#include "../core.h"
+#include "../ks_dbg.h"
+#include "../hint.h"
+
+static inline u64 raana_zero16(u64 w)
+{
+	return (w - 0x0001000100010001ULL) &
+		~(w | 0x7FFF7FFF7FFF7FFFULL) & 0x8000800080008000ULL;
+}
+
+static inline u64 raana_zero32(u64 w)
+{
+	return (w - 0x0000000100000001ULL) &
+		~(w | 0x7FFFFFFF7FFFFFFFULL) & 0x8000000080000000ULL;
+}
+
+struct raana_run {
+	int active;
+	int len;
+	int prev;
+	unsigned long cand;
+	unsigned long prev_addr;
+};
+
+static void raana_ti_record(struct raana_ctx *ctx, unsigned long addr)
+{
+	spin_lock(&ctx->lock);
+	if (ctx->nti < RAANA_MAX_TI)
+		ctx->ti_hits[ctx->nti++] = addr;
+	if (!ctx->ceil || addr < ctx->ceil)
+		ctx->ceil = addr;
+	spin_unlock(&ctx->lock);
+}
+
+static void raana_stop_set(struct raana_ctx *ctx)
+{
+	spin_lock(&ctx->lock);
+	ctx->stop = 1;
+	spin_unlock(&ctx->lock);
+}
+
+/* probe one word per page a page is fully readable once its first
+ * word reads back returns the first unreadable page start */
+static unsigned long raana_probe(unsigned long addr, unsigned long end)
+{
+	unsigned char tmp[8];
+	unsigned long pos = addr;
+	unsigned int n = 0;
+
+	while (pos < end) {
+		if (safe_read(tmp, (void *)pos, sizeof(tmp)))
+			break;
+		if (((++n) & 0xFF) == 0 && kr_timeout_hit())
+			break;
+		pos += PAGE_SIZE;
+	}
+	return pos;
+}
+
+static int raana_ti_cand(struct raana_ctx *ctx, unsigned long base,
+			 u64 z, unsigned long scan_end,
+			 unsigned long readable)
+{
+	while (z) {
+		unsigned long o = base + (__builtin_ctzll(z) >> 3) - 1;
+
+		z &= z - 1;
+		if (o + 4 > scan_end)
+			continue;
+		if (*(unsigned short *)(o + 2) == 0)
+			continue;
+		if (o + 512 > readable)
+			continue;
+		if (kr_check_ti_strong((unsigned short *)o)) {
+			raana_ti_record(ctx, o);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int raana_token_window(struct raana_ctx *ctx, unsigned long addr)
+{
+	unsigned long chunk_end = addr + KS_WIN_SIZE;
+	unsigned long readable = raana_probe(addr, chunk_end + PAGE_SIZE);
+	unsigned long scan_end = readable < chunk_end ? readable : chunk_end;
+	unsigned long pos = addr;
+
+	while (pos + 16 <= scan_end) {
+		u64 z0 = raana_zero16(
+			*(const u64 *)pos);
+		u64 z1 = raana_zero16(
+			*(const u64 *)(pos + 8));
+
+		if (raana_ti_cand(ctx, pos, z0, scan_end, readable) ||
+		    raana_ti_cand(ctx, pos + 8, z1, scan_end, readable))
+			return 1;
+		pos += 16;
+	}
+	while (pos + 8 <= scan_end) {
+		u64 z = raana_zero16(
+			*(const u64 *)pos);
+
+		if (raana_ti_cand(ctx, pos, z, scan_end, readable))
+			return 1;
+		pos += 8;
+	}
+	while (pos + 4 <= scan_end) {
+		if (*(unsigned short *)pos == 0 &&
+		    *(unsigned short *)(pos + 2) != 0 &&
+		    pos + 512 <= readable &&
+		    kr_check_ti_strong((unsigned short *)pos)) {
+			raana_ti_record(ctx, pos);
+			return 1;
+		}
+		pos += 2;
+	}
+	return 0;
+}
+
+static unsigned long raana_chunk_addr(struct raana_ctx *ctx, int idx)
+{
+	int pri = ctx->pri_cnt;
+
+	if (idx < pri)
+		return ctx->start + (unsigned long)(ctx->pri_idx + idx) *
+			KS_WIN_SIZE;
+	idx -= pri;
+	if (idx < ctx->pri_idx)
+		return ctx->start + (unsigned long)idx * KS_WIN_SIZE;
+	idx -= ctx->pri_idx;
+	return ctx->start + (unsigned long)(ctx->pri_idx + pri + idx) *
+		KS_WIN_SIZE;
+}
+
+int raana_token_worker(struct raana_worker *wk)
+{
+	struct raana_ctx *ctx = wk->ctx;
+
+	for (;;) {
+		unsigned long addr, ceil;
+		int idx, stop;
+
+		spin_lock(&ctx->lock);
+		idx = ctx->next++;
+		stop = ctx->stop;
+		ceil = ctx->ceil;
+		spin_unlock(&ctx->lock);
+		if (stop)
+			break;
+		if (idx >= ctx->nchunks)
+			break;
+		addr = raana_chunk_addr(ctx, idx);
+		if (ceil && addr > ceil)
+			continue;
+		if (raana_token_window(ctx, addr))
+			continue;
+		if (kr_timeout_hit()) {
+			raana_stop_set(ctx);
+			break;
+		}
+	}
+	return 0;
+}
+
+/* find the next zero dword at or after *pos advances *pos when idle
+ * returns 1 on a hit 0 at the end and -1 on timeout */
+static int raana_r2_idle(unsigned long *pos, unsigned long scan_end,
+			 unsigned long *out)
+{
+	unsigned long p = *pos;
+	unsigned int n = 0;
+
+	while (p + 16 <= scan_end) {
+		u64 z0 = raana_zero32(
+			*(const u64 *)p);
+		u64 z1 = raana_zero32(
+			*(const u64 *)(p + 8));
+
+		while (z0) {
+			unsigned long o = p + (__builtin_ctzll(z0) >> 3) - 3;
+
+			z0 &= z0 - 1;
+			if (*(unsigned int *)o == 0) {
+				*out = o;
+				return 1;
+			}
+		}
+		while (z1) {
+			unsigned long o = p + 8 +
+				(__builtin_ctzll(z1) >> 3) - 3;
+
+			z1 &= z1 - 1;
+			if (*(unsigned int *)o == 0) {
+				*out = o;
+				return 1;
+			}
+		}
+		p += 16;
+		if (((++n) & 0x3FF) == 0 && kr_timeout_hit())
+			return -1;
+	}
+	while (p + 8 <= scan_end) {
+		u64 z = raana_zero32(
+			*(const u64 *)p);
+
+		while (z) {
+			unsigned long o = p + (__builtin_ctzll(z) >> 3) - 3;
+
+			z &= z - 1;
+			if (*(unsigned int *)o == 0) {
+				*out = o;
+				return 1;
+			}
+		}
+		p += 8;
+	}
+	if (p + 4 <= scan_end && *(unsigned int *)p == 0) {
+		*out = p;
+		return 1;
+	}
+	*pos = p;
+	return 0;
+}
+
+static int raana_r2_close(struct raana_run *r, unsigned long *best_cand,
+			  int *best_len, unsigned long *hc, int *hl)
+{
+	int len = r->len;
+	int ok = 0;
+
+	if (len >= KS_RUN_MIN && len > *best_len) {
+		int use = len;
+
+		if (r->prev != 0 && (r->prev & KS_2M_MASK) == 0)
+			use--;
+		if (kr_commit_offsets(r->cand, use, best_cand, best_len)) {
+			*hc = r->cand;
+			*hl = *best_len;
+			ok = 1;
+		}
+	}
+	r->active = 0;
+	return ok;
+}
+
+static int raana_r2_scan(struct raana_ctx *ctx, unsigned long start,
+			 unsigned long end, int *stop, unsigned long confirm,
+			 int clen);
+static int raana_r3_scan(struct raana_ctx *ctx, unsigned long start,
+			 unsigned long end, int *stop, unsigned long confirm,
+			 int clen);
+
+/* second independent derivation of a verified candidate over its own
+ * span the same run machine must close the same run again */
+static int raana_confirm(struct raana_ctx *ctx, unsigned long cand, int len,
+			 int selfrel)
+{
+	unsigned long start = (cand - RAANA_CROSS_PAD) & ~KS_PAGE_MASK;
+	unsigned long end = cand + (unsigned long)len * 4 + RAANA_CROSS_PAD;
+	int stop = 0;
+
+	if (selfrel)
+		return raana_r3_scan(ctx, start, end, &stop, cand, len);
+	return raana_r2_scan(ctx, start, end, &stop, cand, len);
+}
+
+static int raana_hit_stop(struct raana_ctx *ctx, unsigned long hc, int hl,
+			  int selfrel)
+{
+	ctx->hit_cand = hc;
+	ctx->hit_len = hl;
+	if (ctx->first_hit || !ctx->range_active) {
+		ctx->hit_ok = 1;
+		return 1;
+	}
+	if (raana_confirm(ctx, hc, hl, selfrel)) {
+		ctx->hit_ok = 1;
+		return 1;
+	}
+	ks_dbg("[raana] confirm miss 0x%lx len=%d\n", hc, hl);
+	return 0;
+}
+
+static int raana_r2_scan(struct raana_ctx *ctx, unsigned long start,
+			 unsigned long end, int *stop, unsigned long confirm,
+			 int clen)
+{
+	struct raana_run r = {0};
+	unsigned long best_cand = 0;
+	int best_len = 0;
+	unsigned long readable, scan_end, pos, o;
+	unsigned int m = 0;
+
+	start &= ~KS_PAGE_MASK;
+	if (!confirm)
+		end = (end + KS_PAGE_MASK) & ~KS_PAGE_MASK;
+	readable = raana_probe(start, end + PAGE_SIZE);
+	if (kr_timeout_hit()) {
+		*stop = 1;
+		return 0;
+	}
+	scan_end = readable < end ? readable : end;
+	pos = start;
+
+	while (pos + 4 <= scan_end) {
+		unsigned int v;
+
+		if (((++m) & 0x3FF) == 0 && kr_timeout_hit()) {
+			*stop = 1;
+			return 0;
+		}
+		if (!r.active) {
+			int rc = raana_r2_idle(&pos, scan_end, &o);
+
+			if (rc < 0) {
+				*stop = 1;
+				return 0;
+			}
+			if (!rc)
+				break;
+			r.active = 1;
+			r.cand = o;
+			r.prev = 0;
+			r.len = 1;
+			r.prev_addr = o;
+			pos = o + 4;
+			continue;
+		}
+		v = *(unsigned int *)pos;
+		if ((int)v < r.prev) {
+			unsigned long hc;
+			int hl;
+
+			if (raana_r2_close(&r, &best_cand, &best_len, &hc, &hl)) {
+				if (confirm) {
+					if (hc == confirm && hl - clen <= 1 &&
+					    clen - hl <= 1)
+						return 1;
+				} else if (raana_hit_stop(ctx, hc, hl, 0)) {
+					*stop = 1;
+					return 1;
+				}
+			}
+			if (v == 0) {
+				r.active = 1;
+				r.cand = pos;
+				r.prev = 0;
+				r.len = 1;
+				r.prev_addr = pos;
+			}
+		} else {
+			r.prev = (int)v;
+			r.len++;
+			r.prev_addr = pos;
+		}
+		pos += 4;
+	}
+
+	if (r.active) {
+		unsigned long hc;
+		int hl;
+
+		if (raana_r2_close(&r, &best_cand, &best_len, &hc, &hl)) {
+			if (confirm) {
+				if (hc == confirm && hl - clen <= 1 &&
+				    clen - hl <= 1)
+					return 1;
+			} else if (raana_hit_stop(ctx, hc, hl, 0)) {
+				*stop = 1;
+			}
+		}
+	}
+	return confirm ? 0 : ctx->hit_ok;
+}
+
+static int raana_r2_seg(struct raana_ctx *ctx, unsigned long start,
+			unsigned long end, int *stop)
+{
+	return raana_r2_scan(ctx, start, end, stop, 0, 0);
+}
+
+static int raana_r3_close(struct raana_run *r, unsigned long *best_cand,
+			  int *best_len, unsigned long *hc, int *hl)
+{
+	int ok = 0;
+
+	if (r->len >= KS_RUN_MIN && r->len > *best_len &&
+	    kr_commit_selfrel(r->cand, r->len, best_cand, best_len)) {
+		*hc = r->cand;
+		*hl = *best_len;
+		ok = 1;
+	}
+	r->active = 0;
+	return ok;
+}
+
+/* self relative layout v3 the run ascends within a four byte
+ * tolerance and starts on any negative dword */
+static int raana_r3_scan(struct raana_ctx *ctx, unsigned long start,
+			 unsigned long end, int *stop, unsigned long confirm,
+			 int clen)
+{
+	struct raana_run r = {0};
+	unsigned long best_cand = 0;
+	int best_len = 0;
+	unsigned long readable, scan_end, pos;
+	unsigned int m = 0;
+
+	start &= ~KS_PAGE_MASK;
+	if (!confirm)
+		end = (end + KS_PAGE_MASK) & ~KS_PAGE_MASK;
+	readable = raana_probe(start, end + PAGE_SIZE);
+	if (kr_timeout_hit()) {
+		*stop = 1;
+		return 0;
+	}
+	scan_end = readable < end ? readable : end;
+	pos = start;
+
+	while (pos + 8 <= scan_end && !r.active) {
+		u64 w = *(const u64 *)pos;
+
+		if (((++m) & 0x3FF) == 0 && kr_timeout_hit()) {
+			*stop = 1;
+			return 0;
+		}
+		if (!(w & 0x8000000080000000ULL)) {
+			pos += 8;
+			continue;
+		}
+		break;
+	}
+	while (pos + 4 <= scan_end) {
+		unsigned int v = *(unsigned int *)pos;
+
+		if (((++m) & 0x3FF) == 0 && kr_timeout_hit()) {
+			*stop = 1;
+			return 0;
+		}
+		if (r.active) {
+			if ((int)v < r.prev - 4) {
+				unsigned long hc;
+				int hl;
+
+				if (raana_r3_close(&r, &best_cand, &best_len,
+						   &hc, &hl)) {
+					if (confirm) {
+						if (hc == confirm &&
+						    hl - clen <= 1 &&
+						    clen - hl <= 1)
+							return 1;
+					} else if (raana_hit_stop(ctx, hc, hl,
+								  1)) {
+						*stop = 1;
+						return 1;
+					}
+				}
+				if ((int)v < 0) {
+					r.active = 1;
+					r.cand = pos;
+					r.prev = (int)v;
+					r.len = 1;
+				}
+			} else {
+				r.prev = (int)v;
+				r.len++;
+			}
+		} else if ((int)v < 0) {
+			r.active = 1;
+			r.cand = pos;
+			r.prev = (int)v;
+			r.len = 1;
+		}
+		pos += 4;
+	}
+
+	if (r.active) {
+		unsigned long hc;
+		int hl;
+
+		if (raana_r3_close(&r, &best_cand, &best_len, &hc, &hl)) {
+			if (confirm) {
+				if (hc == confirm && hl - clen <= 1 &&
+				    clen - hl <= 1)
+					return 1;
+			} else if (raana_hit_stop(ctx, hc, hl, 1)) {
+				*stop = 1;
+			}
+		}
+	}
+	return confirm ? 0 : ctx->hit_ok;
+}
+
+static int raana_r3_seg(struct raana_ctx *ctx, unsigned long start,
+			unsigned long end, int *stop)
+{
+	return raana_r3_scan(ctx, start, end, stop, 0, 0);
+}
+
+typedef int (*raana_seg_fn)(struct raana_ctx *ctx, unsigned long start,
+			    unsigned long end, int *stop);
+
+static void raana_segments(struct raana_ctx *ctx, unsigned long sw,
+			   unsigned long se, int *stop, raana_seg_fn seg)
+{
+	if (ctx->range_active) {
+		unsigned long pl = ctx->rlo > sw ? ctx->rlo : sw;
+		unsigned long ph = ctx->rhi < se ? ctx->rhi : se;
+
+		pl &= ~KS_PAGE_MASK;
+		if (ph > pl) {
+			/* one boundary only the priority part runs to the
+			 * sweep end so runs starting inside it complete */
+			seg(ctx, pl, se, stop);
+			if (*stop)
+				return;
+			if (pl > sw)
+				seg(ctx, sw, pl, stop);
+			return;
+		}
+	}
+	seg(ctx, sw, se, stop);
+}
+
+void raana_offsets_phase(struct raana_ctx *ctx, unsigned long ti,
+			 unsigned long kltable)
+{
+	unsigned long sw, se;
+	int stop = 0;
+
+	sw = kltable > ctx->sback ?
+		(kltable - ctx->sback) & ~KS_PAGE_MASK : kernel_base;
+	se = (ti + ctx->sfwd + KS_PAGE_MASK) & ~KS_PAGE_MASK;
+
+	raana_segments(ctx, sw, se, &stop, raana_r2_seg);
+	if (stop || ctx->hit_len)
+		return;
+	raana_segments(ctx, sw, se, &stop, raana_r3_seg);
+}
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/slide.c b/KernelSU/kernel/susfs/kallrecon/lib/slide.c
new file mode 100644
index 000000000000..e75bc4b511dc
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/slide.c
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * slide.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/types.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+#include <linux/build_bug.h>
+#include "core.h"
+#include "slide.h"
+
+#ifdef KALLRECON_DEBUG
+#define slide_dbg(fmt, ...) pr_info("[slide] " fmt, ##__VA_ARGS__)
+#else
+#define slide_dbg(fmt, ...) do { if (0) pr_info("[slide] " fmt, ##__VA_ARGS__); } while (0)
+#endif
+
+#define SLIDE_BUF_WORDS (18 * 1024)
+unsigned int slide_buf[SLIDE_BUF_WORDS];
+
+/*
+ * The window reads chunksz + margin bytes, and check_ti_strong() reads
+ * 256 u16 past slide_ptr() at any offset inside the window.
+ */
+static_assert(sizeof(slide_buf) >= KS_WIN_SIZE + KS_WIN_MARGIN);
+static_assert(KS_WIN_MARGIN >= 256 * sizeof(unsigned short));
+
+/* load one window at addr: try the whole read first, on failure fall
+ * back to page by page so the readable prefix is still salvaged; the
+ * unreadable tail is zeroed and next records where it starts */
+static void slide_read(struct slide_win *w, unsigned long addr)
+{
+	unsigned int total = w->chunksz + w->margin;
+	unsigned int got = 0;
+
+	w->addr = addr;
+	w->off = 0;
+
+	if (!safe_read(slide_buf, (void *)addr, total)) {
+		w->valid = total;
+		w->next = 0;
+		return;
+	}
+
+	while (got < total) {
+		unsigned int n = total - got;
+
+		if (n > 0x1000)
+			n = 0x1000;
+		if (safe_read((unsigned char *)slide_buf + got,
+			      (void *)(addr + got), n))
+			break;
+		got += n;
+	}
+	w->valid = got;
+	w->next = got < total ? addr + got : 0;
+	if (got < total)
+		memset((unsigned char *)slide_buf + got, 0, total - got);
+}
+
+/* load a window, walking forward page by page while it starts inside
+ * a hole. kallsyms tables live in the kernel image, so a gap beyond
+ * KS_HOLE_MAX means there is nothing left to find */
+static int slide_load(struct slide_win *w, unsigned long addr)
+{
+	unsigned long cap = addr + KS_HOLE_MAX;
+
+	slide_read(w, addr);
+	while (!w->valid && w->next && w->next < cap)
+		slide_read(w, w->next + 0x1000);
+	return w->valid != 0;
+}
+
+int slide_init(struct slide_win *w, unsigned long pos,
+	       unsigned int chunksz, unsigned int margin)
+{
+	w->chunksz = chunksz;
+	w->margin = margin;
+
+	slide_dbg("init pos=0x%lx chunksz=%u margin=%u\n", pos, chunksz, margin);
+
+	if (!slide_load(w, pos)) {
+		slide_dbg("init FAIL read @ 0x%lx\n", pos);
+		return -1;
+	}
+
+	slide_dbg("init ok addr=0x%lx valid=%u\n", w->addr, w->valid);
+	return 0;
+}
+
+int slide_advance(struct slide_win *w, unsigned int n)
+{
+	unsigned long old_addr = w->addr;
+	unsigned int old_off = w->off;
+	unsigned int limit = w->next ? w->valid : w->chunksz;
+	unsigned long cursor, new_addr;
+
+	w->off += n;
+	if (w->off < limit)
+		return 0;
+
+	cursor = w->addr + w->off;
+	new_addr = w->next ? w->next : (cursor - w->margin) & ~0xFFFULL;
+
+	slide_dbg("slide cursor=0x%lx old=0x%lx new=0x%lx\n",
+		  cursor, w->addr, new_addr);
+
+	if (!slide_load(w, new_addr)) {
+		slide_dbg("slide FAIL read @ 0x%lx\n", new_addr);
+		w->addr = old_addr;
+		w->off = old_off;
+		return -1;
+	}
+
+	/* a regular slide keeps the cursor position (margin overlap),
+	 * a window loaded after a hole is searched from its head */
+	if (cursor >= w->addr && cursor - w->addr < w->valid)
+		w->off = cursor - w->addr;
+	else
+		w->off = 0;
+
+	slide_dbg("slide ok addr=0x%lx valid=%u next=0x%lx off=%u\n",
+		  w->addr, w->valid, w->next, w->off);
+	return 0;
+}
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/slide.h b/KernelSU/kernel/susfs/kallrecon/lib/slide.h
new file mode 100644
index 000000000000..76506423899c
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/slide.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * slide.h
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#ifndef SLIDE_H
+#define SLIDE_H
+
+#include <linux/types.h>
+
+#define KS_WIN_SIZE	(64 * 1024)	/* slide window chunk */
+#define KS_WIN_MARGIN	512		/* slide window overlap */
+#define KS_HOLE_MAX	(8 * 1024 * 1024)	/* hole probe cap */
+
+extern unsigned int slide_buf[];
+
+struct slide_win {
+	unsigned long addr;
+	unsigned int  chunksz;
+	unsigned int  margin;
+	unsigned int  off;
+	unsigned int  valid;	/* readable bytes in this window */
+	unsigned long next;	/* hole tail to resume from, 0 = none */
+};
+
+int slide_init(struct slide_win *w, unsigned long pos,
+	       unsigned int chunksz, unsigned int margin);
+int slide_advance(struct slide_win *w, unsigned int n);
+
+static inline void *slide_ptr(const struct slide_win *w, const void *buf)
+{
+	return (unsigned char *)buf + w->off;
+}
+
+static inline unsigned long slide_addr(const struct slide_win *w)
+{
+	return w->addr + w->off;
+}
+
+#endif
diff --git a/KernelSU/kernel/susfs/kallrecon/lib/symbol.c b/KernelSU/kernel/susfs/kallrecon/lib/symbol.c
new file mode 100644
index 000000000000..39a7266b3ab6
--- /dev/null
+++ b/KernelSU/kernel/susfs/kallrecon/lib/symbol.c
@@ -0,0 +1,580 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * symbol.c
+ *
+ * Copyright (C) 2026 dere3046
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include "core.h"
+#include "ks_dbg.h"
+#include "access.h"
+#include "slide.h"
+#include "symbol.h"
+
+/* kernels without the CFI backport (vanilla 5.10) do not define __nocfi */
+#ifndef __nocfi
+#define __nocfi
+#endif
+
+/* markers sanity: walking 256 symbols from the stream start must land
+ * on the offset stored in markers[1]; only then get_sym_offset() may
+ * trust markers to skip ahead */
+static int kl_markers_ok;
+
+/* KALLRECON_NO_MARKERS forces the original full names walk */
+int ks_markers_usable(void)
+{
+#ifdef KALLRECON_NO_MARKERS
+	return 0;
+#else
+	return kl_markers_ok == 1;
+#endif
+}
+
+void kr_markers_reset(void)
+{
+	kl_markers_ok = 0;
+}
+
+void kr_verify_markers(void)
+{
+	u32 m0, m1;
+	const u8 *p;
+	int i;
+
+	if (!klmarks_addr || !klnames_addr || klnum_val <= 512)
+		return;
+	if (safe_read(&m0, (void *)klmarks_addr, 4) ||
+	    safe_read(&m1, (void *)(klmarks_addr + 4), 4) || m0 != 0) {
+		kl_markers_ok = -1;
+		return;
+	}
+
+	p = (const u8 *)klnames_addr;
+	for (i = 0; i < 256; i++) {
+		unsigned char lb;
+		int len;
+
+		if (safe_read(&lb, (void *)p, 1))
+			break;
+		len = lb;
+		if (len & 0x80) {
+			if (safe_read(&lb, (void *)(p + 1), 1))
+				break;
+			len = (len & 0x7F) | (lb << 7);
+			p += 2 + len;
+		} else {
+			p += 1 + len;
+		}
+	}
+	kl_markers_ok = (i == 256 &&
+			 (unsigned int)(p - (const u8 *)klnames_addr) == m1)
+		? 1 : -1;
+	ks_dbg("[kallrecon] markers verify: %s\n",
+		kl_markers_ok == 1 ? "OK" : "MISMATCH");
+}
+
+#define KS_CLEANUP_PROBE	8192
+
+unsigned short ti_buf[256];
+unsigned char tt_buf[KS_TT_SIZE];
+
+/* strip one LTO suffix. SEQS (default) is the original GKI proven rule
+ * and costs nothing; AUTO probes the names stream once and is the
+ * opt-in setting for third party kernels; LLVM and DOLLAR force one
+ * style */
+static int kr_cleanup_mode = KALLRECON_CLEANUP_SEQS;
+static int kr_cleanup_style;
+
+static int kr_cleanup_probe(void)
+{
+	char buf[256];
+	unsigned long off = 0;
+	int has_llvm = 0, has_dollar = 0;
+
+	if (!klnames_addr || !klindex_addr || !kltable_addr)
+		return klseqs_addr ? 1 : 2;
+	if (safe_read(ti_buf, (void *)klindex_addr, sizeof(ti_buf)) ||
+	    safe_read(tt_buf, (void *)kltable_addr, sizeof(tt_buf)))
+		return klseqs_addr ? 1 : 2;
+
+	for (int i = 0; i < KS_CLEANUP_PROBE; i++) {
+		unsigned char enc[258];
+		unsigned int len, hdr = 1;
+
+		if (safe_read(enc, (void *)(klnames_addr + off), 1))
+			break;
+		len = enc[0];
+		if (len & 0x80) {
+			if (safe_read(enc + 1,
+				      (void *)(klnames_addr + off + 1), 1))
+				break;
+			len = (len & 0x7F) | (enc[1] << 7);
+			hdr = 2;
+		}
+		if (len > 256U ||
+		    safe_read(enc + hdr,
+			      (void *)(klnames_addr + off + hdr), len))
+			break;
+		if (!ks_expand_raw(enc, ti_buf, tt_buf, buf, sizeof(buf)))
+			break;
+		if (strstr(buf, ".llvm."))
+			has_llvm = 1;
+		else if (strchr(buf, '$'))
+			has_dollar = 1;
+		if (has_llvm && has_dollar)
+			break;
+		off += hdr + len;
+	}
+
+	if (has_llvm && !has_dollar)
+		return 1;
+	if (has_dollar && !has_llvm)
+		return 2;
+	return klseqs_addr ? 1 : 2;
+}
+
+static int kr_cleanup_get_style(void)
+{
+	if (kr_cleanup_mode == KALLRECON_CLEANUP_SEQS)
+		return klseqs_addr ? 1 : 2;
+	if (kr_cleanup_mode == KALLRECON_CLEANUP_LLVM)
+		return 1;
+	if (kr_cleanup_mode == KALLRECON_CLEANUP_DOLLAR)
+		return 2;
+	if (!kr_cleanup_style)
+		kr_cleanup_style = kr_cleanup_probe();
+	return kr_cleanup_style;
+}
+
+static int ks_cleanup_name(char *s)
+{
+	char *res;
+
+	if (kr_cleanup_get_style() == 1)
+		res = strstr(s, ".llvm.");
+	else
+		res = strrchr(s, '$');
+	if (!res)
+		return 0;
+	*res = '\0';
+	return 1;
+}
+
+void kallrecon_set_cleanup_mode(enum kallrecon_cleanup mode)
+{
+	if (mode != KALLRECON_CLEANUP_AUTO &&
+	    mode != KALLRECON_CLEANUP_SEQS &&
+	    mode != KALLRECON_CLEANUP_LLVM &&
+	    mode != KALLRECON_CLEANUP_DOLLAR)
+		return;
+	kr_cleanup_mode = (int)mode;
+	kr_cleanup_style = 0;
+}
+
+void kr_cleanup_reset(void)
+{
+	kr_cleanup_style = 0;
+}
+
+static int (*kallrecon_user_cleanup)(char *s);
+
+static __nocfi int ks_cleanup_name_chain(char *s)
+{
+	int (*cb)(char *s) = READ_ONCE(kallrecon_user_cleanup);
+	int r = ks_cleanup_name(s);
+
+	if (cb)
+		r |= cb(s) ? 1 : 0;
+	return r;
+}
+
+void kallrecon_set_cleanup(int (*cb)(char *s))
+{
+	WRITE_ONCE(kallrecon_user_cleanup, cb);
+}
+
+unsigned long sym_addr(int idx)
+{
+	u32 off;
+
+	if (idx < 0 || idx >= (int)klnum_val)
+		return 0;
+	if (safe_read(&off, (void *)(kloffs_addr + idx * 4), 4))
+		return 0;
+#ifdef CONFIG_X86_64
+	if (kl_addr_mode == KS_MODE_ABSPCPU) {
+		s32 so = (s32)off;
+
+		if (so >= 0)
+			return (unsigned long)(u32)so;
+		return klbase_val - 1 - so;
+	}
+#endif
+	if (kl_addr_mode == KS_MODE_SELFREL)
+		return kloffs_addr + idx * 4 + (s32)off;
+	return klbase_val + off;
+}
+
+/* decode one compressed symbol: length header plus token indexes.
+ * tt points at token_table whenever the encoding sits in the slide
+ * window, NULL reads tokens through safe_read instead (enc is then a
+ * stack copy). ti is always a local array, loaded once per batch */
+int ks_expand_raw(const unsigned char *enc, const unsigned short *ti,
+		  const unsigned char *tt, char *buf, int max)
+{
+	unsigned int len = *enc++;
+	int skipped = 0;
+
+	*buf = '\0';
+	if (len & 0x80)
+		len = (len & 0x7F) | (*enc++ << 7);
+	if (len > 256U)
+		return 0;
+
+	for (unsigned int i = 0; i < len && max > 1; i++) {
+		unsigned char c = *enc++;
+		unsigned short to = ti[c];
+
+		if (to >= KS_TT_SIZE)
+			return 0;
+		if (tt) {
+			const unsigned char *tp = tt + to;
+
+			while (*tp) {
+				if (tp - tt >= KS_TT_SIZE)
+					return 0;
+				if (skipped) {
+					if (max <= 1)
+						return 0;
+					*buf++ = *tp;
+					max--;
+				} else {
+					skipped = 1;
+				}
+				tp++;
+			}
+		} else {
+			unsigned long tp = kltable_addr + to;
+
+			for (;;) {
+				unsigned char ch;
+
+				if (safe_read(&ch, (void *)tp, 1) || !ch)
+					break;
+				if (skipped) {
+					if (max <= 1)
+						break;
+					*buf++ = ch;
+					max--;
+				} else {
+					skipped = 1;
+				}
+				tp++;
+			}
+		}
+	}
+	if (max)
+		*buf = '\0';
+	return 1;
+}
+
+int expand_sym(unsigned int off, char *buf, int max)
+{
+	unsigned short ti[256];
+	unsigned char enc[2 + 256];
+	unsigned int len, hdr;
+
+	if (max <= 0)
+		return 0;
+	buf[0] = '\0';	/* a failed read must not leave stale data */
+
+	if (safe_read(ti, (void *)klindex_addr, sizeof(ti)))
+		return 0;
+	if (safe_read(enc, (void *)(klnames_addr + off), 1))
+		return 0;
+	len = enc[0];
+	hdr = 1;
+	if (len & 0x80) {
+		if (safe_read(enc + 1, (void *)(klnames_addr + off + 1), 1))
+			return 0;
+		len = (len & 0x7F) | (enc[1] << 7);
+		hdr = 2;
+	}
+	if (len > 256U)
+		return 0;
+	if (safe_read(enc + hdr, (void *)(klnames_addr + off + hdr), len))
+		return 0;
+	if (!ks_expand_raw(enc, ti, NULL, buf, max)) {
+		/* ks_expand_raw() may have written a partial name without
+		 * the terminator, drop it so callers never see a stale or
+		 * unterminated buffer
+		 */
+		buf[0] = '\0';
+		return 0;
+	}
+	return (int)(hdr + len);
+}
+
+unsigned int get_sym_seq(int idx)
+{
+	unsigned int i, seq = 0;
+
+	if (klseqs_addr) {
+		if (klseqs_stride == 4) {
+			u32 v;
+
+			if (safe_read(&v, (const void *)(klseqs_addr +
+					(unsigned long)idx * 4), 4))
+				return (unsigned int)idx;
+			return v;
+		}
+		{
+			unsigned char buf[3];
+
+			if (safe_read(buf, (const void *)(klseqs_addr +
+					(unsigned long)idx * 3), 3))
+				return (unsigned int)idx;
+			for (i = 0; i < 3; i++)
+				seq = (seq << 8) | buf[i];
+			return seq;
+		}
+	}
+	return (unsigned int)idx;
+}
+
+unsigned int get_sym_offset(unsigned int seq)
+{
+	const u8 *p;
+	unsigned char lb;
+
+	/* markers hold the stream offset of every 256th symbol; jump to
+	 * the nearest one instead of walking the whole stream */
+	if (ks_markers_usable() && seq >= 256) {
+		unsigned int m = seq / 256;
+		u32 mo;
+
+		if (safe_read(&mo, (void *)(klmarks_addr + m * 4), 4))
+			return UINT_MAX;
+		seq -= m * 256;
+		p = (const u8 *)(klnames_addr + mo);
+	} else {
+		p = (const u8 *)klnames_addr;
+	}
+
+	for (unsigned int i = 0; i < seq; i++) {
+		if (safe_read(&lb, (void *)p, 1))
+			return UINT_MAX;
+		int len = lb;
+
+		if (len & 0x80) {
+			if (safe_read(&lb, (void *)(p + 1), 1))
+				return UINT_MAX;
+			len = ((len & 0x7F) | (lb << 7)) + 1;
+		}
+		p = p + len + 1;
+	}
+	return p - (const u8 *)klnames_addr;
+}
+
+DEFINE_MUTEX(ks_linear_lock);
+
+static unsigned long name_to_addr_linear_locked(const char *name)
+{
+	unsigned short *ti = ti_buf;
+	unsigned char *tt = tt_buf;
+	char nbuf[256];
+	int idx, hit = 0, decoded = 0, retried = 0;
+	struct slide_win w;
+
+	ks_dbg("[kallrecon] linear: search '%s' n=%u\n", name, klnum_val);
+
+	if (safe_read(ti, (void *)klindex_addr, sizeof(ti_buf))) {
+		ks_dbg("[kallrecon] linear: ti load FAIL\n");
+		return 0;
+	}
+	if (safe_read(tt, (void *)kltable_addr, sizeof(tt_buf))) {
+		ks_dbg("[kallrecon] linear: tt load FAIL\n");
+		return 0;
+	}
+
+	if (slide_init(&w, klnames_addr, KS_WIN_SIZE, KS_WIN_MARGIN)) {
+		ks_dbg("[kallrecon] linear: slide init FAIL\n");
+		return 0;
+	}
+
+	for (idx = 0; idx < (int)klnum_val; ) {
+		const unsigned char *name_start = slide_ptr(&w, slide_buf);
+		int lb = *name_start;
+		int elen = lb;
+		int hdr = 1;
+
+		if (lb & 0x80) {
+			elen = (lb & 0x7F) | (name_start[1] << 7);
+			hdr = 2;
+		}
+		if ((unsigned int)(hdr + elen) > 256U ||
+		    w.off + hdr + elen > w.valid) {
+			/* the entry extends past the readable part of
+			 * this window: pull in the next window and retry */
+			ks_dbg("[kallrecon] linear: window end idx=%d\n", idx);
+			if (retried ||
+			    slide_advance(&w, (w.valid - w.off) + 4))
+				break;
+			retried = 1;
+			continue;
+		}
+		retried = 0;
+
+		if (!ks_expand_raw(name_start, ti, tt, nbuf, sizeof(nbuf))) {
+			/* a bad token index leaves nbuf partial without the
+			 * terminator, never hand it to strcmp()
+			 */
+			ks_dbg("[kallrecon] linear: decode fail idx=%d\n", idx);
+			nbuf[0] = '\0';
+		} else {
+			decoded++;
+		}
+		{
+			int sample = 0;
+
+			if (idx < 5)
+				sample = 1;
+			else if (idx == (int)klnum_val / 2)
+				sample = 1;
+			else if (idx >= (int)klnum_val - 5)
+				sample = 1;
+			else if (nbuf[0] == 'k' && nbuf[1] == 'a')
+				sample = 1;
+			if (sample)
+				ks_dbg("[kallrecon] linear: [%d] '%s'\n",
+					idx, nbuf);
+		}
+		if (strcmp(nbuf, name) == 0) {
+			hit = 1;
+			ks_dbg("[kallrecon] linear: HIT idx=%d\n", idx);
+			return sym_addr(idx);
+		}
+		if (ks_cleanup_name_chain(nbuf) && strcmp(nbuf, name) == 0) {
+			hit = 1;
+			ks_dbg("[kallrecon] linear: HIT(cln) idx=%d\n", idx);
+			return sym_addr(idx);
+		}
+
+		if (slide_advance(&w, hdr + elen)) {
+			ks_dbg("[kallrecon] linear: slide fail idx=%d\n", idx);
+			break;
+		}
+		idx++;
+	}
+
+	ks_dbg("[kallrecon] linear: done idx=%d decoded=%d hit=%d\n",
+		idx, decoded, hit);
+#ifdef KALLRECON_MODULE_LOOKUP
+	if (kallrecon_module_klp)
+		return kallrecon_module_klp(name);
+#endif
+	return 0;
+}
+
+/* linear scan shares slide_buf/ti_buf/tt_buf globals, serialize it */
+static unsigned long name_to_addr_linear(const char *name)
+{
+	unsigned long ret;
+
+	mutex_lock(&ks_linear_lock);
+	ret = name_to_addr_linear_locked(name);
+	mutex_unlock(&ks_linear_lock);
+	return ret;
+}
+
+unsigned long kallsyms_name_to_addr(const char *name)
+{
+	if (!klseqs_addr) {
+#ifdef KALLRECON_MODULE_LOOKUP
+		unsigned long addr = name_to_addr_linear(name);
+
+		if (addr || !kallrecon_module_klp)
+			return addr;
+		return kallrecon_module_klp(name);
+#else
+		return name_to_addr_linear(name);
+#endif
+	}
+
+	int low = 0, high = (int)klnum_val - 1;
+	char nbuf[256];
+
+	while (low <= high) {
+		int mid = low + (high - low) / 2;
+		unsigned int seq = get_sym_seq(mid);
+		unsigned int off = get_sym_offset(seq);
+
+		/* a decode failure ends the search here, but control still
+		 * reaches the module lookup fallback below
+		 */
+		if (!expand_sym(off, nbuf, sizeof(nbuf)))
+			break;
+		ks_cleanup_name_chain(nbuf);
+
+		int r = strcmp(name, nbuf);
+
+		if (r > 0)
+			low = mid + 1;
+		else if (r < 0)
+			high = mid - 1;
+		else {
+			/* walk left to first matching entry, same cleaned
+			 * name resolves to smallest address */
+			unsigned int first = mid;
+
+			while (first > 0) {
+				unsigned int pseq = get_sym_seq(first - 1);
+				unsigned int poff = get_sym_offset(pseq);
+
+				if (!expand_sym(poff, nbuf, sizeof(nbuf)))
+					break;
+				ks_cleanup_name_chain(nbuf);
+				if (strcmp(name, nbuf))
+					break;
+				first--;
+			}
+			return sym_addr(get_sym_seq(first));
+		}
+	}
+#ifdef KALLRECON_MODULE_LOOKUP
+	if (kallrecon_module_klp)
+		return kallrecon_module_klp(name);
+#endif
+	return 0;
+}
+
+int sym_name_at(unsigned long addr, char *buf, int max)
+{
+	int low = 0, high = (int)klnum_val;
+
+	if (max <= 0)
+		return -1;
+	buf[0] = '\0';
+	if (!klnum_val)
+		return -1;
+
+	while (high - low > 1) {
+		int mid = low + (high - low) / 2;
+
+		if (sym_addr(mid) <= addr)
+			low = mid;
+		else
+			high = mid;
+	}
+
+	unsigned int off = get_sym_offset(low);
+
+	if (!expand_sym(off, buf, max))
+		return -1;
+	ks_cleanup_name_chain(buf);
+	return low;
+}
