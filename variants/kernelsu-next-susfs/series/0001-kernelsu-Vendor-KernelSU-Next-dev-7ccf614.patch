diff --git a/KernelSU/kernel/susfs/susfs_open_redirect.c b/KernelSU/kernel/susfs/susfs_open_redirect.c
new file mode 100644
index 000000000000..dc16c22d7ea8
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_open_redirect.c
@@ -0,0 +1,1629 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_open_redirect.c - redirect open of a target path to another path (SUSFS OPEN_REDIRECT feature), LKM port.
+ * Forward direction: not in this file.  path_openat / do_sys_openat2 / do_filp_open are LTO-inlined into the syscall
+ * entry, so none can be kprobed, and the only out-of-line symbol on the user-open path (vfs_open(file)) sits at the
+ * inode layer, where the name is already gone - a swap there has to pin a dentry and a mount per rule, which then
+ * blocks umount.  Redirection is done one level up instead, at the syscall entry, by susfs_or_entry.c (wrapper
+ * replacement; see that file header).  Nothing here holds a struct path any more: a rule keeps (target_ino, target_dev,
+ * target_igen), the spoofed kstatfs snapshot and the two pathnames, and the entry hook resolves the name it was given.
+ * Because nothing is pinned, the numbers are all that identify a rule's files: a filesystem may reuse an inode number
+ * after a file is deleted, so every match also compares i_generation (the same field NFS export handles use; a
+ * filesystem that does not maintain it reports 0, which is no worse than matching the number alone).  The rule table
+ * is a fixed array of SUS_OR_MAX slots that ARE reused: deleting or replacing a rule retires its slot, and the slot is
+ * cleared and handed out again once a grace period has passed (or_reclaim_slot() - every reader copies what it needs
+ * out of an entry under rcu_read_lock, which is what makes that safe).  Two fixed hash indexes (forward target and
+ * reverse redirected) keep the open/inode lookups O(1) average; the slot array itself stays the stable storage.  susfs_open_redirect_rules counts live rules, so
+ * the name layer stops paying a lookup once the last rule is gone.
+ * uid_scheme: enum UID_SCHEME (susfs_abi.h:67-73), all five values with upstream's predicates (susfs.c:941-964); two of
+ * the five need state an LKM cannot read - see the open view / or_in_su_domain().
+ * Reverse disguise: upstream registers TWO hash entries per rule (susfs.c:844-863), the second with
+ * reversed_lookup_only = true and the two pathnames swapped, and every "where did this file come from" reporter answers
+ * from it - vfs_readlink() patch:510-548, do_proc_readlink() (/proc/<pid>/fd/N, exe, cwd, root) patch:1062-1083, fdinfo
+ * seq_show() (mnt_id + ino) patch:1145-1217, show_map_vma() (maps dev:ino + name) patch:1257-1288, vfs_statfs()
+ * (statfs/fstatfs) patch:2038-2056.  Gate: SUSFS_IS_INODE_OPEN_REDIRECT (susfs_def.h:148-151) = inode flag *and*
+ * susfs_is_current_proc_umounted_app(), never the rule's uid_scheme - so even a scheme-0 rule is disguised for app
+ * processes (or_reverse_visible() keeps that gate through susfs_is_current_proc_umounted_app()).
+ * Reachability: none of those five is reachable from an LKM here (the first two and seq_show() are static; the
+ * maps/fdinfo numbers are locals a kprobe cannot see).  Covered instead: d_path() and vfs_statfs() are kretprobed and
+ * answer from the rule snapshot (both take the redirected file's dentry, so a return probe can replace what they
+ * rendered - d_path() keeps its caller-supplied buffer, hence the rewrite rather than an argument swap), and where no
+ * shared helper exists the line the function already formatted is rewritten the same way - show_map_vma()'s line
+ * carries "maj:min ino" AND the name, both from the redirected file, and the name cannot be reached that way
+ * (seq_file_path() -> seq_path() -> __d_path() is LTO-inlined: a probe on it registers and never fires - measured).
+ * Never silent: registration outcome, entry-hook state and hit counts are logged and shown by
+ * /proc/susfs_open_redirect, because registering only proves the symbol exists - this feature has hit that wall twice
+ * (show_vma_header_prefix, then __d_path: both registered, both stayed at 0).
+ *
+ * /proc/susfs_open_redirect: add_open_redirect <target> <redirected> <uid_scheme> | del <target> | clear
+ */
+#include <linux/module.h>
+#include <linux/kprobes.h>
+#include <linux/fs.h>
+#include <linux/cred.h>
+#include <linux/namei.h>
+#include <linux/dcache.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include "mount.h"		/* fs/mount.h: real_mount() -> mnt_id */
+#include <linux/atomic.h>	/* reverse-disguise hit counters */
+#include <linux/rcupdate.h>	/* the entry hook's match runs under rcu_read_lock, like the probes */
+#include <linux/statfs.h>	/* struct kstatfs: the snapshot the reverse statfs face answers from */
+#include <linux/mm.h>		/* struct vm_area_struct (the maps reverse face) */
+#include <linux/kdev_t.h>	/* MAJOR/MINOR, to render dev:ino the way proc does */
+#include <linux/kernel.h>	/* scnprintf, for the same rendering */
+#include <linux/hash.h>	/* hash_64 for the rule indexes */
+#include <linux/security.h>	/* security_secctx_to_secid */
+#include "susfs_abi.h"
+#include "susfs_log.h"
+#include "susfs.h"		/* susfs_expose_proc, sus_path_lsm_active */
+#include "symbol_resolver.h"	/* find_kernel_symbol_exact */
+#include "ksu_umount_gate.h"	/* susfs_is_current_proc_umounted_app (issue #34) */
+#include "ksu_allow_gate.h"	/* the control-node gate is su's own */
+#include "susfs_kprobe.h"
+#include "susfs_or_entry.h"	/* susfs_or_entry_armed(): the forward direction lives there now */
+#include "susfs_open_data.h"
+
+#define SUS_OR_MAX 512
+#define OR_HASH_BITS 10
+#define OR_HASH_BUCKETS (1U << OR_HASH_BITS)
+#define OR_BUCKET_MAX 13
+#define OR_INDEX_COUNT 2
+#define OR_REHASH_MAX 20
+/* The ABI fields are char[256]; matching that width stops a legal long path from being truncated into a rule for a
+ * different path. */
+#define OR_PATH_MAX 256
+
+/* UID_SCHEME lives in susfs_abi.h, mirroring upstream susfs.h, where the enum sits next to the ABI structs. */
+
+/* FUSE is the one filesystem upstream refuses outright (susfs.c:824-829): the daemon resolves the name itself, so a
+ * kernel-side swap does nothing or makes the request happen twice.  susfs_def.h:49-51 carries the constant for the same
+ * reason: neither <linux/magic.h> (absent from this tree) nor <uapi/linux/magic.h> defines it; fs/fuse/fuse_i.h does. */
+#ifndef FUSE_SUPER_MAGIC
+#define FUSE_SUPER_MAGIC 0x65735546
+#endif
+
+/* Upstream's app threshold (susfs_def.h:122-125: TIF_PROC_UMOUNTED && current_uid().val >= 10000) is not a macro any
+ * more: both gates that used it now go through susfs_is_current_proc_umounted_app(), whose uid half is that same literal
+ * 10000 (ksu_umount_gate.h) and whose other half is KernelSU's answer. */
+
+/* SELinux context of the su/ksu domain, resolved to a sid at init.  Upstream gets the sid from KernelSU itself
+ * (susfs_set_sid(KERNEL_SU_CONTEXT, &susfs_ksu_sid), 10_enable_susfs_for_ksu.patch:2496); an LKM has to resolve the
+ * string.  "u:r:ksu:s0" is the SukiSU variant this device runs (KERNEL_SU_DOMAIN "ksu"), stock KernelSU uses
+ * "u:r:su:s0" - override with susfs_guard_lkm.or_su_ctx.  Kept separate from sus_mount's su_ctx and avc_spoof's
+ * avc_su_ctx: parameters are per name, and defaulting to the wrong domain must not change other features' gating. */
+static char or_su_ctx[128] = "u:r:ksu:s0";
+module_param_string(or_su_ctx, or_su_ctx, sizeof(or_su_ctx), 0644);
+
+static u32 or_su_sid;
+
+/* security_cred_getsecid() is an EXPORT_SYMBOL, but GKI's module symbol list is not guaranteed to
+ * carry it, so it is resolved in kallsyms like sus_mount.c does.  The wrapper needs __nocfi: kCFI
+ * validates the type hash at a call through a function pointer. */
+static void (*or_cred_getsecid)(const struct cred *cred, u32 *secid);
+
+/* vfs_statfs, resolved by name: add time takes the target's statfs snapshot with it, and once the
+ * entry holds no path that snapshot is the reverse statfs face's only source for those numbers. */
+static int (*or_vfs_statfs_fn)(const struct path *path, struct kstatfs *buf);
+
+/* The one indirect call into the kernel this file still makes, in its own __nocfi noinline function: a checked indirect
+ * call to a kernel symbol is a CFI panic rather than an error return, and or_add() must stay checkable (the
+ * cfi_sites.py gate looks for exactly this, including a helper that LTO inlined back into a caller without __nocfi). */
+static __nocfi noinline int or_statfs_snapshot(const struct path *path, struct kstatfs *out)
+{
+	if (!or_vfs_statfs_fn)
+		return -EOPNOTSUPP;
+	return or_vfs_statfs_fn(path, out);
+}
+
+struct sus_or_entry {
+	char target_pathname[OR_PATH_MAX];
+	char redirected_pathname[OR_PATH_MAX];
+	unsigned long target_ino;
+	dev_t target_dev;
+	/* Reverse direction: the redirected inode is the lookup key, and target_path is what the reporters above show instead. */
+	unsigned long redirected_ino;
+	dev_t redirected_dev;
+	/* Inode generation, both directions.  A rule keeps numbers instead of references now, and numbers
+	 * are reused: delete a redirected file and create another one on the same filesystem and the new
+	 * file can land on the old inode number, at which point the rule would hijack an unrelated file.
+	 * i_generation is what tells a reused number apart from the object the rule was registered for
+	 * (the same field NFS export handles use).  Filesystems that do not maintain it report 0, which
+	 * compares equal to itself - i.e. on those this is no worse than matching the number alone. */
+	unsigned int target_igen;
+	unsigned int redirected_igen;
+	/* Reverse direction, second number: fdinfo also prints mnt_id, and for the redirected file that is the mount the
+	 * redirection really opened - which can differ from the target's (e.g. /system/etc/hosts vs
+	 * /data/local/tmp/hosts).  Cached at add time: the reporter has only numbers to work with. */
+	unsigned long target_mnt_id;
+	/* Snapshot taken at add time with vfs_statfs(), which the reverse statfs face answers from.
+	 * Nothing in this entry holds a reference of any kind - no dentry, no mount, no inode - and
+	 * that is what keeps a rule from pinning a filesystem in place. */
+	struct kstatfs spoofed_kstatfs;
+	int uid_scheme;
+	/* Set while the slot is being rewritten or has been deleted.  The reader checks this with
+	 * READ_ONCE and the writer clears it LAST, so false means the rest of the entry is complete. */
+	bool dead;
+};
+
+struct or_index {
+	u32 seed;
+	int buckets[OR_HASH_BUCKETS];
+	int rev_buckets[OR_HASH_BUCKETS];
+	int next[SUS_OR_MAX];
+	int rnext[SUS_OR_MAX];
+};
+
+static struct sus_or_entry or_entries[SUS_OR_MAX];
+static struct or_index or_indexes[OR_INDEX_COUNT];
+static struct or_index *or_active_index;
+static unsigned int or_rehash_count;
+static int nor;		/* highest index ever handed out, plus one: the allocation bound */
+/* Slots that were handed out and have been taken back (or_reclaim_slot()).  A slot returns here once
+ * a grace period has passed, which is what turns the UPPER BOUND into "how many rules exist at the
+ * same time" instead of "how many times a rule was ever added". */
+static unsigned int or_free[SUS_OR_MAX];
+static unsigned int or_free_n;
+/* How many rules are live right now, which is what the name-layer hook reads before it resolves anything: the hook runs
+ * for every open() on the system, so a table that once had a rule must not keep costing a path lookup after that rule
+ * was deleted.  Written under or_lock, read locklessly (susfs.h states the contract). */
+unsigned int susfs_open_redirect_rules;
+static DEFINE_MUTEX(or_lock);
+
+/* Reverse-disguise bookkeeping.  The counters are the only way to tell a hook that never fires from one that fires and
+ * matches nothing: a kprobe registers against a symbol's out-of-line copy, which GKI's full LTO may leave with no live
+ * call sites (measured: five probes registered, zero hits). */
+static atomic_t or_rev_dpath_hits = ATOMIC_INIT(0);
+static atomic_t or_rev_statfs_hits = ATOMIC_INIT(0);
+
+/* No release path for a rule's FILES, because an entry holds no reference to them: no dentry, no mount, no inode, only
+ * numbers, strings and the statfs snapshot (file-level note).  The SLOT a rule occupies does come back, though - see
+ * or_reclaim_slot(): a deleted rule's slot is handed out again after a grace period, which is what keeps the table from
+ * being a budget of "how many rules were ever added". */
+static void or_resolve_su_sid(void)
+{
+	int err;
+
+	if (or_su_sid)
+		return;
+	if (!or_su_ctx[0])
+		return;
+	err = security_secctx_to_secid(or_su_ctx, strlen(or_su_ctx), &or_su_sid);
+	if (err) {
+		pr_warn("open_redirect: secctx_to_secid(%s) failed %d\n",
+			or_su_ctx, err);
+		or_su_sid = 0;
+		return;
+	}
+	SUSFS_LOGI("open_redirect: su ctx \"%s\" -> sid %u (stock KernelSU uses \"u:r:su:s0\", override with susfs_guard_lkm.or_su_ctx)\n",
+		or_su_ctx, or_su_sid);
+}
+
+/* Upstream susfs_is_current_ksu_domain() = (current_sid() == susfs_ksu_sid) (10_enable_susfs_for_ksu.patch:2484-2486);
+ * current_sid() lives in SELinux's private objsec.h, so the LSM-agnostic security_cred_getsecid() is used instead. */
+static __nocfi bool or_in_su_domain(void)
+{
+	u32 sid = 0;
+
+	/* Unresolved symbol or unresolvable context: "not su" would be a guess, and for schemes 1/2 that guess redirects
+	 * the very process the rule exists to spare.  or_add() refuses those schemes instead. */
+	if (!or_cred_getsecid || !or_su_sid)
+		return false;
+	/* interrupt context: reading current->cred and walking the (static) LSM hook list never sleeps. */
+	or_cred_getsecid(current_cred(), &sid);
+	return sid == or_su_sid;
+}
+
+/* Upstream's reverse-disguise gate, verbatim in shape: SUSFS_IS_INODE_OPEN_REDIRECT (susfs_def.h:148-151) = flag bit AND
+ * susfs_is_current_proc_umounted_app().  TIF_PROC_UMOUNTED is set by the SUSFS-patched KernelSU, which this kernel does not
+ * have, so the app half is KernelSU's own ksu_uid_should_umount() answer (ksu_umount_gate.h, issue #34) rather than the
+ * `uid >= 10000` proxy that also covered the manager and su-granted apps. */
+static bool or_reverse_visible(void)
+{
+	return susfs_is_current_proc_umounted_app();
+}
+
+/* uid_scheme decision, mirroring upstream's switch in susfs_open_redirect_spoof_do_sys_openat() (susfs.c:941-964). */
+static struct sus_or_entry *or_find_by_path(const char *target)
+{
+	int i;
+
+	for (i = 0; i < READ_ONCE(nor); i++) {
+		if (READ_ONCE(or_entries[i].dead))
+			continue;
+		if (!strcmp(or_entries[i].target_pathname, target))
+			return &or_entries[i];
+	}
+	return NULL;
+}
+
+static u32 or_hash_key(const struct or_index *idx, unsigned long ino, dev_t dev)
+{
+	return (u32)hash_64((u64)ino ^ ((u64)dev << 32) ^ idx->seed, OR_HASH_BITS);
+}
+
+static void or_index_reset(struct or_index *idx, u32 seed)
+{
+	int i;
+
+	idx->seed = seed;
+	for (i = 0; i < OR_HASH_BUCKETS; i++) {
+		idx->buckets[i] = -1;
+		idx->rev_buckets[i] = -1;
+	}
+	for (i = 0; i < SUS_OR_MAX; i++) {
+		idx->next[i] = -1;
+		idx->rnext[i] = -1;
+	}
+}
+
+/* Rebuild the inactive index from the live slots, then publish it and wait for the readers that
+ * were still using the old one.  Entries are unchanged, so the two indexes can coexist. */
+static void or_rehash_locked(void)
+{
+	struct or_index *old = or_active_index;
+	struct or_index *new;
+	u32 seed;
+	int attempt;
+
+	if (or_rehash_count >= OR_REHASH_MAX)
+		return;
+	or_rehash_count++;
+	if (or_rehash_count == OR_REHASH_MAX)
+		SUSFS_LOGI("open_redirect: rehash limit reached (%u) - keeping the current index until rmmod\n",
+			OR_REHASH_MAX);
+
+	new = (old == &or_indexes[0]) ? &or_indexes[1] : &or_indexes[0];
+	seed = old->seed;
+	for (attempt = 0; attempt < 4; attempt++) {
+		bool too_big = false;
+		int i;
+
+		seed = seed * 1664525u + 1013904223u;
+		or_index_reset(new, seed);
+		for (i = 0; i < nor; i++) {
+			struct sus_or_entry *e = &or_entries[i];
+			u32 h, rh;
+
+			if (READ_ONCE(e->dead))
+				continue;
+			h = or_hash_key(new, e->target_ino, e->target_dev);
+			new->next[i] = new->buckets[h];
+			new->buckets[h] = i;
+			rh = or_hash_key(new, e->redirected_ino, e->redirected_dev);
+			new->rnext[i] = new->rev_buckets[rh];
+			new->rev_buckets[rh] = i;
+		}
+		for (i = 0; i < OR_HASH_BUCKETS; i++) {
+			int chain = 0;
+			int j;
+
+			for (j = new->buckets[i]; j >= 0; j = new->next[j])
+				chain++;
+			if (chain >= OR_BUCKET_MAX) {
+				too_big = true;
+				break;
+			}
+		}
+		if (!too_big) {
+			for (i = 0; i < OR_HASH_BUCKETS; i++) {
+				int chain = 0;
+				int j;
+
+				for (j = new->rev_buckets[i]; j >= 0; j = new->rnext[j])
+					chain++;
+				if (chain >= OR_BUCKET_MAX) {
+					too_big = true;
+					break;
+				}
+			}
+		}
+		if (!too_big)
+			break;
+	}
+
+	rcu_assign_pointer(or_active_index, new);
+	synchronize_rcu();
+}
+
+/* Called with or_lock held. */
+static void or_unlink(struct sus_or_entry *e)
+{
+	struct or_index *idx = or_active_index;
+	u32 h = or_hash_key(idx, e->target_ino, e->target_dev);
+	u32 rh = or_hash_key(idx, e->redirected_ino, e->redirected_dev);
+	int *pp;
+	int i;
+
+	pp = &idx->buckets[h];
+	for (i = READ_ONCE(*pp); i >= 0; i = READ_ONCE(idx->next[i])) {
+		if (&or_entries[i] == e) {
+			WRITE_ONCE(*pp, idx->next[i]);
+			break;
+		}
+		pp = &idx->next[i];
+	}
+
+	pp = &idx->rev_buckets[rh];
+	for (i = READ_ONCE(*pp); i >= 0; i = READ_ONCE(idx->rnext[i])) {
+		if (&or_entries[i] == e) {
+			WRITE_ONCE(*pp, idx->rnext[i]);
+			break;
+		}
+		pp = &idx->rnext[i];
+	}
+}
+
+/* Append, never prepend: the old linear scan returned the oldest matching slot for rules that
+ * share one inode (hard links), and that order is observable through which rule wins. */
+static void or_link(struct sus_or_entry *e)
+{
+	struct or_index *idx = or_active_index;
+	u32 h = or_hash_key(idx, e->target_ino, e->target_dev);
+	u32 rh = or_hash_key(idx, e->redirected_ino, e->redirected_dev);
+	int *pp;
+	int count_f = 0, count_r = 0;
+	int slot = (int)(e - or_entries);
+
+	idx->next[slot] = -1;
+	idx->rnext[slot] = -1;
+	pp = &idx->buckets[h];
+	while (READ_ONCE(*pp) >= 0) {
+		pp = &idx->next[READ_ONCE(*pp)];
+		count_f++;
+	}
+	smp_store_release(pp, slot);
+
+	pp = &idx->rev_buckets[rh];
+	while (READ_ONCE(*pp) >= 0) {
+		pp = &idx->rnext[READ_ONCE(*pp)];
+		count_r++;
+	}
+	smp_store_release(pp, slot);
+
+	if ((count_f + 1 >= OR_BUCKET_MAX || count_r + 1 >= OR_BUCKET_MAX) &&
+	    READ_ONCE(or_rehash_count) < OR_REHASH_MAX)
+		or_rehash_locked();
+}
+
+static struct sus_or_entry *or_find_by_inode(unsigned long ino, dev_t dev, unsigned int gen)
+{
+	struct or_index *idx = rcu_dereference(or_active_index);
+	struct sus_or_entry *e;
+	u32 h = or_hash_key(idx, ino, dev);
+	int best = -1;
+	int i;
+
+	for (i = smp_load_acquire(&idx->buckets[h]); i >= 0; i = smp_load_acquire(&idx->next[i])) {
+		e = &or_entries[i];
+		/* dead is cleared LAST by the writer, so skipping dead entries also skips any entry whose
+		 * fields are still being written. */
+		if (READ_ONCE(e->dead))
+			continue;
+		smp_rmb();
+		if (e->target_ino == ino &&
+		    e->target_dev == dev &&
+		    e->target_igen == gen &&
+		    (best < 0 || i < best))
+			best = i;
+	}
+	return best < 0 ? NULL : &or_entries[best];
+}
+
+/* The name-layer entry hook asks this one, with the path the caller is about to open: true when a live
+ * rule redirects that inode, in which case the rule's redirect target has been copied into `buf`.
+ *
+ * The copy happens under rcu_read_lock and is mandatory, not politeness: a slot is recycled once a
+ * grace period has passed after the rule was deleted (or_reclaim_slot()), so a pointer into an
+ * entry may not be used after the lookup returns.  A name that does not fit leaves buf alone and
+ * counts as "no rule" - the caller then runs the original syscall, which is always correct.
+ * The table read is lockless for the same reason the probes' is: `dead` is cleared LAST by the
+ * writer, so a non-dead entry has complete fields. */
+bool susfs_open_redirect_in_su_domain(void)
+{
+	return or_in_su_domain();
+}
+
+int susfs_open_rule_facts_path(const struct path *path,
+			       struct susfs_open_rule_facts *facts)
+{
+	struct inode *inode;
+	struct sus_or_entry *e;
+
+	if (!facts)
+		return -EINVAL;
+	memset(facts, 0, sizeof(*facts));
+	if (!READ_ONCE(nor) || !path || !path->dentry)
+		return 0;
+	inode = d_inode(path->dentry);
+	if (!inode)
+		return 0;
+
+	rcu_read_lock();
+	e = or_find_by_inode(inode->i_ino, inode->i_sb->s_dev, inode->i_generation);
+	if (e && e->redirected_pathname[0]) {
+		facts->matched = true;
+		facts->uid_scheme = e->uid_scheme;
+		strscpy(facts->redirected, e->redirected_pathname,
+			sizeof(facts->redirected));
+	}
+	rcu_read_unlock();
+	return 0;
+}
+
+bool susfs_open_redirect_match_path(const struct path *path, char *buf, size_t buflen)
+{
+	struct susfs_open_rule_facts f;
+
+	susfs_open_rule_facts_path(path, &f);
+	return f.matched && strscpy(buf, f.redirected, buflen) >= 0;
+}
+
+/* Reverse direction: keyed on the redirected (really opened) inode, published like or_find_by_inode(). */
+static struct sus_or_entry *or_find_by_redirected_inode(unsigned long ino, dev_t dev, unsigned int gen)
+{
+	struct or_index *idx = rcu_dereference(or_active_index);
+	struct sus_or_entry *e;
+	u32 h = or_hash_key(idx, ino, dev);
+	int best = -1;
+	int i;
+
+	for (i = smp_load_acquire(&idx->rev_buckets[h]); i >= 0; i = smp_load_acquire(&idx->rnext[i])) {
+		e = &or_entries[i];
+		if (READ_ONCE(e->dead))
+			continue;
+		smp_rmb();
+		if (e->redirected_ino == ino &&
+		    e->redirected_dev == dev &&
+		    e->redirected_igen == gen &&
+		    (best < 0 || i < best))
+			best = i;
+	}
+	return best < 0 ? NULL : &or_entries[best];
+}
+
+/* Reverse direction for the one caller that has only numbers: /proc/<pid>/fdinfo/N prints "mnt_id:\t<i>" and "ino:\t<j>"
+ * for the file an fd points at and no device, so this lookup is by ino alone; two rules sharing that ino refuses to
+ * answer (a missed disguise beats disguising an unrelated file).  On success: the target's ino and mount id (0 unknown).
+ * Only the inode number is available here, so unlike the other lookups this one cannot also compare i_generation - a
+ * number that a filesystem reused stays indistinguishable from this caller's point of view. */
+bool susfs_open_redirect_spoof_ids(unsigned long ino, unsigned long *out_ino,
+				   unsigned long *out_mnt_id)
+{
+	struct sus_or_entry *e = NULL;
+	int i, hits = 0;
+	unsigned long tino = 0, tmnt = 0;
+
+	if (!ino || !out_ino || !or_reverse_visible())
+		return false;
+	/* The numbers are copied out inside the rcu section: rule slots are recycled after a grace
+	 * period (or_reclaim_slot()), so an entry may not be read after this function returns. */
+	rcu_read_lock();
+	for (i = 0; i < READ_ONCE(nor); i++) {
+		if (READ_ONCE(or_entries[i].dead))
+			continue;
+		smp_rmb();
+		if (or_entries[i].redirected_ino != ino)
+			continue;
+		e = &or_entries[i];
+		if (++hits > 1)
+			break;
+	}
+	if (hits == 1) {
+		tino = e->target_ino;
+		tmnt = e->target_mnt_id;
+	}
+	rcu_read_unlock();
+	if (hits != 1)
+		return false;
+	*out_ino = tino;
+	if (out_mnt_id)
+		*out_mnt_id = tmnt;
+	return true;
+}
+
+/* Is `target` another rule's redirected path?  Upstream refuses to touch such a name (susfs.c:867-881): that name
+ * belongs to the reverse entry of an existing rule, and replacing it would silently break that rule's disguise. */
+static bool or_is_redirected_path(const char *target)
+{
+	int i;
+
+	for (i = 0; i < READ_ONCE(nor); i++) {
+		if (READ_ONCE(or_entries[i].dead))
+			continue;
+		if (!strcmp(or_entries[i].redirected_pathname, target))
+			return true;
+	}
+	return false;
+}
+
+/* ---- forward: not here any more (kernel/susfs_or_entry.c) ----
+ * The vfs_open face worked by replacing the path argument with a cached target path, which meant every rule had to keep a
+ * dentry and a mount reference alive - and those are exactly what keeps a filesystem from being unmounted while a rule
+ * points into it.  The same direction is done one layer up, at the NAME: the caller's own path is resolved with
+ * filename_lookup() (process context, before the syscall runs) and the target is opened with filp_open() and handed back
+ * as a fd.  Nothing is cached there either, so this file holds no reference of any kind any more: what remains are the
+ * numbers, the snapshot, the two names, and the three reverse faces below.
+ * Matching note that survives the move: upstream leaves the lookup loop entirely when the inode matches but the scheme
+ * does not (goto out_srcu_read_unlock, susfs.c:945/949/953/957/961), so there a non-matching entry also suppresses the
+ * remaining same-inode entries; here the first live (ino, dev) match is the only candidate - the same outcome for
+ * distinct inodes, while rules sharing one inode (hard links) differ only in which entry wins (upstream: newest
+ * hash_add_rcu first, here: slot order). */
+
+/* ---- reverse: d_path(path, buf, buflen) ----
+ * Covers readlink("/proc/<pid>/fd/N"): proc_pid_readlink() -> do_proc_readlink() -> d_path(&path, tmp, PAGE_SIZE)
+ * (fs/proc/base.c, upstream: patch:1062-1083).  Upstream replays the literal string given at add time, and so does this
+ * now: the path argument is left alone and the name d_path() produced is rewritten in the return probe.
+ *
+ * The /proc/<pid>/maps NAME column is NOT here: show_map_vma() prints it with seq_file_path() -> seq_path(), which calls
+ * __d_path() directly, never d_path() (fs/seq_file.c); a probe on __d_path registers cleanly and never fires here (full
+ * LTO inlines the primitive; measured dpath_seq=0 while the maps line still named the redirected file), so the name is
+ * rewritten out of the already-printed line - see or_maps_ret(). */
+struct or_dpath_args {
+	char *buf;
+	int buflen;
+	/* The name is COPIED here in the entry handler, not pointed at: rule slots are recycled after a
+	 * grace period (or_reclaim_slot()), and the return handler runs long after the entry handler
+	 * returned - with no rcu_read_lock in between to cover a slot being handed out again. */
+	char target[OR_PATH_MAX];
+};
+
+static int or_dpath_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	const struct path *path = (const struct path *)regs->regs[0];
+	struct or_dpath_args *a = (struct or_dpath_args *)ri->data;
+	struct inode *inode;
+	struct sus_or_entry *e;
+	bool hit = false;
+
+	a->target[0] = '\0';
+	if (!READ_ONCE(nor) || IS_ERR_OR_NULL(path) || !path->dentry)
+		return 0;
+	if (!or_reverse_visible())
+		return 0;
+	inode = d_backing_inode(path->dentry);
+	if (!inode)
+		return 0;
+
+	/* The lookup and the copy are one rcu section: that is what makes it safe for or_del() to
+	 * recycle the slot afterwards (see or_reclaim_slot()). */
+	rcu_read_lock();
+	e = or_find_by_redirected_inode(inode->i_ino, inode->i_sb->s_dev, inode->i_generation);
+	if (e && e->target_pathname[0] &&
+	    strscpy(a->target, e->target_pathname, sizeof(a->target)) >= 0)
+		hit = true;
+	rcu_read_unlock();
+	if (!hit)
+		return 0;
+
+	a->buf = (char *)regs->regs[1];
+	a->buflen = (int)regs->regs[2];
+	atomic_inc(&or_rev_dpath_hits);
+	return 0;
+}
+
+static int or_dpath_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	const struct or_dpath_args *a = (const struct or_dpath_args *)ri->data;
+	char *ret;
+
+	if (!a->target[0] || !a->buf || a->buflen <= 0)
+		return 0;
+	ret = (char *)regs->regs[0];
+	if (IS_ERR(ret))
+		return 0;		/* d_path failed: keep the error the caller expects */
+	/* Checked before writing: strscpy() truncates by filling the whole buffer and NUL-terminating
+	 * its last byte, so "it did not fit" would still have destroyed the name the kernel produced.
+	 * A target name that long leaves that name alone instead. */
+	if (strnlen(a->target, (size_t)a->buflen) >= (size_t)a->buflen)
+		return 0;
+	strscpy(a->buf, a->target, (size_t)a->buflen);
+	/* d_path() may return a pointer into the middle of the buffer (it trims a leading " (deleted)"); the rewritten name
+	 * starts at buf, so the return value has to move with it or the caller reads from the wrong offset. */
+	regs->regs[0] = (unsigned long)a->buf;
+	return 0;
+}
+
+/* ---- reverse: vfs_statfs(path, buf) ----
+ * Upstream answers statfs()/fstatfs() of the redirected file with the target's kstatfs snapshot, taken with vfs_statfs()
+ * at add time (susfs.c:1029-1046, susfs.c:851).  This does the same instead of swapping in a cached target path: the
+ * snapshot is copied into the return-probe data and written over the caller's buffer, so there is no target path to
+ * hold - which is what used to keep a filesystem busy while a rule pointed into it. */
+struct or_statfs_args {
+	struct kstatfs *buf;	/* the caller's buffer, taken in the ENTRY probe - see or_statfs_entry() */
+	struct kstatfs kstatfs;
+	bool hit;
+};
+
+static int or_statfs_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	const struct path *path = (const struct path *)regs->regs[0];
+	struct or_statfs_args *a = (struct or_statfs_args *)ri->data;
+	struct inode *inode;
+	struct sus_or_entry *e;
+
+	a->hit = false;
+	a->buf = NULL;
+	if (!READ_ONCE(nor) || IS_ERR_OR_NULL(path) || !path->dentry)
+		return 0;
+	if (!or_reverse_visible())
+		return 0;
+	inode = d_backing_inode(path->dentry);
+	if (!inode)
+		return 0;
+
+	/* One rcu section for the lookup and the snapshot copy: rule slots are recycled after a grace
+	 * period (or_reclaim_slot()), so nothing inside an entry may be read outside it. */
+	rcu_read_lock();
+	e = or_find_by_redirected_inode(inode->i_ino, inode->i_sb->s_dev, inode->i_generation);
+	if (!e) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	/* Second argument of vfs_statfs().  Read HERE, not in the return probe: a return probe only has the return value,
+	 * the argument registers belong to whatever the callee last did with them (measured on 5.15 - the rewrite went to
+	 * a stale x1 and userspace kept seeing the redirected file's own numbers). */
+	a->buf = (struct kstatfs *)regs->regs[1];
+	if (!susfs_ptr_plausible(a->buf)) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	/* The snapshot is copied here as well, not in the return probe: the entry could be rewritten in between, and the
+	 * copy is what the caller's buffer will be filled from, so it has to be one consistent moment. */
+	a->kstatfs = e->spoofed_kstatfs;
+	rcu_read_unlock();
+	a->hit = true;
+	atomic_inc(&or_rev_statfs_hits);
+	return 0;
+}
+
+static int or_statfs_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	const struct or_statfs_args *a = (const struct or_statfs_args *)ri->data;
+
+	if (!a->hit || !a->buf || (long)regs->regs[0] != 0)
+		return 0;		/* the kernel refused the statfs: its answer stands */
+	*a->buf = a->kstatfs;
+	return 0;
+}
+
+static struct kretprobe kr_or_dpath = {
+	.kp.symbol_name = "d_path",
+	.entry_handler = or_dpath_entry,
+	.handler = or_dpath_ret,
+	.data_size = sizeof(struct or_dpath_args),
+	.maxactive = 16,
+};
+
+
+static struct kretprobe kr_or_vfs_statfs = {
+	.kp.symbol_name = "vfs_statfs",
+	.entry_handler = or_statfs_entry,
+	.handler = or_statfs_ret,
+	.data_size = sizeof(struct or_statfs_args),
+	.maxactive = 16,
+};
+
+/* ---- reverse face 3: the dev:ino columns of /proc/<pid>/maps (and smaps) ----
+ * The first attempt put this on show_vma_header_prefix() - args 6 and 7 of that call ARE the two columns - and it
+ * registered and never fired once (measured: the vma_hdr counter stayed 0 over every run; clang's full LTO leaves no
+ * out-of-line copy).  So the already-formatted line is rewritten instead: its two numbers come from vma->vm_file, i.e.
+ * from the REDIRECTED inode, and replacing the "<maj>:<min> <ino>" run with the target's keeps the line consistent with
+ * the name face 1 (d_path) already disguises - without it a detector reads the target's name next to the redirected
+ * file's device, which no file on this system can produce.  The run is rendered as fs/proc/task_mmu.c does it
+ * (seq_put_hex_ll for major/minor: lowercase, min width 2; seq_put_decimal_ull for the ino), both surrounding spaces
+ * included, so pgoff and name stay safe. */
+static atomic_t or_rev_maps_hits = ATOMIC_INIT(0);
+static atomic_t or_rev_maps_rewrites = ATOMIC_INIT(0);	/* the maj:min ino run */
+static atomic_t or_rev_maps_names = ATOMIC_INIT(0);	/* the name column */
+
+struct or_maps_args {
+	struct seq_file *m;
+	struct vm_area_struct *vma;
+};
+
+static int or_maps_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	struct or_maps_args *a = (struct or_maps_args *)ri->data;
+
+	a->m = (struct seq_file *)regs->regs[0];
+	a->vma = (struct vm_area_struct *)regs->regs[1];
+	return 0;
+}
+
+/* Replace the first occurrence of old[0..old_len) in the seq_file buffer with new[0..new_len); growing is allowed as
+ * long as the buffer has room, and without room the line is left alone rather than truncated. */
+static bool or_buf_replace(struct seq_file *m, const char *old, size_t old_len,
+			   const char *new, size_t new_len)
+{
+	char *buf = m->buf;
+	size_t count = m->count, i, pos = 0;
+
+	if (!old_len || !new_len || old_len > count)
+		return false;
+	for (i = 0; i + old_len <= count; i++) {
+		if (!memcmp(buf + i, old, old_len)) {
+			pos = i;
+			break;
+		}
+	}
+	if (i + old_len > count)
+		return false;
+	if (new_len > old_len && count + (new_len - old_len) >= m->size)
+		return false;
+	if (new_len != old_len)
+		memmove(buf + pos + new_len, buf + pos + old_len, count - (pos + old_len));
+	memcpy(buf + pos, new, new_len);
+	m->count = count - old_len + new_len;
+	return true;
+}
+
+static int or_maps_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	const struct or_maps_args *a = (const struct or_maps_args *)ri->data;
+	struct seq_file *m = a->m;
+	struct vm_area_struct *vma = a->vma;
+	struct inode *inode;
+	struct sus_or_entry *e;
+	char old[48], new[48];
+	int old_len, new_len;
+
+	if (!susfs_ptr_plausible(m) || !susfs_ptr_plausible(vma) ||
+	    !m->buf || !m->count || !vma->vm_file)
+		return 0;
+	if (!or_reverse_visible())
+		return 0;
+	inode = file_inode(vma->vm_file);
+	if (!inode)
+		return 0;
+
+	/* One rcu section around the lookup and everything read from the entry: rule slots are recycled
+	 * after a grace period (or_reclaim_slot()), so nothing inside an entry may be touched outside
+	 * this section.  Nothing here sleeps - the two buffer rewrites below are memmove/memcpy. */
+	rcu_read_lock();
+	e = or_find_by_redirected_inode(inode->i_ino, inode->i_sb->s_dev, inode->i_generation);
+	if (!e) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	atomic_inc(&or_rev_maps_hits);
+
+	old_len = scnprintf(old, sizeof(old), "%02x:%02x %lu",
+			    (unsigned int)MAJOR(inode->i_sb->s_dev),
+			    (unsigned int)MINOR(inode->i_sb->s_dev),
+			    (unsigned long)inode->i_ino);
+	new_len = scnprintf(new, sizeof(new), "%02x:%02x %lu",
+			    (unsigned int)MAJOR(e->target_dev),
+			    (unsigned int)MINOR(e->target_dev),
+			    (unsigned long)e->target_ino);
+	/* Keep the column width: the kernel padded the name out to a fixed column, so a shorter run would pull the name
+	 * left - a line that does not line up with its neighbours is visible on its own. */
+	while (new_len < old_len && new_len < (int)sizeof(new) - 1)
+		new[new_len++] = ' ';
+	if (old_len > 0 && new_len > 0 &&
+	    or_buf_replace(m, old, (size_t)old_len, new, (size_t)new_len))
+		atomic_inc(&or_rev_maps_rewrites);
+
+	/* The name column as well: show_map_vma() prints it via seq_file_path()/seq_path()/__d_path(), and (see the d_path
+	 * block above) a probe on that primitive never fires here - so the rendered name is matched as the REGISTERED
+	 * redirected path, and a rule through a symlink or another mount namespace misses instead of mislabelling a file. */
+	if (e->redirected_pathname[0] && e->target_pathname[0]) {
+		size_t rlen = strlen(e->redirected_pathname);
+		size_t tlen = strlen(e->target_pathname);
+
+		if (or_buf_replace(m, e->redirected_pathname, rlen,
+				   e->target_pathname, tlen))
+			atomic_inc(&or_rev_maps_names);
+	}
+	rcu_read_unlock();
+	return 0;
+}
+
+static struct kretprobe kr_or_maps = {
+	.kp.symbol_name = "show_map_vma",	/* fs/proc/task_mmu.c */
+	.entry_handler = or_maps_entry,
+	.handler = or_maps_ret,
+	.data_size = sizeof(struct or_maps_args),
+	.maxactive = 16,
+};
+static bool or_maps_registered;
+
+/* ---- reverse face 4: /proc/<pid>/fdinfo/N ----
+ * fdinfo prints "ino:\t<i>" for the file an fd points at - for a rule, the REDIRECTED one - so a detector holding an fd
+ * on the target is handed the inode of the file the redirection really opened.  Upstream rewrites it in the same function
+ * it rewrites mnt_id in (susfs_open_redirect_spoof_seq_show, patch:1171-1200).
+ * It belongs to THIS feature, not to sus_mount's: it has to fire as soon as one rule exists, whether or not the
+ * mount-hiding switch is on.  Measured with the first version (a sus_mount seq_show kretprobe, registered only when that
+ * feature is enabled): with a rule present and hide off, fdinfo kept naming the redirected inode and the probe had
+ * entry=0.  fdinfo has no device column, so the lookup is by ino alone and refuses when two rules share a redirected ino;
+ * state is per-instance (ri->data) because seq_show() may sleep in seq_printf() and the task can migrate CPUs. */
+static atomic_t or_rev_fdinfo_hits = ATOMIC_INIT(0);
+static atomic_t or_rev_fdinfo_rewrites = ATOMIC_INIT(0);
+
+static int or_fdinfo_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	struct seq_file **slot = (struct seq_file **)ri->data;
+
+	*slot = (struct seq_file *)regs->regs[0];
+	return 0;
+}
+
+/* Find `label` in the already formatted buffer and parse the decimal that follows it; false when
+ * the label is absent or has no digits.  procfs prints inode and mount ids as unsigned long, so
+ * keep the full native width here instead of the 32-bit limit that hid large inode numbers from
+ * the rewrite. */
+static bool or_fdinfo_find_dec(struct seq_file *m, const char *label, size_t label_len,
+			       size_t *out_pos, size_t *out_len, unsigned long *out_val)
+{
+	char *buf = m->buf;
+	size_t count = m->count, i, pos = 0, len = 0;
+	unsigned long v = 0;
+
+	for (i = 0; i + label_len < count; i++) {
+		if (!memcmp(buf + i, label, label_len)) {
+			pos = i + label_len;
+			break;
+		}
+	}
+	if (!pos)
+		return false;
+	while (pos + len < count && len < sizeof(unsigned long) * 3 &&
+	       buf[pos + len] >= '0' && buf[pos + len] <= '9') {
+		v = v * 10 + (unsigned long)(buf[pos + len] - '0');
+		len++;
+	}
+	if (!len)
+		return false;
+	*out_pos = pos;
+	*out_len = len;
+	*out_val = v;
+	return true;
+}
+
+/* Write new_val over the len digits at pos, growing or shrinking as needed.  The replacement can be LONGER (measured:
+ * 926498 -> 10166500 was refused by an earlier shrink-only version, so the hook reported hits with zero rewrites);
+ * growing needs room in the seq_file buffer, and without room the line is left alone rather than truncated. */
+static bool or_fdinfo_write_dec(struct seq_file *m, size_t pos, size_t len,
+				unsigned long new_val)
+{
+	char digits[sizeof(unsigned long) * 3];
+	size_t count = m->count, i, n = 0;
+	unsigned long v = new_val;
+
+	while (v) {
+		digits[n++] = (char)('0' + v % 10);
+		v /= 10;
+	}
+	if (!n)
+		return false;
+	if (n > len && count + (n - len) >= m->size)
+		return false;
+	for (i = 0; i < n / 2; i++) {
+		char t = digits[i];
+
+		digits[i] = digits[n - 1 - i];
+		digits[n - 1 - i] = t;
+	}
+	if (n != len)
+		memmove(m->buf + pos + n, m->buf + pos + len, count - (pos + len));
+	memcpy(m->buf + pos, digits, n);
+	m->count = count - len + n;
+	return true;
+}
+
+static int or_fdinfo_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	struct seq_file *m = *(struct seq_file **)ri->data;
+	size_t pos, len;
+	unsigned long old = 0, new_ino = 0, new_mnt = 0;
+	int rewrites = 0;
+
+	if (!m || (long)regs_return_value(regs) != 0)
+		return 0;
+	if (!m->buf || !m->count)
+		return 0;
+	/* Only fdinfo's own file is rewritten, and above 5.15 this probe sits on ALL FOUR functions
+	 * named seq_show (see kr_or_fdinfo[]): the file being read is m->file, and
+	 * /proc/<pid>/fdinfo/<fd> (and .../task/<tid>/fdinfo/<fd>) has a dentry whose parent is named
+	 * "fdinfo".  The "ino:\t" / "mnt_id:\t" label tests below already make the scan a no-op for
+	 * another file; this keeps it off other files' buffers in the first place. */
+	if (!m->file || !m->file->f_path.dentry || !m->file->f_path.dentry->d_parent ||
+	    strcmp(m->file->f_path.dentry->d_parent->d_name.name, "fdinfo") != 0)
+		return 0;
+	if (!or_reverse_visible())
+		return 0;
+
+	atomic_inc(&or_rev_fdinfo_hits);
+
+	/* The ino is the rule's key and the same rule knows the target's mount id, so one lookup answers both lines.  ino
+	 * first: it sits after mnt_id in the line, so shrinking or growing it cannot move that one. */
+	if (or_fdinfo_find_dec(m, "ino:\t", 5, &pos, &len, &old) &&
+	    old && susfs_open_redirect_spoof_ids(old, &new_ino, &new_mnt) &&
+	    new_ino != old && or_fdinfo_write_dec(m, pos, len, new_ino))
+		rewrites++;
+
+	/* mnt_id, when a rule matched.  sus_mount rewrites this same label from ITS table and both probes are on the same
+	 * function, so for an fd that is both "inside a hidden mount" and "the redirected file" the two return handlers race
+	 * for which id wins - cosmetic (both are ids the caller could have been shown), and invisible in either module alone. */
+	if (new_mnt && or_fdinfo_find_dec(m, "mnt_id:\t", 8, &pos, &len, &old) &&
+	    old != new_mnt && or_fdinfo_write_dec(m, pos, len, new_mnt))
+		rewrites++;
+
+	if (rewrites)
+		atomic_inc(&or_rev_fdinfo_rewrites);
+	return 0;
+}
+
+/* fs/proc/fd.c's fdinfo callback is reached through single_open(file, seq_show, inode): no table
+ * holds its address, so it can only be found by name - and ABOVE 5.15 THE NAME IS NOT UNIQUE.  The
+ * DDK trees carry four symbols called exactly `seq_show` on android14-6.1 and android15-6.6 (one on
+ * 5.10/5.15), and register_kprobe(.symbol_name = ...) attaches to whichever kallsyms lists first.
+ * That is not a theoretical hazard: it is exactly how this rewrite silently stopped working in
+ * sus_mount on those kernels (mountinfo showed the disguised id while /proc/<pid>/fdinfo/N printed
+ * the real one - a one-file oracle), and the registration here was the same shape.  So enumerate
+ * every match and hook all of them; the return handler decides by the file it sees, which makes an
+ * unrelated seq_show cost one comparison and change nothing. */
+#define OR_FDINFO_MAX 8
+
+static struct kretprobe kr_or_fdinfo[OR_FDINFO_MAX];
+static int n_or_fdinfo_probes;
+
+static bool or_registered;
+static bool or_dpath_registered;
+static bool or_statfs_registered;
+
+/* Set by susfs_open_redirect_exit() while it holds or_lock; registration refuses afterwards.
+ * The /proc node does NOT hold a module reference (proc_create(..., NULL, ...) takes no owner),
+ * so a write that is already inside or_proc_write() can reach or_register() while the module is
+ * being torn down: without this flag the forward probe would be registered again after
+ * or_unregister() cleared or_registered, and its handler would outlive the module. */
+static bool or_exiting;
+
+/* The forward direction is the feature, but it is no longer a probe in this file: it lives at the name layer
+ * (kernel/susfs_or_entry.c, installed on the syscall entries).  A rule is useless if that layer is not armed - a rule that
+ * cannot fire is worse than no rule - so "arming" here means checking it, and the failure is reported to the caller. */
+static int or_register(void)
+{
+	if (or_exiting)
+		return -ENODEV;
+	if (or_registered)
+		return 0;
+	if (!susfs_or_entry_armed())
+		return -ENODEV;
+	or_registered = true;
+	SUSFS_LOGI("susfs_open_redirect: forward direction is the name layer (armed)\n");
+	return 0;
+}
+
+/* Reverse-disguise hooks: best effort.  The forward redirect is already live and each of these only closes one report
+ * path, so a failure must not reject the rule - but never silent either: registering proves the symbol exists, not that
+ * the kernel's call sites reach it (GKI's full LTO inlines across translation units), hence the hit counters read back
+ * from /proc/susfs_open_redirect.  Called from the rule-management paths (process context, may sleep). */
+static void or_register_reverse(void)
+{
+	int rc;
+
+	if (or_exiting)
+		return;
+
+	if (!or_dpath_registered) {
+		rc = register_kretprobe(&kr_or_dpath);
+		if (rc) {
+			susfs_krp_forget_addr(&kr_or_dpath);
+			pr_warn("open_redirect: register_kretprobe(d_path) failed %d - readlink not disguised (or already inlined)\n",
+				rc);
+		} else {
+			or_dpath_registered = true;
+			SUSFS_LOGI("susfs_open_redirect: reverse hook installed (d_path)\n");
+		}
+	}
+
+	if (!or_statfs_registered) {
+		rc = register_kretprobe(&kr_or_vfs_statfs);
+		if (rc) {
+			susfs_krp_forget_addr(&kr_or_vfs_statfs);
+			pr_warn("open_redirect: register_kretprobe(vfs_statfs) failed %d - statfs not disguised (or already inlined)\n",
+				rc);
+		} else {
+			or_statfs_registered = true;
+			SUSFS_LOGI("susfs_open_redirect: reverse hook installed (vfs_statfs)\n");
+		}
+	}
+	if (!or_maps_registered) {
+		rc = register_kretprobe(&kr_or_maps);
+		if (rc) {
+			susfs_krp_forget_addr(&kr_or_maps);
+			pr_warn("open_redirect: register_kretprobe(show_map_vma) failed %d - the maps dev:ino stays the redirected file's\n",
+				rc);
+		} else {
+			or_maps_registered = true;
+			SUSFS_LOGI("susfs_open_redirect: reverse hook installed (show_map_vma)\n");
+		}
+	}
+	if (!n_or_fdinfo_probes) {
+		unsigned long addrs[OR_FDINFO_MAX];
+		int i, n;
+
+		/* Every symbol with this name - see kr_or_fdinfo[] for why one is not enough. */
+		n = ksu_find_symbol_all("seq_show", addrs, OR_FDINFO_MAX);
+		if (n <= 0)
+			pr_warn("open_redirect: seq_show not resolved - fdinfo names the redirected inode\n");
+		for (i = 0; i < n; i++) {
+			struct kretprobe *kr = &kr_or_fdinfo[i];
+
+			kr->kp.addr = (void *)addrs[i];
+			kr->entry_handler = or_fdinfo_entry;
+			kr->handler = or_fdinfo_ret;
+			kr->data_size = sizeof(struct seq_file *);
+			kr->maxactive = 16;
+			rc = register_kretprobe(kr);
+			if (rc) {
+				pr_warn("open_redirect: register_kretprobe(seq_show @%px) failed %d\n",
+					(void *)addrs[i], rc);
+				susfs_krp_forget_addr(kr);
+				continue;
+			}
+			n_or_fdinfo_probes++;
+		}
+		if (n_or_fdinfo_probes)
+			SUSFS_LOGI("susfs_open_redirect: reverse hook installed (seq_show/fdinfo on %d/%d symbol(s))\n",
+				   n_or_fdinfo_probes, n);
+		else
+			pr_warn("open_redirect: no seq_show kretprobe could be registered - fdinfo names the redirected inode\n");
+	}
+}
+
+/* Caller MUST hold or_lock: disarming outside it is what let a concurrent or_register() put the
+ * probes back after they were removed - and those probes would then point into a module that is
+ * about to be freed.  susfs_open_redirect_exit() takes the lock and sets or_exiting before it
+ * calls this, so no registration can slip in between. */
+static void or_unregister(void)
+{
+	{
+		int i;
+
+		for (i = 0; i < OR_FDINFO_MAX; i++) {
+			if (!kr_or_fdinfo[i].kp.addr)
+				continue;
+			unregister_kretprobe(&kr_or_fdinfo[i]);
+			susfs_krp_forget_addr(&kr_or_fdinfo[i]);
+		}
+		n_or_fdinfo_probes = 0;
+	}
+	if (or_maps_registered) {
+		unregister_kretprobe(&kr_or_maps);
+		susfs_krp_forget_addr(&kr_or_maps);
+		or_maps_registered = false;
+	}
+	if (or_statfs_registered) {
+		unregister_kretprobe(&kr_or_vfs_statfs);
+		susfs_krp_forget_addr(&kr_or_vfs_statfs);
+		or_statfs_registered = false;
+	}
+	if (or_dpath_registered) {
+		unregister_kretprobe(&kr_or_dpath);
+		susfs_krp_forget_addr(&kr_or_dpath);
+		or_dpath_registered = false;
+	}
+
+	/* Nothing of the forward direction to take down: it is the name layer's hook pointer, cleared by
+	 * susfs_or_entry_exit() from this layer's exit before the reverse probes come down. */
+	or_registered = false;
+	SUSFS_LOGI("susfs_open_redirect: hooks removed\n");
+}
+
+/* ---- /proc/susfs_open_redirect ---- */
+static int or_proc_show(struct seq_file *m, void *v);
+static int or_proc_open(struct inode *inode, struct file *file);
+static ssize_t or_proc_write(struct file *file, const char __user *buf,
+			     size_t len, loff_t *off);
+
+static const struct proc_ops or_proc_ops = {
+	.proc_open = or_proc_open,
+	.proc_read = seq_read,
+	.proc_write = or_proc_write,
+	.proc_lseek = seq_lseek,
+	.proc_release = single_release,
+};
+
+static struct proc_dir_entry *or_proc_entry;
+
+int susfs_open_redirect_init(void)
+{
+	int i;
+
+	/* Every slot starts OUT of service.  The array is static, so a fresh slot would otherwise read
+	 * as dead == false - i.e. as a complete rule - and a lockless reader scans up to `nor`, which
+	 * grows before its slot is filled.  With the flag raised here, "never used" and "reclaimed" are
+	 * the same state, or_add() can publish a slot by simply growing the bound, and no reader has to
+	 * order its load of `nor` against its load of `dead` (arm64 may reorder those two loads, so a
+	 * barrier in the writer would not have been enough - see the note in or_add()). */
+	or_index_reset(&or_indexes[0], (u32)(unsigned long)&or_entries);
+	or_index_reset(&or_indexes[1], (u32)(unsigned long)&or_entries + 1);
+	or_active_index = &or_indexes[0];
+	or_rehash_count = 0;
+	for (i = 0; i < SUS_OR_MAX; i++)
+		WRITE_ONCE(or_entries[i].dead, true);
+
+	or_cred_getsecid =
+		(void *)find_kernel_symbol_exact("security_cred_getsecid");
+	if (!or_cred_getsecid)
+		pr_warn("open_redirect: security_cred_getsecid not found - schemes 1/2 will be refused\n");
+	or_resolve_su_sid();
+
+	/* Only the /proc node is optional.  This gate must never return early and skip other work: use_proc is a policy
+	 * switch, not a feature switch.  0777 so DAC passes and sus_path's LSM layer answers ENOENT;
+	 * without that layer the node would be world-writable, so it is not created at all (see susfs_kstat_init()). */
+	if (susfs_control_node_allowed()) {
+		or_proc_entry = proc_create("susfs_open_redirect", 0777, NULL,
+					    &or_proc_ops);
+		if (!or_proc_entry)
+			pr_warn("proc_create(susfs_open_redirect) failed\n");
+	} else {
+		SUSFS_LOGI("susfs_open_redirect: /proc node not created (expose_proc=%d lsm=%d)\n",
+			(int)susfs_expose_proc, (int)sus_path_lsm_active());
+	}
+
+	/* The name layer is the forward direction now, so resolve what it needs and take the target's
+	 * statfs snapshot with it.  or_register() refuses a rule while it is not armed: a rule that
+	 * cannot fire is worse than no rule.  (The boolean is the layer's state, not or_registered:
+	 * that one only flips when the first rule is added, so it reads "lazy" before then.) */
+	or_vfs_statfs_fn = (void *)find_kernel_symbol_exact("vfs_statfs");
+	if (!or_vfs_statfs_fn)
+		pr_warn("open_redirect: vfs_statfs not found - the reverse statfs face will report a zeroed snapshot\n");
+	susfs_or_entry_init();
+
+	SUSFS_LOGI("susfs_open_redirect: %d rules (forward %s, proc %d)\n", nor,
+		susfs_or_entry_armed() ? "armed" : "unavailable", or_proc_entry != NULL);
+	return 0;
+}
+
+void susfs_open_redirect_exit(void)
+{
+	int i;
+
+	/* Stop being reachable from the syscall table first: the hook pointer is cleared before the
+	 * probes come down, so no entry that is still installed can call into this layer's exit. */
+	susfs_or_entry_exit();
+
+	/* "Stop accepting registrations" and "drop the probes" are one critical section: a /proc
+	 * write holds no module reference, so it can be sitting inside or_proc_write() right now,
+	 * and it would otherwise walk into or_register() after or_unregister() had cleared
+	 * or_registered - re-registering probes with handlers that outlive the module. */
+	mutex_lock(&or_lock);
+	or_exiting = true;
+	or_unregister();
+	mutex_unlock(&or_lock);
+
+	if (or_proc_entry) {
+		proc_remove(or_proc_entry);
+		or_proc_entry = NULL;
+	}
+
+	/* Nothing can reach these any more: the probes are already gone.  There is nothing to release
+	 * either - an entry holds numbers, a kstatfs snapshot and two strings, and the paths it parsed
+	 * when it was added were dropped right there.  This used to walk the table path_put()ing each
+	 * entry's cached struct path. */
+	for (i = 0; i < READ_ONCE(nor); i++)
+		or_entries[i].dead = true;
+	for (i = 0; i < OR_HASH_BUCKETS; i++) {
+		or_active_index->buckets[i] = -1;
+		or_active_index->rev_buckets[i] = -1;
+	}
+	nor = 0;
+	or_free_n = 0;		/* nothing is left to hand out: every slot is dead again */
+	WRITE_ONCE(susfs_open_redirect_rules, 0);	/* the count the name layer reads; hook is already gone */
+}
+
+static int or_proc_show(struct seq_file *m, void *v)
+{
+	int i;
+
+	mutex_lock(&or_lock);
+	if (!susfs_open_redirect_rules) {
+		seq_puts(m, "(empty)\n");
+	} else {
+		for (i = 0; i < READ_ONCE(nor); i++) {
+			if (READ_ONCE(or_entries[i].dead))
+				continue;
+			seq_printf(m, "%s -> %s uid=%d (ino=%lu dev=%lu mnt=%lu | rev: ino=%lu dev=%lu)\n",
+				   or_entries[i].target_pathname,
+				   or_entries[i].redirected_pathname,
+				   or_entries[i].uid_scheme,
+				   or_entries[i].target_ino,
+				   (unsigned long)or_entries[i].target_dev,
+				   or_entries[i].target_mnt_id,
+				   or_entries[i].redirected_ino,
+				   (unsigned long)or_entries[i].redirected_dev);
+		}
+	}
+	/* "registered" is not "reached": a hook whose counter stays 0 across a real read means GKI inlined its call sites
+	 * and that surface is NOT disguised - hence the counters below (fdinfo's surface and provenance are in the face-4
+	 * block above).  mnt_id is NOT rewritten here: that id belongs to sus_mount's table. */
+	seq_printf(m, "hooks: forward=%d dpath=%d statfs=%d maps=%d fdinfo=%d | rev hits: dpath=%d statfs=%d maps=%d/%d/%d fdinfo=%d/%d | su_sid=%u\n",
+		   susfs_or_entry_armed(), or_dpath_registered, or_statfs_registered,
+		   or_maps_registered, n_or_fdinfo_probes > 0,
+		   atomic_read(&or_rev_dpath_hits),
+		   atomic_read(&or_rev_statfs_hits),
+		   atomic_read(&or_rev_maps_hits),
+		   atomic_read(&or_rev_maps_rewrites),
+		   atomic_read(&or_rev_maps_names),
+		   atomic_read(&or_rev_fdinfo_hits),
+		   atomic_read(&or_rev_fdinfo_rewrites),
+		   or_su_sid);
+	mutex_unlock(&or_lock);
+	return 0;
+}
+
+static int or_proc_open(struct inode *inode, struct file *file)
+{
+	/* 0777 is deliberate (the ENOENT contract comes from sus_path's hidden set, not from the mode), so refuse non-root
+	 * callers here too - see the note in susfs_enable_log.c's log_proc_open(). */
+	if (!susfs_control_visible())
+		return -ENOENT;
+	return single_open(file, or_proc_show, NULL);
+}
+
+static int split_ws(char *buf, char **argv, int max)
+{
+	int argc = 0;
+	char *p = buf;
+
+	while (argc < max) {
+		while (*p == ' ' || *p == '\t' || *p == '\n')
+			p++;
+		if (*p == '\0')
+			break;
+		argv[argc++] = p;
+		while (*p && *p != ' ' && *p != '\t' && *p != '\n')
+			p++;
+		if (*p)
+			*p++ = '\0';
+	}
+	return argc;
+}
+
+static void or_reclaim_slot(struct sus_or_entry *e);
+
+static int or_add(const char *target, const char *redirected, int scheme)
+{
+	struct sus_or_entry *e;
+	struct path tp, rp;
+	struct inode *ti, *ri;
+	struct kstatfs spoofed_kstatfs;
+	int rc;
+
+	/* upstream susfs.c:792-796 */
+	if (scheme < UID_NON_APP_PROC || scheme > UID_UMOUNTED_PROC)
+		return -EINVAL;
+
+	/* Both come from char[256] ABI fields (supercall) or a NUL-terminated command buffer (proc write); reject the
+	 * unterminated case instead of letting strcmp()/kern_path() read past the struct or truncate a path into a rule. */
+	if (!susfs_abi_path_ok(target, OR_PATH_MAX) ||
+	    !susfs_abi_path_ok(redirected, OR_PATH_MAX))
+		return -ENAMETOOLONG;
+
+	rc = kern_path(target, LOOKUP_FOLLOW, &tp);
+	if (rc)
+		return rc;
+	/* The statfs snapshot the reverse face answers from, taken here while the target's path is in
+	 * hand.  The path itself is dropped before this function returns; only the snapshot stays. */
+	memset(&spoofed_kstatfs, 0, sizeof(spoofed_kstatfs));
+	(void)or_statfs_snapshot(&tp, &spoofed_kstatfs);
+	ti = d_backing_inode(tp.dentry);
+	if (!ti) {
+		path_put(&tp);
+		return -ENOENT;
+	}
+
+	/* resolve redirected; only its numbers are kept (nothing is cached any more) */
+	rc = kern_path(redirected, LOOKUP_FOLLOW, &rp);
+	if (rc) {
+		path_put(&tp);
+		return rc;
+	}
+	ri = d_backing_inode(rp.dentry);
+	if (!ri) {
+		path_put(&rp);
+		path_put(&tp);
+		return -ENOENT;
+	}
+
+	/* upstream susfs.c:824-829 - FUSE is refused outright, on either side, and rejecting is the whole handling: no
+	 * silent rewrite, no partial rule.  (d_sb is the dentry's superblock: what upstream reads through inode->i_sb.) */
+	if (tp.dentry->d_sb->s_magic == FUSE_SUPER_MAGIC ||
+	    rp.dentry->d_sb->s_magic == FUSE_SUPER_MAGIC) {
+		pr_warn("open_redirect: FUSE fs is not supported for open_redirect feature\n");
+		path_put(&rp);
+		path_put(&tp);
+		return -EINVAL;
+	}
+
+	/* Schemes 1 and 2 are decisions about the KernelSU su domain.  Upstream always has that sid (KernelSU hands it
+	 * over at setuid-hook setup), an LKM resolves the context itself - and if it does not resolve, "not in su domain"
+	 * is true for the su process too, i.e. the one process the rule exists to spare would be redirected.  Refuse. */
+	if (scheme == UID_ROOT_PROC_EXCEPT_SU_PROC ||
+	    scheme == UID_NON_SU_PROC) {
+		or_resolve_su_sid();
+		if (!or_su_sid) {
+			pr_warn("open_redirect: scheme %d needs a resolvable su domain - set or_su_ctx=u:r:su:s0 (currently \"%s\")\n",
+				scheme, or_su_ctx);
+			path_put(&rp);
+			path_put(&tp);
+			return -EOPNOTSUPP;
+		}
+	}
+
+	/* Register the hooks BEFORE touching any entry: a rule that is listed but cannot fire (hook missing) silently does
+	 * nothing while looking configured - worse than no rule at all. */
+	rc = or_register();
+	if (rc) {
+		path_put(&rp);
+		path_put(&tp);
+		pr_warn("open_redirect: hook registration failed %d\n", rc);
+		return rc;
+	}
+	or_register_reverse();
+
+	/* upstream susfs.c:867-881: a name that another rule already uses as its redirected path belongs to that rule's
+	 * reverse entry and must not be taken over. */
+	e = or_find_by_path(target);
+	if (!e && or_is_redirected_path(target)) {
+		pr_warn("open_redirect: '%s' cannot be added because it is used for reversed lookup only\n",
+			target);
+		path_put(&rp);
+		path_put(&tp);
+		return -EINVAL;
+	}
+
+	/* Capacity is checked before anything is retired, so a full table cannot silently kill the rule
+	 * that was working: the only way to fail here is a NEW rule with no free slot and no unused slot
+	 * left.  Rewriting an existing rule takes the slot the rewrite releases, so it never fails on
+	 * capacity - see the reclaim below. */
+	if (!e && !or_free_n && nor >= SUS_OR_MAX) {
+		path_put(&rp);
+		path_put(&tp);
+		return -ENOSPC;
+	}
+
+	if (e) {
+		/* Rewriting a rule: take the old slot back (grace period included), which is also what makes
+		 * the new entry possible even with every slot in use.  The live count does not change (one
+		 * rule out, one in below), so it is only touched in the branch that adds a rule. */
+		or_reclaim_slot(e);
+		e = NULL;
+	} else {
+		/* A new rule: make it visible to the name-layer hook before the slot itself is filled.  That is the safe
+		 * direction - the hook then resolves one name it would not have had to resolve, instead of missing a rule. */
+		WRITE_ONCE(susfs_open_redirect_rules, READ_ONCE(susfs_open_redirect_rules) + 1);
+	}
+
+	/* A reclaimed slot first, a never-used one otherwise.  Both are already out of service (dead is
+	 * raised for every slot in susfs_open_redirect_init() and stays raised while a slot is on the
+	 * free list), so growing the bound cannot publish a half-written entry: a lockless reader that
+	 * sees the new `nor` finds dead == true and skips the slot.  Ordering the flag against the bound
+	 * was tried and is not enough on arm64, which may reorder the reader's load of `nor` against its
+	 * load of `dead` - raising the flag up front is what removes the window instead of narrowing
+	 * it. */
+	if (or_free_n) {
+		e = &or_entries[or_free[--or_free_n]];
+	} else {
+		e = &or_entries[nor++];
+	}
+
+	/* Then fill it in, and publish by clearing the flag last.  Every field is written before that
+	 * store, the snapshot and both pathnames included - so a reader that passed its own `dead` check
+	 * sees a complete rule. */
+	strscpy(e->target_pathname, target, OR_PATH_MAX);
+	strscpy(e->redirected_pathname, redirected, OR_PATH_MAX);
+	e->target_ino = ti->i_ino;
+	e->target_dev = ti->i_sb->s_dev;
+	e->target_igen = ti->i_generation;
+	e->target_mnt_id = (unsigned long)real_mount(tp.mnt)->mnt_id;
+	e->redirected_ino = ri->i_ino;
+	e->redirected_dev = ri->i_sb->s_dev;
+	e->redirected_igen = ri->i_generation;
+	e->spoofed_kstatfs = spoofed_kstatfs;
+	e->uid_scheme = scheme;
+
+	WRITE_ONCE(e->dead, false);	/* fields are complete before the index publishes it */
+	or_link(e);
+
+	/* Both parsed paths are dropped right here: the entry keeps the numbers and the snapshot, and
+	 * the names as strings, so the rule holds nothing that a filesystem teardown would wait for. */
+	path_put(&rp);
+	path_put(&tp);
+	return 0;
+}
+
+/* The second half of a reclaim, without the wait: clear a slot that nobody can be looking at any more
+ * and put it back on the free list.  Split out so or_clear_all() can pay for one grace period for all
+ * the rules it drops instead of one each.
+ *
+ * The caller MUST have raised `dead` and waited a grace period before calling this: the flag is what
+ * stops a NEW reader from matching the slot, and the wait is what covers the readers that got past it
+ * (they copy what they need out of the entry while they hold rcu_read_lock).  The assertion below
+ * states that requirement instead of raising the flag here, because raising it here would silently
+ * accept a caller that skipped the wait. */
+static void or_release_slot(struct sus_or_entry *e)
+{
+	WARN_ON_ONCE(!READ_ONCE(e->dead));
+
+	e->target_pathname[0] = '\0';
+	e->redirected_pathname[0] = '\0';
+	e->target_ino = 0;
+	e->target_dev = 0;
+	e->target_igen = 0;
+	e->target_mnt_id = 0;
+	e->redirected_ino = 0;
+	e->redirected_dev = 0;
+	e->redirected_igen = 0;
+	memset(&e->spoofed_kstatfs, 0, sizeof(e->spoofed_kstatfs));
+	e->uid_scheme = 0;
+	smp_wmb();
+	/* Cannot overflow while the accounting is right: only a live slot is pushed, and a live slot is
+	 * off the list until it is handed out again.  The check is here so a future path that frees the
+	 * same slot twice says so instead of writing past the array - or_free_n sits right after it. */
+	WARN_ON_ONCE(or_free_n >= SUS_OR_MAX);
+	if (or_free_n < SUS_OR_MAX)
+		or_free[or_free_n++] = (unsigned int)(e - or_entries);
+}
+
+/* Retire one slot: raise the flag, wait a grace period, then clear and free it.  The wait is the whole
+ * point - every reader copies what it needs out of an entry inside its own rcu_read_lock (the
+ * name-layer hook copies the target name, the d_path face copies it into the probe's per-instance
+ * data, the statfs face copies the snapshot, the maps and fdinfo faces rewrite the formatted line
+ * before they leave), so once synchronize_rcu() returns nobody can still be looking at these fields.
+ *
+ * Called with or_lock held, i.e. from process context: it sleeps, and that is fine because the only
+ * callers are the rule-management paths (a /proc write or the supercall).  Nothing else may hold a
+ * pointer into the table across a sleep. */
+static void or_reclaim_slot(struct sus_or_entry *e)
+{
+	or_unlink(e);
+	WRITE_ONCE(e->dead, true);
+	smp_wmb();
+	synchronize_rcu();
+	or_release_slot(e);
+}
+
+/* Drop every rule at once - the "clear" command.  One grace period covers all of them: the slots are
+ * marked dead first, so a reader inside its rcu section has either already copied what it needs or
+ * skips them, and after synchronize_rcu() the fields can be cleared and the slots handed out again.
+ * Called with or_lock held (it sleeps), like or_reclaim_slot() - and unlike a loop over or_del() it
+ * waits once, not once per rule, and never hands a callee the inside of a table it is clearing. */
+static void or_clear_all(void)
+{
+	bool marked[SUS_OR_MAX] = { false };
+	bool any = false;
+	int i;
+
+	for (i = 0; i < nor; i++) {
+		if (READ_ONCE(or_entries[i].dead))
+			continue;
+		WRITE_ONCE(or_entries[i].dead, true);
+		marked[i] = true;
+		any = true;
+	}
+
+	/* The live count drops before the wait, not after: the name-layer hook reads it on every open, and
+	 * every rule is already dead at this point - a lookup during the grace period would only resolve a
+	 * name to find nothing.  The buckets are emptied here too; a reader that already took a head keeps
+	 * walking the stable entries until the grace period below. */
+	WRITE_ONCE(susfs_open_redirect_rules, 0);
+	for (i = 0; i < OR_HASH_BUCKETS; i++) {
+		WRITE_ONCE(or_active_index->buckets[i], -1);
+		WRITE_ONCE(or_active_index->rev_buckets[i], -1);
+	}
+
+	if (any) {
+		smp_wmb();
+		synchronize_rcu();
+		for (i = 0; i < nor; i++) {
+			if (marked[i])
+				or_release_slot(&or_entries[i]);
+		}
+	}
+}
+
+/* Only the rules whose target path matches are dropped; the reverse entry is not
+ * a separate object here, so it goes with the rule by definition. */
+static void or_del(const char *target)
+{
+	struct sus_or_entry *e;
+
+	e = or_find_by_path(target);
+	if (!e || READ_ONCE(e->dead))
+		return;
+
+	/* The slot goes back to the free list after a grace period, so the fields may be cleared and the
+	 * slot handed out again - the pointers this used to leave behind are gone (see or_reclaim_slot()),
+	 * and a name that a reader is still looking at is safe because every reader copies it out under
+	 * rcu_read_lock. */
+	or_reclaim_slot(e);
+
+	if (READ_ONCE(susfs_open_redirect_rules))
+		WRITE_ONCE(susfs_open_redirect_rules, READ_ONCE(susfs_open_redirect_rules) - 1);
+}
+
+/* Slots are never compacted (that array move was itself part of the race).  The kprobes stay registered for the whole
+ * module lifetime: unregistering and re-registering them was observed to leave the hook silently gone after a burst of
+ * add/del cycles, while an empty rule table already makes the lookups miss - so staying registered costs nothing. */
+
+static ssize_t or_proc_write(struct file *file, const char __user *buf,
+			     size_t len, loff_t *off)
+{
+	char cmd[640];
+	char *argv[8];
+	int argc, err;
+	long scheme;
+
+	/* Same gate as or_proc_open(): an fd opened before the opener dropped privileges must not become a way in. */
+	if (!susfs_control_visible())
+		return -ENOENT;
+
+	if (len >= sizeof(cmd))
+		len = sizeof(cmd) - 1;
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+	cmd[len] = 0;
+
+	argc = split_ws(cmd, argv, 8);
+	if (argc == 0)
+		return len;
+
+	mutex_lock(&or_lock);
+	err = -EINVAL;
+
+	if (!strcmp(argv[0], "add_open_redirect") && argc == 4) {
+		if (kstrtol(argv[3], 10, &scheme))
+			err = -EINVAL;
+		else
+			err = or_add(argv[1], argv[2], (int)scheme);
+	} else if (!strcmp(argv[0], "del") && argc == 2) {
+		or_del(argv[1]);
+		err = 0;
+	} else if (!strcmp(argv[0], "clear")) {
+		/* All rules at once: mark every live slot dead, wait ONE grace period for the readers, then
+		 * clear them and put them on the free list.  Going through or_del() per rule would wait a
+		 * grace period per rule with the rule lock held, and it would hand the inside of the table to
+		 * a callee that clears the very slot it was given. */
+		or_clear_all();
+		err = 0;
+	}
+
+	mutex_unlock(&or_lock);
+
+	if (err) {
+		pr_warn("open_redirect proc write '%s' -> err %d\n", argv[0], err);
+		return err;	/* surface the failure; success keeps returning len */
+	}
+	return len;
+}
+
+/* supercall: CMD_SUSFS_ADD_OPEN_REDIRECT */
+void susfs_open_redirect_supercall(void __user **arg)
+{
+	struct st_susfs_open_redirect info = {0};
+	int err;
+
+	if (copy_from_user(&info, (void __user *)*arg, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out;
+	}
+
+	mutex_lock(&or_lock);
+	err = or_add(info.target_pathname, info.redirected_pathname,
+		     info.uid_scheme);
+	mutex_unlock(&or_lock);
+	info.err = err;
+out:
+	/* upstream writes back only ->err for input-type commands */
+	if (copy_to_user(&((struct st_susfs_open_redirect __user *)*arg)->err,
+			 &info.err, sizeof(info.err)))
+		pr_warn("open_redirect supercall copy_to_user failed\n");
+}
diff --git a/KernelSU/kernel/susfs/susfs_open_view.h b/KernelSU/kernel/susfs/susfs_open_view.h
new file mode 100644
index 000000000000..628678dc793b
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_open_view.h
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * susfs_open_view.h - value-only view for the open entry
+ *
+ * L decides only whether the syscall shape can be taken over by the name
+ * layer.  Rule lookup and the actual redirect stay in P.
+ */
+
+#ifndef __SUSFS_OPEN_VIEW_H
+#define __SUSFS_OPEN_VIEW_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/fcntl.h>
+#else
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/types.h>
+typedef uint64_t u64;
+typedef uint32_t u32;
+#ifndef O_DIRECTORY
+#define O_DIRECTORY 00200000
+#endif
+#ifndef O_NOFOLLOW
+#define O_NOFOLLOW 00400000
+#endif
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 02000000
+#endif
+#ifndef O_PATH
+#define O_PATH 010000000
+#endif
+#ifndef __O_TMPFILE
+#define __O_TMPFILE 020000000
+#endif
+#endif
+
+enum susfs_open_kind {
+	SUSFS_OPEN_OPENAT,
+	SUSFS_OPEN_OPENAT2,
+	SUSFS_OPEN_COMPAT_OPEN,
+	SUSFS_OPEN_COMPAT_OPENAT,
+	SUSFS_OPEN_COMPAT_OPENAT2,
+};
+
+enum susfs_open_action {
+	SUSFS_OPEN_PASS,
+	SUSFS_OPEN_TAKE,
+};
+
+#define SUSFS_OPEN_PATH_FLAGS (O_DIRECTORY | O_NOFOLLOW | O_PATH | O_CLOEXEC)
+#define SUSFS_OPEN_RESOLVE_NO_XDEV	0x01
+#define SUSFS_OPEN_RESOLVE_NO_MAGICLINKS	0x02
+#define SUSFS_OPEN_RESOLVE_NO_SYMLINKS	0x04
+#define SUSFS_OPEN_RESOLVE_BENEATH	0x08
+#define SUSFS_OPEN_RESOLVE_IN_ROOT	0x10
+#define SUSFS_OPEN_RESOLVE_CACHED	0x20
+#define SUSFS_OPEN_REDIRECT_MAX 256
+#define SUSFS_OPEN_KNOWN_RESOLVE					 \
+	(SUSFS_OPEN_RESOLVE_NO_XDEV | SUSFS_OPEN_RESOLVE_NO_MAGICLINKS | \
+	 SUSFS_OPEN_RESOLVE_NO_SYMLINKS | SUSFS_OPEN_RESOLVE_BENEATH |	 \
+	 SUSFS_OPEN_RESOLVE_IN_ROOT | SUSFS_OPEN_RESOLVE_CACHED)
+
+struct susfs_open_view {
+	enum susfs_open_kind kind;
+	unsigned long flags;
+	u64 resolve;
+	unsigned int mode;
+	bool valid;
+	bool mode_valid;
+	bool resolve_supported;
+
+	bool rule_matched;
+	int uid_scheme;
+	char redirected[SUSFS_OPEN_REDIRECT_MAX];
+	u32 caller_uid;
+	bool caller_in_su_domain;
+	bool caller_is_umounted_app;
+	bool caller_is_umounted;
+};
+
+static inline enum susfs_open_action
+susfs_open_decide_core(const struct susfs_open_view *v)
+{
+	unsigned long flags;
+
+	if (!v || !v->valid)
+		return SUSFS_OPEN_PASS;
+
+	flags = v->flags;
+	if (flags & O_PATH)
+		flags &= SUSFS_OPEN_PATH_FLAGS;
+
+	if (flags & __O_TMPFILE)
+		return SUSFS_OPEN_PASS;
+
+	if (v->kind == SUSFS_OPEN_OPENAT2 ||
+	    v->kind == SUSFS_OPEN_COMPAT_OPENAT2) {
+		if (!v->resolve_supported)
+			return SUSFS_OPEN_PASS;
+		if (v->resolve & ~SUSFS_OPEN_KNOWN_RESOLVE)
+			return SUSFS_OPEN_PASS;
+		if ((v->resolve & SUSFS_OPEN_RESOLVE_BENEATH) &&
+		    (v->resolve & SUSFS_OPEN_RESOLVE_IN_ROOT))
+			return SUSFS_OPEN_PASS;
+		if ((v->resolve & SUSFS_OPEN_RESOLVE_CACHED) &&
+		    (flags & (O_TRUNC | O_CREAT | __O_TMPFILE)))
+			return SUSFS_OPEN_PASS;
+		if (!v->mode_valid)
+			return SUSFS_OPEN_PASS;
+	}
+
+	if (!v->rule_matched)
+		return SUSFS_OPEN_TAKE;
+
+	switch (v->uid_scheme) {
+	case 0:	/* UID_NON_APP_PROC */
+		if (v->caller_uid % 100000 >= 10000)
+			return SUSFS_OPEN_PASS;
+		break;
+	case 1:	/* UID_ROOT_PROC_EXCEPT_SU_PROC */
+		if (v->caller_uid != 0 || v->caller_in_su_domain)
+			return SUSFS_OPEN_PASS;
+		break;
+	case 2:	/* UID_NON_SU_PROC */
+		if (v->caller_in_su_domain)
+			return SUSFS_OPEN_PASS;
+		break;
+	case 3:	/* UID_UMOUNTED_APP_PROC */
+		if (!v->caller_is_umounted_app)
+			return SUSFS_OPEN_PASS;
+		break;
+	case 4:	/* UID_UMOUNTED_PROC */
+		if (!v->caller_is_umounted)
+			return SUSFS_OPEN_PASS;
+		break;
+	default:
+		return SUSFS_OPEN_PASS;
+	}
+
+	return SUSFS_OPEN_TAKE;
+}
+
+#endif /* __SUSFS_OPEN_VIEW_H */
diff --git a/KernelSU/kernel/susfs/susfs_or_entry.c b/KernelSU/kernel/susfs/susfs_or_entry.c
new file mode 100644
index 000000000000..eb47363ab62c
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_or_entry.c
@@ -0,0 +1,540 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_or_entry.c - open_redirect's forward direction, done at the NAME layer.
+ *
+ * Why this exists: the vfs_open kprobe has to keep a cached struct path per rule, because by the
+ * time vfs_open runs the name is already resolved and nothing can sleep there.  Cached dentry and
+ * mount references are what stop a filesystem teardown from finishing while a rule points into it.
+ * Upstream has no such problem because it patches do_sys_openat2, where it simply builds a new
+ * struct filename from the stored string; those symbols are LTO-inlined here and cannot be probed,
+ * but the syscall entry can be replaced - susfs_opath.c already replaces exactly the five entries
+ * this needs - so the same thing can be done at the same layer as upstream.
+ *
+ * What it does per matching open, in process context before the syscall runs:
+ *   getname_flags() + filename_lookup()  -> which inode is the caller opening (relative paths too)
+ *   susfs_open_redirect_match_path()     -> is that the target of a live rule, and where does it go
+ *   filp_open()                          -> open the target ourselves
+ *   get_unused_fd_flags() + fd_install() -> hand the caller a fd, exactly like the syscall would
+ *   and return the fd instead of running the original syscall.
+ *
+ * Nothing is cached, so a rule holds no reference of any kind: this is what makes open_redirect
+ * stop mattering to umount.  The functions are resolved by name (filp_open, get_unused_fd_flags and
+ * fd_install are exported, getname_flags, filename_lookup and putname are not) and the layer stays
+ * off if any of them is missing.
+ *
+ * Skipping the original syscall means whatever do_sys_openat2() would have done around the open has
+ * to be done here as well.  Two things are: the arm64 O_LARGEFILE bit the syscall adds on the entries
+ * that set it (otherwise every redirected fd differs from every other fd in one bit that
+ * fcntl(F_GETFL) and the fdinfo `flags:` line both read), and the IN_OPEN notification where the
+ * kernel happens to have an out-of-line fsnotify_open() - it is a static inline on every tree, and
+ * the log says so where it is missing.  What is deliberately NOT reproduced, and is therefore handed
+ * back to the kernel instead:
+ *   - the flags openat2 would refuse (it validates its structure field by field, where the older
+ *     entries clean invalid values up and carry on), along with its `resolve`/`usize` (EINVAL/E2BIG,
+ *     and RESOLVE_* is applied during the walk) - finishing such an open would answer success where
+ *     the kernel answers an error, or answer with weaker semantics;
+ *   - O_TMPFILE, which is not a path open in the sense filp_open() models.
+ * Not covered at all, by construction: this is a syscall entry, so covers openat/openat2 and the
+ * three compat variants.  io_uring's OPENAT/OPENAT2, AArch32 `creat`, open_by_handle_at, execve and
+ * in-kernel filp_open() callers never come through here (upstream's do_sys_openat2 patch has the same
+ * boundary except for compat `creat`, which upstream also misses).
+ *
+ * On by default (module parameter or_entry).  It used to be opt-in, back when the vfs_open probe was
+ * still the default forward direction; that probe is gone, so this layer IS the forward direction -
+ * which is also why or_register() refuses a rule while it is not armed, and why an unarmed layer
+ * says so in the log instead of failing silently.
+ */
+#include <linux/kernel.h>
+#include <linux/version.h>	/* LINUX_VERSION_CODE: fsnotify_open() moved into the open path at 6.6 */
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/file.h>
+#include <linux/fcntl.h>	/* AT_FDCWD, O_CLOEXEC, __O_TMPFILE */
+#include <linux/path.h>		/* path_put() */
+#include <linux/namei.h>	/* getname_flags/filename_lookup prototypes, LOOKUP_FOLLOW */
+#include <linux/dcache.h>
+#include <linux/mount.h>
+#include <linux/uaccess.h>
+#include <linux/err.h>
+#include <linux/atomic.h>
+#include <linux/limits.h>
+#include "susfs.h"
+#include "susfs_log.h"
+#include "symbol_resolver.h"
+#include "susfs_or_entry.h"
+#include "susfs_open_data.h"
+#include "susfs_open_view.h"
+#include "ksu_umount_gate.h"
+
+/* include/uapi/linux/openat2.h: three u64 fields, identical on both ABIs we build for. */
+struct susfs_open_how {
+	__u64 flags;
+	__u64 mode;
+	__u64 resolve;
+};
+
+/* The flag set the kernel's own build_open_flags() accepts (fs/open.c VALID_OPEN_FLAGS, which is
+ * built from exactly these uapi bits).  A flag outside it makes the kernel return EINVAL, so such a
+ * call is handed back rather than answered: filp_open() masks unknown bits away and would turn that
+ * EINVAL into a successful open.  This is deliberately the conservative direction - a bit that is
+ * legal on some kernel but missing here only means that open is not redirected. */
+#define SUSFS_OR_KNOWN_FLAGS							\
+	(O_RDONLY | O_WRONLY | O_RDWR | O_CREAT | O_EXCL | O_NOCTTY | O_TRUNC |	\
+	 O_APPEND | O_NONBLOCK | O_NDELAY | __O_SYNC | O_DSYNC | FASYNC |	\
+	 O_DIRECT | O_LARGEFILE | O_DIRECTORY | O_NOFOLLOW | O_NOATIME |		\
+	 O_CLOEXEC | O_PATH | __O_TMPFILE)
+
+/* fs/open.c's own O_PATH_FLAGS, and what build_open_how() narrows the flags to whenever O_PATH is
+ * present ("O_PATH beats everything else.").  Only these four bits survive that narrowing, so
+ * everything a caller sends alongside O_PATH - O_CREAT, O_EXCL, O_TRUNC - is gone before the kernel
+ * works out the lookup flags of the call.  It lives as a #define inside fs/open.c rather than in a
+ * header, hence spelled out here; O_CLOEXEC being in the set is also why a descriptor's own flag
+ * survives the narrowing. */
+#define SUSFS_OR_PATH_FLAGS	(O_DIRECTORY | O_NOFOLLOW | O_PATH | O_CLOEXEC)
+
+/* openat2's resolve bits (uapi/linux/openat2.h) and the lookup flags the kernel turns them into. */
+#define SUSFS_RESOLVE_NO_XDEV		0x01
+#define SUSFS_RESOLVE_NO_MAGICLINKS	0x02
+#define SUSFS_RESOLVE_NO_SYMLINKS	0x04
+#define SUSFS_RESOLVE_BENEATH		0x08
+#define SUSFS_RESOLVE_IN_ROOT		0x10
+#define SUSFS_RESOLVE_CACHED		0x20
+#define SUSFS_OR_KNOWN_RESOLVE							\
+	(SUSFS_RESOLVE_NO_XDEV | SUSFS_RESOLVE_NO_MAGICLINKS |			\
+	 SUSFS_RESOLVE_NO_SYMLINKS | SUSFS_RESOLVE_BENEATH |			\
+	 SUSFS_RESOLVE_IN_ROOT | SUSFS_RESOLVE_CACHED)
+
+/* The lookup flags for the source path, translated the way the kernel translates them for the open
+ * it would have done (fs/open.c, before do_filp_open): O_NOFOLLOW stops at the last component and
+ * O_CREAT|O_EXCL implies it, O_DIRECTORY demands a directory, and openat2's resolve bits map onto
+ * the matching LOOKUP_* bits.  A resolve bit this kernel has no lookup flag for (LOOKUP_CACHED
+ * arrived later than the others) is not mapped - the caller then gets a lookup with weaker
+ * semantics, which is why or_entry_redirect() rejects those calls instead of answering them. */
+static unsigned int or_lookup_flags(unsigned long flags, unsigned long resolve)
+{
+	unsigned int lflags = 0;
+
+	if (!(flags & O_NOFOLLOW) &&
+	    (flags & (O_CREAT | O_EXCL)) != (O_CREAT | O_EXCL))
+		lflags |= LOOKUP_FOLLOW;
+	if (flags & O_DIRECTORY)
+		lflags |= LOOKUP_DIRECTORY;
+	if (resolve & SUSFS_RESOLVE_NO_XDEV)
+		lflags |= LOOKUP_NO_XDEV;
+	if (resolve & SUSFS_RESOLVE_NO_MAGICLINKS)
+		lflags |= LOOKUP_NO_MAGICLINKS;
+	if (resolve & SUSFS_RESOLVE_NO_SYMLINKS)
+		lflags |= LOOKUP_NO_SYMLINKS;
+	if (resolve & SUSFS_RESOLVE_BENEATH)
+		lflags |= LOOKUP_BENEATH;
+	if (resolve & SUSFS_RESOLVE_IN_ROOT)
+		lflags |= LOOKUP_IN_ROOT;
+#ifdef LOOKUP_CACHED
+	if (resolve & SUSFS_RESOLVE_CACHED)
+		lflags |= LOOKUP_CACHED;
+#endif
+	return lflags;
+}
+
+/* Every one of these is resolved by name at load; see the header comment for which are exported. */
+static struct filename *(*or_getname_flags_fn)(const char __user *name, int flags, int *empty);
+static int (*or_filename_lookup_fn)(int dfd, struct filename *name, unsigned flags,
+				    struct path *path, struct path *root);
+static void (*or_putname_fn)(struct filename *name);
+static struct file *(*or_filp_open_fn)(const char *name, int flags, umode_t mode);
+static int (*or_get_unused_fd_flags_fn)(unsigned flags);
+static void (*or_fd_install_fn)(unsigned int fd, struct file *file);
+static void (*or_put_unused_fd_fn)(unsigned int fd);
+static void (*or_fsnotify_open_fn)(struct file *file);
+static int (*or_check_zeroed_user_fn)(const void __user *from, unsigned long count);
+
+static bool or_entry_ready;
+static atomic_t or_entry_hits = ATOMIC_INIT(0);
+
+/* On by default: this IS the forward direction now (the vfs_open probe is gone from
+ * susfs_open_redirect.c).  Off means the layer is not armed at all - see
+ * susfs_or_entry_init() - so a rule is refused rather than accepted and inert. */
+static bool or_entry_param = true;
+module_param_named(or_entry, or_entry_param, bool, 0600);
+
+susfs_or_entry_fn_t susfs_or_entry_hook;
+
+/* Indirect call into the kernel for the one notification the skipped syscall would have sent, so it
+ * sits in a __nocfi noinline function like every other one in this module (tools/cfi_sites.py fails
+ * the build on an instrumented call site).  A kernel without the symbol only loses the notification,
+ * which is why this one may be NULL. */
+static __nocfi noinline void or_fsnotify_open(struct file *file)
+{
+	if (or_fsnotify_open_fn)
+		or_fsnotify_open_fn(file);
+}
+
+/* Same shape for copy_struct_from_user()'s zero check: it is the helper openat2 uses to accept a
+ * structure larger than this kernel's, and it is a real exported symbol even though the macro that
+ * calls it is not. */
+static __nocfi noinline int or_check_zeroed_user(const void __user *from, unsigned long count)
+{
+	return or_check_zeroed_user_fn(from, count);
+}
+
+/* The undo of get_unused_fd_flags(): needed to keep the kernel's own order (descriptor first, file
+ * second), where a failed open leaves nothing behind. */
+static __nocfi noinline void or_put_unused_fd(unsigned int fd)
+{
+	or_put_unused_fd_fn(fd);
+}
+
+/* The original syscall is not called at all when this redirects, so nothing has to be undone if the
+ * process is killed mid-way; the fd is installed last, which is the same order the kernel uses.
+ *
+ * __nocfi noinline is mandatory for every call through a runtime-resolved pointer (the rule
+ * tools/cfi_sites.py enforces on the artifacts): without it, CFI instrumentation lands in whichever
+ * function this ends up in - the opath wrapper - and a checked indirect call into the kernel is a
+ * panic rather than an error return.  This is also why every kernel function above is held in a
+ * plain pointer and called from here, never from the wrapper itself. */
+static __nocfi noinline long or_entry_redirect(const struct pt_regs *regs, int kind)
+{
+	const char __user *uname = NULL;
+	unsigned long flags = 0, mode = 0, resolve = 0, usize = 0, o2flags = 0;
+	/* The descriptor's own flag, kept out of the narrowing the file flags go through: the kernel
+	 * takes it from the UNSTRIPPED flags when it allocates a descriptor (do_sys_openat2():
+	 * get_unused_fd_flags(how->flags), where alloc_fd() reads O_CLOEXEC), and losing it hands back a fd that survives
+	 * execve - a difference one fcntl(F_GETFD) reads. */
+	unsigned int fd_cloexec = 0;
+	struct susfs_open_how how;
+	struct filename *name;
+	struct path path;
+	char target[SUSFS_OR_PATH_MAX];	/* filled by susfs_open_rule_facts_path() under rcu */
+	struct susfs_open_view ov;
+	struct susfs_open_rule_facts rf;
+	struct file *f;
+	int dfd = AT_FDCWD;
+	long res;
+	int fd;
+
+	if (!or_entry_ready)
+		return SUSFS_OR_ENTRY_PASS;
+
+	/* This hook is reached for every open() on the system, so the empty case has to be one load: no
+	 * live rules means nothing to resolve a name for, and deleting the last rule takes that cost away
+	 * again (susfs_open_redirect_rules counts live rules, not rules ever added). */
+	if (!susfs_open_redirect_active())
+		return SUSFS_OR_ENTRY_PASS;
+
+	/* arm64 keeps a syscall's arguments in regs[0..5] for native and compat alike, so the
+	 * argument number IS the register index (arch/arm64/include/asm/syscall_wrapper.h). */
+	switch (kind) {
+	case SUSFS_OR_ENTRY_OPENAT:
+	case SUSFS_OR_ENTRY_COMPAT_OPENAT:
+		dfd = (int)regs->regs[0];
+		uname = (const char __user *)regs->regs[1];
+		/* Truncated to what the kernel's own declaration is: these entries take an `int flags`
+		 * and the syscall wrapper casts the register to it (__SC_CAST), so the upper half of the
+		 * register is ignored by the kernel.  Keeping it here would make the unknown-bit test
+		 * below see a "flag the kernel would reject" and hand a call the kernel resolves as a
+		 * plain open straight back to it - i.e. the redirect would be bypassable with
+		 * `flags | (1UL << 32)`.  openat2 is the exception and stays 64-bit, because the kernel
+		 * does not mask how.flags. */
+		flags = (unsigned int)regs->regs[2];
+		mode = regs->regs[3];
+		break;
+	case SUSFS_OR_ENTRY_COMPAT_OPEN:
+		/* COMPAT_SYSCALL_DEFINE3: no dirfd, so the arguments shift down by one. */
+		uname = (const char __user *)regs->regs[0];
+		flags = (unsigned int)regs->regs[1];
+		mode = regs->regs[2];
+		break;
+	case SUSFS_OR_ENTRY_OPENAT2:
+	case SUSFS_OR_ENTRY_COMPAT_OPENAT2:
+		dfd = (int)regs->regs[0];
+		uname = (const char __user *)regs->regs[1];
+		usize = regs->regs[3];
+		/* The kernel's own rules for this structure: a size below it is EINVAL, a size above it
+		 * is accepted as long as the bytes this kernel does not know are zero (that is what
+		 * copy_struct_from_user() checks, through check_zeroed_user()), and anything else is
+		 * E2BIG.  A call that gets here and is then not redirected still opens the real file, so
+		 * "we cannot be bothered" is not an option for a size the kernel would have accepted:
+		 * those go through when the helper is resolvable, and only fall back to the kernel where
+		 * it is not. */
+		if (usize < sizeof(how))
+			return SUSFS_OR_ENTRY_PASS;
+		if (copy_from_user(&how, (const void __user *)regs->regs[2], sizeof(how)))
+			return SUSFS_OR_ENTRY_PASS;
+		if (usize > sizeof(how) &&
+		    (!or_check_zeroed_user_fn ||
+		     or_check_zeroed_user((const void __user *)regs->regs[2] + sizeof(how),
+					  usize - sizeof(how)) <= 0))
+			return SUSFS_OR_ENTRY_PASS;
+		/* ... and the two bits the kernel removes from these flags before it looks at any of them
+		 * (FMODE_NONOTIFY, which the caller is not supposed to see, and O_CLOEXEC, which belongs
+		 * to the descriptor).  Everything below is judged on what is left, exactly like the
+		 * kernel does: FMODE_NONOTIFY is not one of O_PATH_FLAGS, so judging the raw flags would
+		 * turn a legal `O_PATH|FMODE_NONOTIFY` open into "a flag the kernel would refuse" and hand
+		 * the call back to a kernel that opens the real file. */
+		/* O_CLOEXEC is stripped from the copy everything below judges, because it is not a
+		 * property of the file - but it belongs to the DESCRIPTOR, and the kernel keeps it for
+		 * exactly the moment it allocates one: do_sys_openat2() calls
+		 * get_unused_fd_flags(how->flags), where alloc_fd() reads O_CLOEXEC.  Dropping it here
+		 * (this branch assigns flags = o2flags a few lines down, and that copy is what the
+		 * descriptor was allocated from) gave every redirected openat2(..., O_CLOEXEC) a fd
+		 * without FD_CLOEXEC: it survives execve, and fcntl(F_GETFD) says so in one call. */
+		fd_cloexec = (unsigned int)(how.flags & O_CLOEXEC);
+		o2flags = how.flags & ~(unsigned long)(FMODE_NONOTIFY | O_CLOEXEC);
+		/* A resolve bit the kernel does not know is EINVAL, and EINVAL is an answer we cannot
+		 * give: it comes from the kernel.  A bit it does know is mapped onto the same LOOKUP_*
+		 * flags it would use (see or_lookup_flags()), so the caller's resolve semantics still
+		 * hold for the path this layer looks up itself. */
+		if (how.resolve & ~SUSFS_OR_KNOWN_RESOLVE)
+			return SUSFS_OR_ENTRY_PASS;
+		/* The two combinations the kernel refuses before it looks at anything: RESOLVE_BENEATH
+		 * together with RESOLVE_IN_ROOT is EINVAL, and RESOLVE_CACHED with a call that would
+		 * create or truncate is EAGAIN (it will not fall back to a normal lookup).  Both are
+		 * answered by the kernel rather than by us - the second one is not just a difference in
+		 * the answer, it is a rule target that would be created or truncated.  The mask is the
+		 * kernel's own spelling, which is EAGAIN for a plain O_DIRECTORY too. */
+		if ((how.resolve & SUSFS_RESOLVE_BENEATH) && (how.resolve & SUSFS_RESOLVE_IN_ROOT))
+			return SUSFS_OR_ENTRY_PASS;
+		if ((how.resolve & SUSFS_RESOLVE_CACHED) &&
+		    (o2flags & (O_TRUNC | O_CREAT | O_TMPFILE)))
+			return SUSFS_OR_ENTRY_PASS;
+#ifndef LOOKUP_CACHED
+		/* This kernel cannot honour RESOLVE_CACHED, and answering the call with a normal lookup
+		 * would succeed where the kernel answers EAGAIN (it refuses to touch the disk for it). */
+		if (how.resolve & SUSFS_RESOLVE_CACHED)
+			return SUSFS_OR_ENTRY_PASS;
+#endif
+		resolve = how.resolve;
+		/* openat2 validates every field of the structure, where the older syscalls silently
+		 * clean invalid values up (build_open_flags(): mode & ~S_IALLUGO is EINVAL when the
+		 * call creates something, non-zero mode otherwise, and filp_open() would strip both
+		 * before the kernel could object).  Answering such a call with a successful open is the
+		 * one outcome we must not produce, so it goes back too. */
+		if ((o2flags & (O_CREAT | __O_TMPFILE)) ? (how.mode & ~S_IALLUGO) : how.mode)
+			return SUSFS_OR_ENTRY_PASS;
+		/* openat2 does not pass through build_open_how(), so the kernel tests its O_PATH rule
+		 * against these same stripped flags: anything besides O_PATH_FLAGS is EINVAL there, while
+		 * filp_open() would quietly mask those bits away and open the file. */
+		if ((o2flags & O_PATH) &&
+		    (o2flags & ~(unsigned long)(O_DIRECTORY | O_NOFOLLOW | O_PATH | O_CLOEXEC)))
+			return SUSFS_OR_ENTRY_PASS;
+		flags = o2flags;
+		mode = how.mode;
+		break;
+	default:
+		return SUSFS_OR_ENTRY_PASS;
+	}
+
+	/* The flags are handled the way the kernel handles them per entry, because that
+	 * differs: openat2 validates every field and answers EINVAL for a flag it does not know
+	 * (fs/open.c: build_open_flags() tests the raw how.flags), while open/openat/compat clean the
+	 * invalid bits away first (build_open_how(): `flags & VALID_OPEN_FLAGS`) and then open the file
+	 * as if they had not been passed.  Treating an unknown bit as "the kernel will refuse this" on
+	 * the older entries would hand the call back to a kernel that happily opens the real file - a
+	 * one-bit bypass of the redirect, and a cheaper one than any of the above.  So the older entries
+	 * get the same mask the kernel applies, and only openat2 can be declined over a flag. */
+	if (kind == SUSFS_OR_ENTRY_OPENAT2 || kind == SUSFS_OR_ENTRY_COMPAT_OPENAT2) {
+		/* Those two bits were already removed in the branch above, before its first check - the
+		 * kernel removes them before any of its own.  What is left is the gate the kernel applies
+		 * to these flags (build_open_flags(): `flags & ~VALID_OPEN_FLAGS` is EINVAL). */
+		if (flags & ~SUSFS_OR_KNOWN_FLAGS)
+			return SUSFS_OR_ENTRY_PASS;
+	} else {
+		flags &= SUSFS_OR_KNOWN_FLAGS;
+		/* The kernel narrows O_PATH before anything else looks at the flags - "O_PATH beats
+		 * everything else." in build_open_how() - so by the time build_open_flags() works out
+		 * whether the last component is followed, an O_CREAT/O_EXCL that arrived alongside
+		 * O_PATH is already gone.  Judging the flags as they arrived made this layer resolve a
+		 * DIFFERENT name than the kernel resolves: it saw O_CREAT|O_EXCL, withheld
+		 * LOOKUP_FOLLOW, and matched the rule table against the symlink itself, while the
+		 * kernel followed that symlink and opened its target.  So a caller who writes
+		 * `ln -s <rule target> <a path of his own>` and then asks for O_PATH|O_CREAT|O_EXCL
+		 * was handed the un-redirected file - the redirect stepped around without ever touching
+		 * the rule table.  Narrowed here, both layers walk the same name.
+		 *
+		 * (openat2 does not narrow: it never calls build_open_how(), and build_open_flags()
+		 * answers that same combination with EINVAL - which is why the branch above is left
+		 * alone.) */
+		if (flags & O_PATH)
+			flags &= SUSFS_OR_PATH_FLAGS;
+		/* From the same function: a call that cannot create carries no mode, and an O_PATH
+		 * open never can. */
+		if (flags & O_PATH)
+			mode = 0;
+		/* O_CLOEXEC survives the narrowing above (it is one of O_PATH_FLAGS), so the
+		 * descriptor's flag is read from the flags the kernel would allocate it from. */
+		fd_cloexec = (unsigned int)(flags & O_CLOEXEC);
+	}
+
+	memset(&ov, 0, sizeof(ov));
+	ov.kind = (enum susfs_open_kind)kind;
+	ov.flags = flags;
+	ov.resolve = resolve;
+	ov.mode = (unsigned int)mode;
+	ov.valid = true;
+	ov.mode_valid = true;
+	ov.resolve_supported = true;
+	if ((kind == SUSFS_OR_ENTRY_OPENAT2 ||
+	     kind == SUSFS_OR_ENTRY_COMPAT_OPENAT2) &&
+	    ((flags & (O_CREAT | __O_TMPFILE)) ?
+	     (mode & ~S_IALLUGO) : mode))
+		ov.mode_valid = false;
+#ifndef LOOKUP_CACHED
+	if (resolve & SUSFS_OPEN_RESOLVE_CACHED)
+		ov.resolve_supported = false;
+#endif
+	if (susfs_open_decide_core(&ov) == SUSFS_OPEN_PASS)
+		return SUSFS_OR_ENTRY_PASS;
+
+	/* Which inode is the caller opening?  The lookup flags are the kernel's own translation of the
+	 * caller's flags and of openat2's resolve bits (fs/open.c, right before do_filp_open): with
+	 * LOOKUP_FOLLOW hard-wired, a caller's O_NOFOLLOW turned its ELOOP into a successful redirect -
+	 * a difference from a kernel without this module, and one that also tells an observer which
+	 * paths carry a rule (write a symlink to the path and open it with O_NOFOLLOW).  A path that
+	 * does not resolve (O_CREAT of a new file) cannot be the target of a rule, so the kernel is
+	 * left to answer it. */
+	name = or_getname_flags_fn(uname, 0, NULL);
+	if (IS_ERR(name))
+		return SUSFS_OR_ENTRY_PASS;
+	res = or_filename_lookup_fn(dfd, name, or_lookup_flags(flags, resolve), &path, NULL);
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 0)
+	/* filename_lookup() consumed `name` through 5.14; 5.15 made the caller own it.
+	 * Putting it here again double-frees and panics (the create_gate 5.10 KE). */
+#else
+	or_putname_fn(name);
+#endif
+	if (res)
+		return SUSFS_OR_ENTRY_PASS;
+
+	/* The target name is copied out of the rule while the lookup holds rcu_read_lock (rule slots are
+	 * recycled after a grace period, so nothing inside an entry may be used after this call). */
+	susfs_open_rule_facts_path(&path, &rf);
+	if (!rf.matched) {
+		path_put(&path);
+		return SUSFS_OR_ENTRY_PASS;
+	}
+	path_put(&path);	/* no reference is kept anywhere: the rule owns none either */
+
+	ov.rule_matched = true;
+	ov.uid_scheme = rf.uid_scheme;
+	strscpy(ov.redirected, rf.redirected, sizeof(ov.redirected));
+	ov.caller_uid = current_uid().val;
+	ov.caller_in_su_domain = susfs_open_redirect_in_su_domain();
+	ov.caller_is_umounted_app = susfs_is_current_proc_umounted_app();
+	ov.caller_is_umounted = susfs_is_current_proc_umounted();
+	if (susfs_open_decide_core(&ov) == SUSFS_OPEN_PASS)
+		return SUSFS_OR_ENTRY_PASS;
+	strscpy(target, ov.redirected, sizeof(target));
+
+	/* Defensive: an empty name is not a path, and filp_open("") resolves to the caller's own
+	 * working directory, i.e. it would hand out an unrelated fd. */
+	if (!target[0])
+		return SUSFS_OR_ENTRY_PASS;
+
+	/* arm64 always opens with O_LARGEFILE (force_o_largefile() is `!IS_ENABLED(CONFIG_ARCH_32BIT_OFF_T)`,
+	 * and the syscall adds it before anything else looks at the flags).  Without it the fd we hand
+	 * back differs from every other fd in one visible bit: fcntl(F_GETFL) and the `flags:` line of
+	 * /proc/self/fdinfo/N both read f_flags directly.  CLOEXEC is the fd table's business, not the
+	 * open's - the kernel strips it before build_open_flags() sees it - so it is masked off here.
+	 *
+	 * The compat entries are the exception: the kernel deliberately does not set the bit there
+	 * ("Exactly like sys_openat(), except that it doesn't set the O_LARGEFILE flag"), and compat
+	 * openat2 does, because it is the same implementation as the native one.  An O_PATH open does
+	 * not carry it either - build_open_how() masks O_PATH opens to O_PATH_FLAGS. */
+#ifdef __aarch64__
+	if (!(flags & O_PATH) &&
+	    kind != SUSFS_OR_ENTRY_COMPAT_OPEN && kind != SUSFS_OR_ENTRY_COMPAT_OPENAT)
+		flags |= O_LARGEFILE;
+#endif
+	/* The descriptor is taken BEFORE the file is opened, which is the order do_sys_openat2() uses:
+	 * an EMFILE/ENFILE open then touches nothing at all, where opening first would have created or
+	 * truncated the rule's target and then failed anyway. */
+	fd = or_get_unused_fd_flags_fn(fd_cloexec);
+	if (fd < 0)
+		return fd;
+
+	f = or_filp_open_fn(target, (int)(flags & ~O_CLOEXEC), (umode_t)mode);
+	if (IS_ERR(f)) {
+		or_put_unused_fd((unsigned)fd);
+		return PTR_ERR(f);
+	}
+
+	/* Same order as do_sys_openat2(): the notification goes out before the fd is visible.
+	 *
+	 * Only where the kernel does not send it itself.  On 5.10..6.1 the one fsnotify_open() call
+	 * sits in do_sys_openat2(), which a filp_open() never reaches - without this line the
+	 * redirected open would be the only open on the system with no IN_OPEN, which breaks inotify
+	 * users and makes the redirect stand out.  6.6 moved that call into do_dentry_open()
+	 * (fs/open.c:985 there) and 6.12 split it out again into vfs_open() (:1095); filp_open() goes
+	 * through both, so on 6.6 and later the kernel has already reported this open and a second
+	 * call here produced two IN_OPEN events for one open. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+	or_fsnotify_open(f);
+#endif
+	or_fd_install_fn((unsigned)fd, f);
+
+	atomic_inc(&or_entry_hits);
+	return fd;
+}
+
+int susfs_or_entry_init(void)
+{
+	/* or_entry=0 means "no redirection at the name layer", and the rule-management path asks this
+	 * layer whether it is armed: leaving the hook installed but inert would accept rules that can
+	 * never fire, so the parameter is honoured here and the hook simply stays NULL. */
+	if (!READ_ONCE(or_entry_param)) {
+		SUSFS_LOGI("or_entry=0: name layer off (open_redirect will refuse rules)\n");
+		return 0;
+	}
+
+	/* The five open entries this layer needs are the ones susfs_opath.c installs: asking whether the
+	 * name layer is armed has to mean "at least one of those entries really carries a wrapper", or a
+	 * rule would be accepted from a device where opath_dump=1 / opath_test=N / a failed install left
+	 * the entries untouched - a rule that can never fire. */
+	if (!susfs_opath_armed()) {
+		SUSFS_LOGI("or_entry: susfs_opath installed none of the open entries - the name layer stays off (open_redirect will refuse rules)\n");
+		return 0;
+	}
+
+	or_getname_flags_fn = (void *)find_kernel_symbol_exact("getname_flags");
+	or_filename_lookup_fn = (void *)find_kernel_symbol_exact("filename_lookup");
+	or_putname_fn = (void *)find_kernel_symbol_exact("putname");
+	or_filp_open_fn = (void *)find_kernel_symbol_exact("filp_open");
+	or_get_unused_fd_flags_fn = (void *)find_kernel_symbol_exact("get_unused_fd_flags");
+	or_fd_install_fn = (void *)find_kernel_symbol_exact("fd_install");
+	or_put_unused_fd_fn = (void *)find_kernel_symbol_exact("put_unused_fd");
+	/* Required rather than optional: the descriptor is now taken before the file is opened, and
+	 * without the undo a failed open would leak the descriptor.  Taking the descriptor first is what
+	 * keeps an EMFILE/ENFILE open from having created or truncated the rule's target. */
+	/* Optional: only the inotify/fanotify notification depends on it. */
+	or_fsnotify_open_fn = (void *)find_kernel_symbol_exact("fsnotify_open");
+	if (!or_fsnotify_open_fn)
+		SUSFS_LOGI("or_entry: fsnotify_open not found - a redirected open will not produce IN_OPEN\n");
+	/* Optional too, and only for openat2 calls whose structure is larger than this kernel's: without
+	 * it those go back to the kernel (and are then not redirected). */
+	or_check_zeroed_user_fn = (void *)find_kernel_symbol_exact("check_zeroed_user");
+	if (!or_check_zeroed_user_fn)
+		SUSFS_LOGI("or_entry: check_zeroed_user not found - openat2 with a larger open_how is not redirected\n");
+
+	if (!or_getname_flags_fn || !or_filename_lookup_fn || !or_putname_fn ||
+	    !or_filp_open_fn || !or_get_unused_fd_flags_fn || !or_fd_install_fn ||
+	    !or_put_unused_fd_fn) {
+		SUSFS_LOGI("or_entry: not armed, a symbol is missing (getname_flags=%d filename_lookup=%d putname=%d filp_open=%d get_unused_fd_flags=%d fd_install=%d put_unused_fd=%d) - open_redirect will refuse rules\n",
+			   !!or_getname_flags_fn, !!or_filename_lookup_fn, !!or_putname_fn,
+			   !!or_filp_open_fn, !!or_get_unused_fd_flags_fn, !!or_fd_install_fn,
+			   !!or_put_unused_fd_fn);
+		return 0;
+	}
+
+	or_entry_ready = true;
+	smp_wmb();
+	WRITE_ONCE(susfs_or_entry_hook, or_entry_redirect);
+	SUSFS_LOGI("or_entry: name-layer redirection armed; open_redirect rules hold no inode while it is on\n");
+	return 0;
+}
+
+void susfs_or_entry_exit(void)
+{
+	WRITE_ONCE(susfs_or_entry_hook, NULL);
+	smp_mb();
+	or_entry_ready = false;
+}
diff --git a/KernelSU/kernel/susfs/susfs_or_entry.h b/KernelSU/kernel/susfs/susfs_or_entry.h
new file mode 100644
index 000000000000..50e495e92caf
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_or_entry.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SUSFS_OR_ENTRY_H
+#define __SUSFS_OR_ENTRY_H
+
+#include <linux/limits.h>
+#include <linux/ptrace.h>
+
+/* The syscall entries susfs_opath.c replaces.  open_redirect's name-layer redirection is asked
+ * inside that wrapper rather than installing a wrapper of its own: one syscall entry can have
+ * exactly one, and those five belong to the O_PATH layer (which already needs every argument the
+ * name layer needs, so nothing is duplicated by sharing).
+ *
+ * The layer is optional at run time: susfs_or_entry_hook stays NULL until the open_redirect layer
+ * found every symbol it needs, and the wrapper tests it before each call, so a missing symbol
+ * costs nothing but the feature. */
+enum susfs_or_entry_kind {
+	SUSFS_OR_ENTRY_OPENAT = 0,
+	SUSFS_OR_ENTRY_OPENAT2,
+	SUSFS_OR_ENTRY_COMPAT_OPEN,
+	SUSFS_OR_ENTRY_COMPAT_OPENAT,
+	SUSFS_OR_ENTRY_COMPAT_OPENAT2,
+	SUSFS_OR_ENTRY_KIND_COUNT,
+};
+
+/* Returned when the hook did not redirect: the caller then runs the original syscall.  LONG_MIN
+ * cannot be a real answer here (a fd or -errno), so a mistake cannot be mistaken for one. */
+#define SUSFS_OR_ENTRY_PASS	LONG_MIN
+
+typedef long (*susfs_or_entry_fn_t)(const struct pt_regs *regs, int kind);
+
+extern susfs_or_entry_fn_t susfs_or_entry_hook;
+
+/* True once redirection can actually happen.  The open_redirect layer checks this when a rule is added:
+ * a rule that cannot fire is worse than no rule, so it refuses rather than register one. */
+static inline bool susfs_or_entry_armed(void)
+{
+	return READ_ONCE(susfs_or_entry_hook) != NULL;
+}
+
+/* Both are called from the open_redirect layer's init/exit.  init never fails: the layer is
+ * optional, and refusing to arm is reported and survived. */
+int susfs_or_entry_init(void);
+void susfs_or_entry_exit(void);
+
+#endif /* __SUSFS_OR_ENTRY_H */
diff --git a/KernelSU/kernel/susfs/susfs_supercall.c b/KernelSU/kernel/susfs/susfs_supercall.c
new file mode 100644
index 000000000000..c64b76f70d40
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_supercall.c
@@ -0,0 +1,507 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_supercall.c - SUSFS supercall dispatcher (reboot(2) ABI).
+ *
+ * ksu_susfs (and SukiSU ksud) call syscall(SYS_reboot, 0xDEADBEEF, 0xFAFAFAFA, cmd_id,
+ * &payload) and the handler writes payload.err back.  Upstream SUSFS patches
+ * kernel/reboot.c SYSCALL_DEFINE4 to branch into ksu_handle_sys_reboot(); an LKM cannot
+ * patch that, so we kprobe __arm64_sys_reboot and match the magics ourselves.
+ *  - arm64 syscall-wrapper quirk: the kprobe sees regs->regs[0] == struct pt_regs * (the
+ *    wrapper's __regs argument); the real user args are in real_regs->regs[0..3] - SukiSU's
+ *    PT_REAL_REGS() / arch.h.
+ *  - a pre_handler runs in interrupt context and must not copy_from_user, so the command is
+ *    deferred to task_work (TWA_RESUME), i.e. process context - the same trick SukiSU uses.
+ * The handlers keep upstream's signature `void xxx(void __user **arg)`, *arg pointing at
+ * the userspace payload struct.
+ */
+#include <linux/module.h>
+#include <linux/kprobes.h>
+#include <linux/task_work.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/cred.h>
+#include <linux/syscalls.h>
+#include <linux/string.h>
+#include <linux/bitmap.h>
+#include "susfs_abi.h"
+#include "susfs_log.h"
+#include "susfs.h"
+#include "susfs_fp_hook.h"
+
+struct susfs_tw {
+	struct callback_head cb;
+	unsigned int cmd;
+	void __user *payload;   /* points at the userspace payload struct */
+};
+
+static void susfs_show_version(void __user **arg)
+{
+	struct st_susfs_version info = {0};
+
+	if (copy_from_user(&info, (void __user *)*arg, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out;
+	}
+	strscpy(info.susfs_version, SUSFS_VERSION_STR, SUSFS_MAX_VERSION_BUFSIZE);
+	info.err = 0;
+out:
+	if (copy_to_user((void __user *)*arg, &info, sizeof(info)))
+		pr_warn("susfs show_version copy_to_user failed\n");
+}
+
+static void susfs_show_variant(void __user **arg)
+{
+	struct st_susfs_variant info = {0};
+
+	if (copy_from_user(&info, (void __user *)*arg, sizeof(info))) {
+		info.err = -EFAULT;
+		goto out;
+	}
+	strscpy(info.susfs_variant, SUSFS_VARIANT_STR, SUSFS_MAX_VARIANT_BUFSIZE);
+	info.err = 0;
+out:
+	if (copy_to_user((void __user *)*arg, &info, sizeof(info)))
+		pr_warn("susfs show_variant copy_to_user failed\n");
+}
+
+/* List every feature this LKM implements: the first line marks the source (an LKM, not a built-in
+ * SUSFS) and the rest use upstream CONFIG macro names.  An entry is reported only while its layer
+ * armed it (susfs_supercall_arm_feature(), called by susfs_main.c after that layer's init returned
+ * 0): advertising a feature whose registration failed is the exact inconsistency a detector probes
+ * for, and the same bit is what lets the reboot(2) command through - one registry, so the list and
+ * the command table cannot disagree. */
+struct feature_entry {
+	const char *name;
+	int feature;		/* enum susfs_feature, or -1 = always present */
+};
+
+static DECLARE_BITMAP(susfs_armed_features, SUSFS_FEAT_COUNT);
+
+void susfs_supercall_arm_feature(enum susfs_feature feature)
+{
+	if ((int)feature >= 0 && feature < SUSFS_FEAT_COUNT)
+		set_bit(feature, susfs_armed_features);
+}
+
+bool susfs_supercall_feature_armed(enum susfs_feature feature)
+{
+	return (int)feature >= 0 && feature < SUSFS_FEAT_COUNT &&
+	       test_bit(feature, susfs_armed_features);
+}
+
+static const struct feature_entry enabled_features[] = {
+	/* First line, and deliberately not a CONFIG_* name: the caller has to be able to tell this
+	 * list apart from a built-in SUSFS's, whose features live in the kernel image and have a
+	 * different lifecycle (no load/unload, no /sys/module entry, no module parameters). */
+	{ "SUSFS_LKM_MODULES\n",		-1 },
+	{ "CONFIG_KSU_SUSFS_SUS_PATH\n",	SUSFS_FEAT_SUS_PATH },
+	{ "CONFIG_KSU_SUSFS_SUS_MOUNT\n",	SUSFS_FEAT_SUS_MOUNT },
+	{ "CONFIG_KSU_SUSFS_SUS_KSTAT\n",	SUSFS_FEAT_SUS_KSTAT },
+	{ "CONFIG_KSU_SUSFS_SPOOF_UNAME\n",	SUSFS_FEAT_SPOOF_UNAME },
+	{ "CONFIG_KSU_SUSFS_ENABLE_LOG\n",	SUSFS_FEAT_ENABLE_LOG },
+	{ "CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS\n",	SUSFS_FEAT_HIDE_SYMS },
+	{ "CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG\n",	SUSFS_FEAT_SPOOF_CMDLINE },
+	{ "CONFIG_KSU_SUSFS_OPEN_REDIRECT\n",	SUSFS_FEAT_OPEN_REDIRECT },
+	{ "CONFIG_KSU_SUSFS_SUS_MAP\n",		SUSFS_FEAT_SUS_MAP },
+	/* hide_modules is not upstream's, so it is not listed here - the feature itself is unchanged. */
+};
+
+/* The -ENOMEM answer for CMD_SUSFS_SHOW_ENABLED_FEATURES is the whole ABI struct (8192-byte
+ * string + err), copied in one piece.  As a local it broke the 6.1/6.6 builds: "stack frame
+ * size (8320) exceeds limit (2048) in 'susfs_tw_func' [-Wframe-larger-than]", an error
+ * there.  As a static it is harmless - BSS-zeroed, err = -ENOMEM, same for every caller. */
+static struct st_susfs_enabled_features susfs_enabled_features_nomem;
+
+static void susfs_show_enabled_features(void __user **arg)
+{
+	struct st_susfs_enabled_features *info;
+	size_t off = 0;
+	int i;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info) {
+		/* Answering nothing would leave the caller unable to tell "no memory" from
+		 * "the kernel said nothing": report it in the ABI's err field. */
+		susfs_enabled_features_nomem.err = -ENOMEM;
+		if (copy_to_user((void __user *)*arg, &susfs_enabled_features_nomem,
+				 sizeof(susfs_enabled_features_nomem)))
+			pr_warn("susfs show_enabled_features copy_to_user failed\n");
+		pr_warn_ratelimited("susfs: show_enabled_features kzalloc failed, reported -ENOMEM\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(enabled_features); i++) {
+		const char *name = enabled_features[i].name;
+		size_t len = strlen(name);
+
+		if (enabled_features[i].feature >= 0 &&
+		    !susfs_supercall_feature_armed(enabled_features[i].feature))
+			continue;
+		if (off + len >= SUSFS_ENABLED_FEATURES_SIZE)
+			break;
+		memcpy(info->enabled_features + off, name, len);
+		off += len;
+	}
+	info->err = 0;
+
+	if (copy_to_user((void __user *)*arg, info, sizeof(*info)))
+		pr_warn("susfs show_enabled_features copy_to_user failed\n");
+	kfree(info);
+}
+
+static void susfs_tw_func(struct callback_head *cb)
+{
+	struct susfs_tw *tw = container_of(cb, struct susfs_tw, cb);
+	void __user *arg = tw->payload;
+
+	switch (tw->cmd) {
+	case CMD_SUSFS_SHOW_VERSION:
+		susfs_show_version(&arg);
+		break;
+	case CMD_SUSFS_SHOW_VARIANT:
+		susfs_show_variant(&arg);
+		break;
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		susfs_show_enabled_features(&arg);
+		break;
+	case CMD_SUSFS_ADD_SUS_PATH:
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		/* The two commands answer a missing path differently upstream. */
+		sus_path_supercall(tw->cmd, &arg);
+		break;
+	case CMD_SUSFS_ADD_SUS_MAP:
+		susfs_sus_map_supercall(&arg);
+		break;
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		susfs_kstat_supercall(tw->cmd, &arg);
+		break;
+	case CMD_SUSFS_SET_UNAME:
+		susfs_uname_supercall(&arg);
+		break;
+	case CMD_SUSFS_ENABLE_LOG:
+		susfs_enable_log_supercall(&arg);
+		break;
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		susfs_avc_spoof_supercall(&arg);
+		break;
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		susfs_spoof_cmdline_supercall(&arg);
+		break;
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		susfs_open_redirect_supercall(&arg);
+		break;
+	case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+		susfs_sus_mount_supercall(&arg);
+		break;
+	default:
+		/* Unreachable: reboot_pre() only defers a command susfs_cmd_handled()
+		 * accepted.  Kept as a net in case the two lists drift apart. */
+		pr_warn("susfs_guard_lkm: supercall: unsupported cmd 0x%x reached the worker (susfs_cmd_handled() and the switch disagree)\n",
+			tw->cmd);
+		break;
+	}
+	kfree(tw);
+
+	/* Pairs with the try_module_get() in reboot_pre(): the callback runs from module .text,
+	 * after the syscall has already returned to userspace. */
+	module_put(THIS_MODULE);
+}
+
+/* Commands susfs_tw_func() above actually dispatches - keep the two in sync.
+ *
+ * The kprobe consults this BEFORE swallowing the syscall: upstream answers an unrecognised
+ * command with `return -EINVAL` from ksu_handle_sys_reboot()
+ * (KernelSU/10_enable_susfs_for_ksu.patch:2925-2926), and reboot.c's `if (ret) goto
+ * orig_flow;` falls through to the real reboot path, whose magic check rejects
+ * 0xDEADBEEF/0xFAFAFAFA with -EINVAL.  Upstream writes NOTHING to payload.err then, and 126
+ * (ERR_CMD_NOT_SUPPORTED) is a USERSPACE sentinel the ksu_susfs C tool pre-seeds and reads
+ * back as "the kernel never handled this command" (ksu_susfs/jni/features/sus_map.c:51-53,
+ * ksu_susfs/jni/includes/susfs_defs.h:16-18).  So an unknown command must NOT be hijacked:
+ * leave the regs and err alone, while every command listed here still short-circuits to 0.
+ *
+ * A command is handled only while its feature is armed, so a command for a failed non-fatal
+ * layer falls through exactly like an unknown one - the same registry SHOW_ENABLED_FEATURES
+ * reads, so the advertised list and the accepted commands cannot disagree. */
+static int susfs_cmd_feature(unsigned int cmd)
+{
+	switch (cmd) {
+	case CMD_SUSFS_ADD_SUS_PATH:
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		return SUSFS_FEAT_SUS_PATH;
+	case CMD_SUSFS_ADD_SUS_MAP:
+		return SUSFS_FEAT_SUS_MAP;
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		return SUSFS_FEAT_SUS_KSTAT;
+	case CMD_SUSFS_SET_UNAME:
+		return SUSFS_FEAT_SPOOF_UNAME;
+	case CMD_SUSFS_ENABLE_LOG:
+		return SUSFS_FEAT_ENABLE_LOG;
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		return SUSFS_FEAT_AVC_SPOOF;
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		return SUSFS_FEAT_SPOOF_CMDLINE;
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		return SUSFS_FEAT_OPEN_REDIRECT;
+	case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+		return SUSFS_FEAT_SUS_MOUNT;
+	default:
+		return -1;
+	}
+}
+
+static bool susfs_cmd_handled(unsigned int cmd)
+{
+	int feature;
+
+	switch (cmd) {
+	case CMD_SUSFS_SHOW_VERSION:
+	case CMD_SUSFS_SHOW_VARIANT:
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		return true;
+	default:
+		break;
+	}
+
+	feature = susfs_cmd_feature(cmd);
+	return feature >= 0 && susfs_supercall_feature_armed(feature);
+}
+
+static susfs_syscall_fn_t reboot_orig;
+
+static long __nocfi reboot_wrapper(const struct pt_regs *regs)
+{
+	int magic1, magic2;
+	unsigned int cmd;
+	void __user *payload;
+	struct susfs_tw *tw;
+
+	magic1 = (int)regs->regs[0];
+	magic2 = (int)regs->regs[1];
+	cmd = (unsigned int)regs->regs[2];
+	payload = (void __user *)regs->regs[3];
+
+	if (magic1 != KSU_INSTALL_MAGIC1)
+		goto orig;
+	if (magic2 != SUSFS_MAGIC)
+		goto orig;
+	if (current_uid().val != 0)
+		goto orig;
+
+	if (!susfs_cmd_handled(cmd)) {
+		SUSFS_LOGI("susfs supercall: unsupported cmd 0x%x\n", cmd);
+		goto orig;
+	}
+
+	/* The callback runs from module .text when this task next returns to userspace.  Pin the
+	 * module until it has run: the syscall table entry is restored before that on rmmod. */
+	if (!try_module_get(THIS_MODULE))
+		goto orig;
+
+	tw = kzalloc(sizeof(*tw), GFP_ATOMIC);
+	if (!tw) {
+		module_put(THIS_MODULE);
+		goto orig;
+	}
+	tw->cmd = cmd;
+	tw->payload = payload;
+	tw->cb.func = susfs_tw_func;
+
+	if (task_work_add(current, &tw->cb, TWA_RESUME)) {
+		kfree(tw);
+		module_put(THIS_MODULE);
+		pr_warn("susfs supercall: task_work_add failed\n");
+		goto orig;
+	}
+
+	/* A handled supercall returns 0 to userspace; the command itself runs from task_work. */
+	return 0;
+
+orig:
+	return reboot_orig ? reboot_orig(regs) : -EINVAL;
+}
+
+static struct susfs_fp_hook reboot_hook = {
+	.nr = __NR_reboot,
+	.nr_compat = 0,
+	.name = "supercall/reboot",
+	.sym = "__arm64_sys_reboot",
+	.wrapper = reboot_wrapper,
+	.orig_slot = &reboot_orig,
+};
+
+/* Fallback delivery for kernels whose sys_call_table cannot be hooked: on arm64 GKI under pKVM the
+ * table page is EL2-protected and susfs_fp_install() above finds no landing pad (it logs "no valid
+ * call landing pad ... not installed").  This is the pre-792ac97 kprobe path, still what sus_map and
+ * sus_mount use.  susfs_supercall_init() only reaches it when the table hook could not arm, so BTI
+ * kernels keep the sys_call_table path above (792ac97 moved off kprobes on indirect-call entries for
+ * them); a kernel that is both BTI and pKVM takes neither and the layer fails. */
+static int reboot_pre(struct kprobe *kp, struct pt_regs *regs)
+{
+	struct pt_regs *real_regs = (struct pt_regs *)regs->regs[0];
+	int magic1, magic2;
+	unsigned int cmd;
+	void __user *payload;
+	struct susfs_tw *tw;
+
+	/* A prober runs before the callee, so an argument the callee would have checked is
+	 * still raw here (see the filename_lookup lesson in sus_path.c). */
+	if (!real_regs)
+		return 0;
+
+	magic1 = (int)real_regs->regs[0];
+	magic2 = (int)real_regs->regs[1];
+	cmd = (unsigned int)real_regs->regs[2];
+	payload = (void __user *)real_regs->regs[3];
+
+	if (magic1 != KSU_INSTALL_MAGIC1)
+		return 0;
+	if (magic2 != SUSFS_MAGIC)
+		return 0;
+	if (current_uid().val != 0)
+		return 0;
+
+	/* Not ours to answer: leave the syscall alone so reboot(2) reports the -EINVAL
+	 * upstream reports and payload.err keeps the caller's value. */
+	if (!susfs_cmd_handled(cmd)) {
+		SUSFS_LOGI("susfs supercall: unsupported cmd 0x%x\n", cmd);
+		return 0;
+	}
+
+	/* The callback runs from module .text when this task next returns to userspace, which can
+	 * be after `rmmod` has already freed the module: the kprobe is on a vmlinux symbol, so
+	 * its registration does not hold a reference for us, and unregister_kprobe() cannot
+	 * cancel a task_work that is already queued.  Pin the module until the callback has
+	 * run.  GFP_ATOMIC context, so no sleeping here. */
+	if (!try_module_get(THIS_MODULE))
+		return 0;
+
+	tw = kzalloc(sizeof(*tw), GFP_ATOMIC);
+	if (!tw) {
+		module_put(THIS_MODULE);
+		return 0;
+	}
+	tw->cmd = cmd;
+	tw->payload = payload;
+	tw->cb.func = susfs_tw_func;
+
+	if (task_work_add(current, &tw->cb, TWA_RESUME)) {
+		kfree(tw);
+		module_put(THIS_MODULE);
+		pr_warn("susfs supercall: task_work_add failed\n");
+		return 0;
+	}
+
+	/* Upstream's reboot.c patch makes a handled supercall return 0 instead of falling
+	 * through to the real reboot path:
+	 *     if (ret) goto orig_flow;
+	 *     return ret;
+	 * We cannot patch reboot.c, so mirror it from the kprobe: skip the rest of
+	 * __arm64_sys_reboot and return 0 - with these magic values reboot would otherwise
+	 * return -EINVAL, and the prebuilt ksu_susfs tool checks the syscall result.  The
+	 * command itself still runs from task_work before we return to userspace. */
+	regs->pc = regs->regs[30];
+	regs->regs[0] = 0;
+	return 1;
+}
+
+static struct kprobe reboot_kp = {
+	.symbol_name = "__arm64_sys_reboot",
+	.pre_handler = reboot_pre,
+};
+
+static bool sc_registered;	/* sys_call_table path armed */
+static bool sc_kp_registered;	/* kprobe fallback armed */
+
+/* ---- ABI layout assertions ----
+ * These sizes and `err` offsets ARE the userspace contract (ksu_susfs, ksud and
+ * tools/susfs_sc compile against these numbers); a drift shows up as "the command returned
+ * 0 and userspace printed garbage", not as a build error, and the repository's own
+ * abi_layout_check/ harness is not wired into any build step - hence the trip wire here.
+ * Values are aarch64 LP64, the only ABI shipped clients use, and match upstream's structs
+ * (kernel_patches/include/linux/susfs.h). */
+static void __init susfs_abi_layout_check(void)
+{
+	BUILD_BUG_ON(sizeof(struct st_susfs_sus_path) != 260);
+	BUILD_BUG_ON(offsetof(struct st_susfs_sus_path, err) != 256);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_sus_map) != 260);
+	BUILD_BUG_ON(offsetof(struct st_susfs_sus_map, err) != 256);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_sus_kstat) != 376);
+	BUILD_BUG_ON(offsetof(struct st_susfs_sus_kstat, err) != 372);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_uname) != 136);
+	BUILD_BUG_ON(offsetof(struct st_susfs_uname, err) != 132);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_log) != 8);
+	BUILD_BUG_ON(offsetof(struct st_susfs_log, err) != 4);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_avc_log_spoofing) != 8);
+	BUILD_BUG_ON(offsetof(struct st_susfs_avc_log_spoofing, err) != 4);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_hide_sus_mnts_for_non_su_procs) != 8);
+	BUILD_BUG_ON(offsetof(struct st_susfs_hide_sus_mnts_for_non_su_procs, err) != 4);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_open_redirect) != 520);
+	BUILD_BUG_ON(offsetof(struct st_susfs_open_redirect, err) != 516);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_spoof_cmdline_or_bootconfig) != 8196);
+	BUILD_BUG_ON(offsetof(struct st_susfs_spoof_cmdline_or_bootconfig, err) != 8192);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_version) != 20);
+	BUILD_BUG_ON(offsetof(struct st_susfs_version, err) != 16);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_variant) != 20);
+	BUILD_BUG_ON(offsetof(struct st_susfs_variant, err) != 16);
+
+	BUILD_BUG_ON(sizeof(struct st_susfs_enabled_features) != 8196);
+	BUILD_BUG_ON(offsetof(struct st_susfs_enabled_features, err) != 8192);
+}
+
+int susfs_supercall_init(void)
+{
+	int rc;
+
+	susfs_abi_layout_check();
+
+	rc = susfs_fp_install(&reboot_hook);
+	if (!rc) {
+		sc_registered = true;
+		SUSFS_LOGI("susfs supercall: armed via sys_call_table (reboot ABI, version " SUSFS_VERSION_STR ")\n");
+		return 0;
+	}
+
+	/* The table could not be hooked (pKVM EL2-protected sys_call_table: no landing pad).  Fall
+	 * back to the kprobe, which does not touch the table.  See reboot_kp above. */
+	pr_warn("susfs supercall: sys_call_table reboot hook failed %d, trying kprobe fallback\n", rc);
+	rc = register_kprobe(&reboot_kp);
+	if (rc) {
+		pr_warn("susfs supercall: register_kprobe(reboot) failed %d\n", rc);
+		return rc;
+	}
+	sc_kp_registered = true;
+	SUSFS_LOGI("susfs supercall: armed via kprobe (reboot ABI, version " SUSFS_VERSION_STR ")\n");
+	return 0;
+}
+
+bool susfs_supercall_kprobe_active(void)
+{
+	return sc_kp_registered;
+}
+
+void susfs_supercall_exit(void)
+{
+	if (sc_registered) {
+		susfs_fp_remove(&reboot_hook);
+		susfs_fp_drain();
+		sc_registered = false;
+	}
+	if (sc_kp_registered) {
+		unregister_kprobe(&reboot_kp);
+		sc_kp_registered = false;
+	}
+}
diff --git a/KernelSU/kernel/susfs/susfs_uname.c b/KernelSU/kernel/susfs/susfs_uname.c
new file mode 100644
index 000000000000..22457b0ddbe4
--- /dev/null
+++ b/KernelSU/kernel/susfs/susfs_uname.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * susfs_uname.c - spoof uname release/version (SUSFS SPOOF_UNAME).  Upstream patches the body of
+ * SYSCALL_DEFINE1(newuname) between the memcpy(utsname) and copy_to_user; the LKM equivalent hooks
+ * __arm64_sys_newuname with a kretprobe and rewrites the release/version fields of the user buffer just before
+ * the syscall returns - the target pages were just faulted in by the original copy_to_user, so the handler's
+ * copy_to_user cannot fault, and "default" copies the device's CURRENT utsname()->release/version at runtime.
+ * Upstream semantics: OFF by default, enabled by CMD_SUSFS_SET_UNAME alone, kretprobe registered lazily.
+ */
+#include <linux/module.h>
+#include <linux/kprobes.h>
+#include <linux/uaccess.h>
+#include <linux/utsname.h>
+#include <linux/string.h>
+#include <linux/mutex.h>	/* uname_ctl_lock: serialises the arm/disarm pair */
+#include <linux/version.h>
+#include "susfs_abi.h"
+#include "susfs_log.h"
+#include "susfs.h"	/* susfs_abi_path_ok */
+#include "susfs_kprobe.h"
+
+#define SUSFS_UNAME_LEN (__NEW_UTS_LEN + 1)
+
+static char fake_release[SUSFS_UNAME_LEN];
+static char fake_version[SUSFS_UNAME_LEN];
+static bool uname_spoof_enabled;
+
+/* optional insmod-time override; supercall is the primary interface */
+module_param_string(release, fake_release, sizeof(fake_release), 0644);
+module_param_string(version, fake_version, sizeof(fake_version), 0644);
+module_param(uname_spoof_enabled, bool, 0644);
+MODULE_PARM_DESC(release, "fake uname release (insmod override)");
+MODULE_PARM_DESC(version, "fake uname version (insmod override)");
+MODULE_PARM_DESC(uname_spoof_enabled, "enable uname spoofing (insmod override)");
+
+struct uname_args {
+    struct new_utsname __user *name;
+};
+
+static int kr_newuname_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct uname_args *a = (struct uname_args *)ri->data;
+    struct pt_regs *user = (struct pt_regs *)regs->regs[0];
+
+    /* this GKI kernel does NOT auto-adjust syscall-wrapper probe regs:
+     * regs->regs[0] is the struct pt_regs* argument, not the user arg */
+    if (!user)
+        return 1;   /* no return handler: ri->data would be left stale */
+
+    a->name = (struct new_utsname __user *)user->regs[0];
+    return 0;
+}
+
+static int kr_newuname_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct uname_args *a = (struct uname_args *)ri->data;
+
+    if (regs_return_value(regs) != 0)
+        return 0;
+    if (!uname_spoof_enabled || !a->name)
+        return 0;
+
+    if (copy_to_user((char __user *)a->name + offsetof(struct new_utsname, release),
+                     fake_release, SUSFS_UNAME_LEN))
+        return 0;
+    if (copy_to_user((char __user *)a->name + offsetof(struct new_utsname, version),
+                     fake_version, SUSFS_UNAME_LEN))
+        return 0;
+    return 0;
+}
+
+static struct kretprobe krp = {
+    .kp.symbol_name = "__arm64_sys_newuname",
+    .entry_handler = kr_newuname_entry,
+    .handler = kr_newuname_ret,
+    .data_size = sizeof(struct uname_args),
+    .maxactive = 32,
+};
+
+static bool uname_registered;
+
+/* Serialises the arm/disarm pair - the full reasoning is in susfs_avc_spoof.c's avc_ctl_lock:
+ * register_kprobe() answers -EINVAL once another task has resolved .addr, and the failure branch
+ * below clears .addr - which, without this lock, disarms a probe that is LIVE without ever
+ * unregistering it, leaving its breakpoint installed after the module is freed.  Two tasks can
+ * send CMD_SUSFS_SET_UNAME at the same time (each supercall runs in its own task_work). */
+static DEFINE_MUTEX(uname_ctl_lock);
+
+static int uname_register(void)
+{
+    int rc;
+
+    mutex_lock(&uname_ctl_lock);
+    if (uname_registered) {
+        mutex_unlock(&uname_ctl_lock);
+        return 0;
+    }
+    rc = register_kretprobe(&krp);
+    if (rc) {
+        /* CMD_SUSFS_SET_UNAME can be sent again after a failure, and the address the kernel
+         * resolved is already in the struct: without this the retry is refused with -EINVAL
+         * and the spoof can never be turned on - see susfs_kprobe.h.  Safe under the lock. */
+        susfs_krp_forget_addr(&krp);
+        mutex_unlock(&uname_ctl_lock);
+        return rc;
+    }
+    uname_registered = true;
+    mutex_unlock(&uname_ctl_lock);
+    SUSFS_LOGI("uname spoof armed: release=%s version=%s\n",
+            fake_release, fake_version);
+    return 0;
+}
+
+static void uname_unregister(void)
+{
+    mutex_lock(&uname_ctl_lock);
+    if (!uname_registered) {
+        mutex_unlock(&uname_ctl_lock);
+        return;
+    }
+    unregister_kretprobe(&krp);
+    susfs_krp_forget_addr(&krp);
+    uname_registered = false;
+    mutex_unlock(&uname_ctl_lock);
+}
+
+/* The insmod/sysfs parameter path does not go through the supercall's strscpy_pad(): the
+ * kernel's own param_set_copystring() strcpy()s into the buffer and leaves the rest of it
+ * alone, so a value that arrived that way needs the same padding before it is handed out. */
+static void uname_pad(char *s, size_t size)
+{
+    size_t n = strnlen(s, size);
+
+    if (n < size)
+        memset(s + n, 0, size - n);
+}
+
+int susfs_uname_init(void)
+{
+    uname_pad(fake_release, sizeof(fake_release));
+    uname_pad(fake_version, sizeof(fake_version));
+
+    if (uname_spoof_enabled && fake_release[0] && fake_version[0]) {
+        int rc = uname_register();
+
+        if (rc)
+            pr_warn("register_kretprobe(newuname) failed %d\n", rc);
+    } else {
+        SUSFS_LOGI("uname spoof: disabled (enable via CMD_SUSFS_SET_UNAME)\n");
+    }
+    return 0;
+}
+
+void susfs_uname_exit(void)
+{
+    uname_unregister();
+}
+
+/* supercall: CMD_SUSFS_SET_UNAME */
+void susfs_uname_supercall(void __user **arg)
+{
+    struct st_susfs_uname info = {0};
+    int rc;
+
+    if (copy_from_user(&info, (void __user *)*arg, sizeof(info))) {
+        info.err = -EFAULT;
+        goto out;
+    }
+    if (*info.release == '\0' || *info.version == '\0') {
+        /* -EINVAL: the buffer came across fine, the VALUE is what is wrong. */
+        info.err = -EINVAL;
+        goto out;
+    }
+    /* char[65] ABI fields the caller need not terminate; strcmp() and strscpy() below would run past the end. */
+    if (!susfs_abi_path_ok(info.release, sizeof(info.release)) ||
+        !susfs_abi_path_ok(info.version, sizeof(info.version))) {
+        info.err = -ENAMETOOLONG;
+        goto out;
+    }
+
+    /* "default" copies the device's CURRENT uname at runtime */
+    /* strscpy_pad(), not strscpy(): the kernel's own utsname fields are zero-padded to their
+     * full width, so an unpadded copy hands the caller the tail of whatever longer value was
+     * set before - residue no genuine uname(2) can produce. */
+    if (!strcmp(info.release, "default"))
+        strscpy_pad(fake_release, utsname()->release, sizeof(fake_release));
+    else
+        strscpy_pad(fake_release, info.release, sizeof(fake_release));
+    if (!strcmp(info.version, "default"))
+        strscpy_pad(fake_version, utsname()->version, sizeof(fake_version));
+    else
+        strscpy_pad(fake_version, info.version, sizeof(fake_version));
+
+    uname_spoof_enabled = true;
+    rc = uname_register();
+    if (rc) {
+        info.err = rc;
+        goto out;
+    }
+    info.err = 0;
+    SUSFS_LOGI("uname spoof set: release=%s version=%s\n", fake_release, fake_version);
+out:
+    /* upstream writes back only ->err for input-type commands */
+    if (copy_to_user(&((struct st_susfs_uname __user *)*arg)->err,
+                     &info.err, sizeof(info.err)))
+        pr_warn("uname supercall copy_to_user failed\n");
+}
diff --git a/KernelSU/kernel/susfs/symbol_resolver.c b/KernelSU/kernel/susfs/symbol_resolver.c
new file mode 100644
index 000000000000..9ef64b919026
--- /dev/null
+++ b/KernelSU/kernel/susfs/symbol_resolver.c
@@ -0,0 +1,276 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/kallsyms.h>
+#include <linux/string.h>
+#include <linux/version.h>
+
+#include "symbol_resolver.h"
+#include "susfs_log.h"
+
+#include "kallrecon/lib/core.h"
+#include "kallrecon/lib/hint.h"
+#include "kallrecon/lib/slide.h"
+#include "kallrecon/lib/symbol.h"
+#include "kallrecon/lib/variant.h"
+
+#define KR_SCAN_BACK	0x400000UL
+#define KR_SCAN_FWD	0x200000UL
+#define KR_TIMEOUT_MS	10000
+
+#define KR_NAME_MAX	256
+#define KR_ALL_MAX	8
+
+static bool kr_ready;
+
+static bool kr_layout_ready(void)
+{
+	return klnum_val && kloffs_addr && klnames_addr;
+}
+
+static __nocfi noinline unsigned long kr_klp(const char *name)
+{
+	return kallrecon_klp(name);
+}
+
+static const char *(*kr_lookup_fn)(unsigned long addr, unsigned long *symbolsize,
+				   unsigned long *offset, char **modname, char *namebuf);
+
+static __nocfi noinline const char *kr_lookup(unsigned long addr, char **modname, char *buf)
+{
+	return kr_lookup_fn(addr, NULL, NULL, modname, buf);
+}
+
+unsigned long find_kernel_symbol_exact_any(const char *symbol_name)
+{
+	if (!symbol_name || !symbol_name[0] || !kr_ready || !kallrecon_klp)
+		return 0;
+
+	return kr_klp(symbol_name);
+}
+
+unsigned long ksu_kallsyms_lookup_name(const char *name)
+{
+	return find_kernel_symbol_exact_any(name);
+}
+
+unsigned long find_kernel_symbol_exact(const char *symbol_name)
+{
+	unsigned long addr;
+	char buf[KSYM_SYMBOL_LEN];
+	char *mod = NULL;
+
+	addr = find_kernel_symbol_exact_any(symbol_name);
+	if (!addr || !kr_lookup_fn)
+		return 0;
+
+	if (!kr_lookup(addr, &mod, buf))
+		return 0;
+
+	if (mod) {
+		pr_warn("ignore symbol %s of module %s\n", symbol_name, mod);
+		return 0;
+	}
+
+	return addr;
+}
+
+void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name)
+{
+	unsigned long addr;
+
+	if (!kr_ready || !symbol_name || !symbol_name[0])
+		return NULL;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+	addr = find_kernel_symbol_exact(symbol_name);
+	if (!addr)
+		addr = kallrecon_find_variant(symbol_name, 0);
+#else
+	{
+		char cfi_name[KSYM_NAME_LEN];
+
+		snprintf(cfi_name, sizeof(cfi_name), "%s.cfi_jt", symbol_name);
+		addr = find_kernel_symbol_exact(cfi_name);
+		if (!addr)
+			addr = kallrecon_find_variant(symbol_name, 1);
+		if (!addr)
+			addr = find_kernel_symbol_exact(symbol_name);
+	}
+#endif
+
+	return addr ? (void *)addr : NULL;
+}
+
+struct kr_collect {
+	unsigned long *addrs;
+	int max;
+	int n;
+};
+
+static void kr_collect_add(struct kr_collect *c, unsigned long addr)
+{
+	int i;
+
+	if (!addr)
+		return;
+	for (i = 0; i < c->n; i++)
+		if (c->addrs[i] == addr)
+			return;
+	if (c->n < c->max)
+		c->addrs[c->n++] = addr;
+}
+
+int ksu_find_symbol_all(const char *name, unsigned long *addrs, int max)
+{
+	struct slide_win w;
+	struct kr_collect c = { .addrs = addrs, .max = max };
+	char nbuf[KR_NAME_MAX];
+	unsigned int idx = 0;
+	int retried = 0;
+
+	if (!kr_ready || !name || !name[0] || !addrs || max <= 0)
+		return 0;
+
+	mutex_lock(&ks_linear_lock);
+	if (safe_read(ti_buf, (void *)klindex_addr, sizeof(ti_buf)) ||
+	    safe_read(tt_buf, (void *)kltable_addr, sizeof(tt_buf)) ||
+	    slide_init(&w, klnames_addr, KS_WIN_SIZE, KS_WIN_MARGIN))
+		goto out;
+
+	while (idx < klnum_val) {
+		const unsigned char *enc = slide_ptr(&w, slide_buf);
+		unsigned int len = enc[0];
+		unsigned int hdr = 1;
+
+		if (len & 0x80) {
+			len = (len & 0x7f) | (enc[1] << 7);
+			hdr = 2;
+		}
+
+		if (len > KR_NAME_MAX || w.off + hdr + len > w.valid) {
+			if (retried || slide_advance(&w, (w.valid - w.off) + 4))
+				break;
+			retried = 1;
+			continue;
+		}
+		retried = 0;
+
+		if (ks_expand_raw(enc, ti_buf, tt_buf, nbuf, sizeof(nbuf)) &&
+		    !strcmp(nbuf, name))
+			kr_collect_add(&c, sym_addr((int)idx));
+
+		if (slide_advance(&w, hdr + len))
+			break;
+		idx++;
+	}
+
+out:
+	mutex_unlock(&ks_linear_lock);
+	return c.n;
+}
+
+int ksu_symbol_name_of(unsigned long addr, char *buf, char **module_out)
+{
+	char *mod = NULL;
+
+	if (module_out)
+		*module_out = NULL;
+	if (!buf)
+		return -EINVAL;
+	buf[0] = '\0';
+	if (!kr_ready)
+		return -ENOSYS;
+	if (!addr)
+		return -EINVAL;
+
+	if (kr_lookup_fn) {
+		if (!kr_lookup(addr, &mod, buf))
+			return -ENOENT;
+		if (module_out)
+			*module_out = mod;
+		return (int)strlen(buf);
+	}
+
+	if (sym_name_at(addr, buf, KSYM_SYMBOL_LEN) < 0)
+		return -ENOENT;
+
+	return (int)strlen(buf);
+}
+
+int ksu_symbol_is_start(unsigned long addr, const char *name)
+{
+	char buf[KSYM_SYMBOL_LEN];
+	size_t len, nlen;
+	int idx;
+
+	if (!kr_ready || !addr || !name || !name[0])
+		return 0;
+
+	len = strlen(name);
+	if (len >= sizeof(buf))
+		return 0;
+
+	idx = sym_name_at(addr, buf, sizeof(buf));
+	nlen = strlen(buf);
+	if (idx >= 0 && sym_addr(idx) == addr && nlen >= len &&
+	    !strncmp(buf, name, len) &&
+	    (!buf[len] || buf[len] == '.' || buf[len] == '$') &&
+	    !strstr(buf + len, ".cfi_jt"))
+		return 1;
+
+	return ksu_addr_is_named(addr, name);
+}
+
+int ksu_addr_is_named(unsigned long addr, const char *name)
+{
+	unsigned long addrs[KR_ALL_MAX];
+	int n, i;
+
+	if (!kr_ready || !addr || !name || !name[0])
+		return 0;
+
+	n = ksu_find_symbol_all(name, addrs, (int)ARRAY_SIZE(addrs));
+	for (i = 0; i < n; i++)
+		if (addrs[i] == addr)
+			return 1;
+
+	return 0;
+}
+
+int __init ksu_init_symbol_resolver(void)
+{
+	struct kallrecon_hint hint;
+
+	memset(&hint, 0, sizeof(hint));
+	hint.timeout_ms = KR_TIMEOUT_MS;
+	kallrecon_supply(&hint);
+
+	find_kallsyms_base();
+
+	if (!kr_layout_ready() || !kallrecon_klp) {
+		memset(&hint, 0, sizeof(hint));
+		hint.scan_back = KR_SCAN_BACK * 2;
+		hint.scan_fwd = KR_SCAN_FWD * 2;
+		hint.timeout_ms = KR_TIMEOUT_MS;
+		kallrecon_supply(&hint);
+		kallrecon_retry();
+	}
+
+	if (!kr_layout_ready() || !kallrecon_klp) {
+		pr_err("symbol_resolver: kallrecon discovery failed (%d, klp=%d), refusing to load\n",
+		       kallrecon_fail_reason(), !!kallrecon_klp);
+		return -ENODATA;
+	}
+
+	kr_ready = true;
+
+	kr_lookup_fn = (void *)kr_klp("kallsyms_lookup");
+	if (!kr_lookup_fn)
+		pr_warn("symbol_resolver: kallsyms_lookup not resolved, module names unavailable\n");
+
+	SUSFS_LOGI("symbol_resolver: kallrecon layout v%d base=0x%lx num=%u klp=%d\n",
+		   (int)kl_layout, kernel_base, klnum_val, !!kallrecon_klp);
+
+	return 0;
+}
diff --git a/KernelSU/kernel/susfs/symbol_resolver.h b/KernelSU/kernel/susfs/symbol_resolver.h
new file mode 100644
index 000000000000..9aa78e80ee88
--- /dev/null
+++ b/KernelSU/kernel/susfs/symbol_resolver.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SUSFS_SYMBOL_RESOLVER_H
+#define __SUSFS_SYMBOL_RESOLVER_H
+
+void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name);
+unsigned long find_kernel_symbol_exact(const char *symbol_name);
+unsigned long find_kernel_symbol_exact_any(const char *symbol_name);
+int ksu_find_symbol_all(const char *name, unsigned long *addrs, int max);
+unsigned long ksu_kallsyms_lookup_name(const char *name);
+int ksu_symbol_name_of(unsigned long addr, char *buf, char **module_out);
+int ksu_symbol_is_start(unsigned long addr, const char *name);
+int ksu_addr_is_named(unsigned long addr, const char *name);
+int ksu_init_symbol_resolver(void);
+
+#endif
diff --git a/KernelSU/kernel/tools/check_symbol.c b/KernelSU/kernel/tools/check_symbol.c
new file mode 100644
index 000000000000..5ad16abe93d7
--- /dev/null
+++ b/KernelSU/kernel/tools/check_symbol.c
@@ -0,0 +1,200 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <elf.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+typedef struct {
+    void *data;
+    size_t size;
+    Elf64_Ehdr *ehdr;
+    Elf64_Shdr *shdr;
+    char *shstrtab;
+} ElfFile;
+
+int open_elf(const char *path, ElfFile *elf)
+{
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) {
+        fprintf(stderr, "Error: Cannot open file %s\n", path);
+        return -1;
+    }
+
+    struct stat st;
+    if (fstat(fd, &st) < 0) {
+        fprintf(stderr, "Error: Cannot stat file %s\n", path);
+        close(fd);
+        return -1;
+    }
+
+    elf->size = st.st_size;
+    elf->data = mmap(NULL, elf->size, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+
+    if (elf->data == MAP_FAILED) {
+        fprintf(stderr, "Error: Cannot mmap file %s\n", path);
+        return -1;
+    }
+
+    elf->ehdr = (Elf64_Ehdr *)elf->data;
+
+    if (memcmp(elf->ehdr->e_ident, ELFMAG, SELFMAG) != 0) {
+        fprintf(stderr, "Error: %s is not a valid ELF file\n", path);
+        munmap(elf->data, elf->size);
+        return -1;
+    }
+
+    if (elf->ehdr->e_ident[EI_CLASS] != ELFCLASS64) {
+        fprintf(stderr, "Error: %s is not a 64-bit ELF file\n", path);
+        munmap(elf->data, elf->size);
+        return -1;
+    }
+
+    elf->shdr = (Elf64_Shdr *)((char *)elf->data + elf->ehdr->e_shoff);
+
+    elf->shstrtab =
+        (char *)elf->data + elf->shdr[elf->ehdr->e_shstrndx].sh_offset;
+
+    return 0;
+}
+
+void close_elf(ElfFile *elf)
+{
+    munmap(elf->data, elf->size);
+}
+
+Elf64_Shdr *find_symtab(ElfFile *elf)
+{
+    for (int i = 0; i < elf->ehdr->e_shnum; i++) {
+        if (elf->shdr[i].sh_type == SHT_SYMTAB) {
+            return &elf->shdr[i];
+        }
+    }
+    return NULL;
+}
+
+Elf64_Shdr *find_section(ElfFile *elf, const char *name)
+{
+    for (int i = 0; i < elf->ehdr->e_shnum; i++) {
+        const char *section_name = elf->shstrtab + elf->shdr[i].sh_name;
+        if (strcmp(section_name, name) == 0) {
+            return &elf->shdr[i];
+        }
+    }
+    return NULL;
+}
+
+Elf64_Sym *find_symbol(ElfFile *elf, const char *name, Elf64_Shdr *symtab,
+                       char *strtab)
+{
+    Elf64_Sym *syms = (Elf64_Sym *)((char *)elf->data + symtab->sh_offset);
+    int sym_count = symtab->sh_size / sizeof(Elf64_Sym);
+
+    for (int i = 0; i < sym_count; i++) {
+        const char *sym_name = strtab + syms[i].st_name;
+        if (strcmp(sym_name, name) == 0) {
+            return &syms[i];
+        }
+    }
+    return NULL;
+}
+
+int main(int argc, char *argv[])
+{
+    if (argc != 3) {
+        fprintf(stderr, "Usage: %s <ko_elf> <vmlinux>\n", argv[0]);
+        return 1;
+    }
+
+    const char *ko_path = argv[1];
+    const char *vmlinux_path = argv[2];
+
+    ElfFile ko_elf, vmlinux;
+
+    if (open_elf(ko_path, &ko_elf) < 0) {
+        return 1;
+    }
+
+    if (open_elf(vmlinux_path, &vmlinux) < 0) {
+        close_elf(&ko_elf);
+        return 1;
+    }
+
+    Elf64_Shdr *ko_symtab = find_symtab(&ko_elf);
+    Elf64_Shdr *vmlinux_symtab = find_symtab(&vmlinux);
+    Elf64_Shdr *ko_version_sec = find_section(&ko_elf, "__versions");
+
+    if (!ko_symtab) {
+        fprintf(stderr, "Error: No symbol table found in %s\n", ko_path);
+        close_elf(&ko_elf);
+        close_elf(&vmlinux);
+        return 1;
+    }
+
+    if (!vmlinux_symtab) {
+        fprintf(stderr, "Error: No symbol table found in %s\n", vmlinux_path);
+        close_elf(&ko_elf);
+        close_elf(&vmlinux);
+        return 1;
+    }
+
+    if (!ko_version_sec) {
+        fprintf(stderr, "Error: No __versions section found in %s\n", ko_path);
+        close_elf(&ko_elf);
+        close_elf(&vmlinux);
+        return 1;
+    }
+
+    if (ko_version_sec->sh_size != 0) {
+        fprintf(
+            stderr,
+            "Error: __versions section in %s must have size 0 (actual=%llu)\n",
+            ko_path, (unsigned long long)ko_version_sec->sh_size);
+        close_elf(&ko_elf);
+        close_elf(&vmlinux);
+        return 1;
+    }
+
+    char *ko_strtab =
+        (char *)ko_elf.data + ko_elf.shdr[ko_symtab->sh_link].sh_offset;
+    char *vmlinux_strtab =
+        (char *)vmlinux.data + vmlinux.shdr[vmlinux_symtab->sh_link].sh_offset;
+
+    Elf64_Sym *ko_syms =
+        (Elf64_Sym *)((char *)ko_elf.data + ko_symtab->sh_offset);
+    int ko_sym_count = ko_symtab->sh_size / sizeof(Elf64_Sym);
+
+    int has_error = 0;
+
+    for (int i = 0; i < ko_sym_count; i++) {
+        if (ko_syms[i].st_shndx == SHN_UNDEF && ko_syms[i].st_name != 0) {
+            const char *sym_name = ko_strtab + ko_syms[i].st_name;
+
+            Elf64_Sym *vmlinux_sym =
+                find_symbol(&vmlinux, sym_name, vmlinux_symtab, vmlinux_strtab);
+
+            if (!vmlinux_sym || vmlinux_sym->st_shndx == SHN_UNDEF) {
+                fprintf(stderr,
+                        "Error: Symbol '%s' not found or undefined in %s\n",
+                        sym_name, vmlinux_path);
+                has_error = 1;
+            } else {
+                int binding = ELF64_ST_BIND(vmlinux_sym->st_info);
+                if (binding != STB_GLOBAL && binding != STB_WEAK) {
+                    fprintf(
+                        stderr,
+                        "Warning: Symbol '%s' is defined in %s but not global (binding=%d)\n",
+                        sym_name, vmlinux_path, binding);
+                }
+            }
+        }
+    }
+
+    close_elf(&ko_elf);
+    close_elf(&vmlinux);
+
+    return has_error ? 1 : 0;
+}
diff --git a/KernelSU/uapi/app_profile.h b/KernelSU/uapi/app_profile.h
new file mode 100644
index 000000000000..bf3f6446db84
--- /dev/null
+++ b/KernelSU/uapi/app_profile.h
@@ -0,0 +1,67 @@
+#ifndef __KSU_UAPI_APP_PROFILE_H
+#define __KSU_UAPI_APP_PROFILE_H
+
+#include <linux/types.h>
+
+#define KSU_APP_PROFILE_VER 4
+#define KSU_MAX_PACKAGE_NAME 256
+/* NGROUPS_MAX for Linux is 65535 generally, but we only supports 32 groups. */
+#define KSU_MAX_GROUPS 32
+#define KSU_SELINUX_DOMAIN 64
+
+#define FLAG_KSU_NO_NEW_PRIVS (1ULL << 0)
+
+struct root_profile {
+    __s32 uid;
+    __s32 gid;
+
+    __u32 groups_count;
+    __s32 groups[KSU_MAX_GROUPS];
+
+    /* kernel_cap_t is u32[2] for capabilities v3 */
+    struct {
+        __u64 effective;
+        __u64 permitted;
+        __u64 inheritable;
+    } capabilities;
+
+    char selinux_domain[KSU_SELINUX_DOMAIN];
+
+    __s32 namespaces;
+
+    __u64 flags;
+};
+
+struct non_root_profile {
+    bool umount_modules;
+};
+
+struct app_profile {
+    /*
+     * It may be utilized for backward compatibility, although we have never
+     * explicitly made any promises regarding this.
+     */
+    __u32 version;
+
+    /* this is usually the package of the app, but can be other value for special apps */
+    char key[KSU_MAX_PACKAGE_NAME];
+    __s32 curr_uid;
+    bool allow_su;
+
+    union {
+        struct {
+            bool use_default;
+            char template_name[KSU_MAX_PACKAGE_NAME];
+
+            struct root_profile profile;
+        } rp_config;
+
+        struct {
+            bool use_default;
+
+            struct non_root_profile profile;
+        } nrp_config;
+    };
+};
+
+#endif
