# KernelSU-Next (default branch dev): SUSFS is loaded as a kernel module (LKM)
VARIANT_NAME=kernelsu-next-susfs
UPSTREAM_URL=https://github.com/KernelSU-Next/KernelSU-Next
UPSTREAM_REF=dev
UPSTREAM_COMMIT=7ccf614
SUSFS=susfs4ksu-lkm (susfs.ko, loaded at runtime by the manager/ksud)
OUTPUT_TAG=kernelsu-next-susfs
NOTES=upstream documents "built-in SUSFS LKM driver loading"; kernel/susfs/ carries the LKM-side sources (HooKern/kallrecon/btf_layout) and is not part of a static KSU patch, so this variant only vendors KSU plus CONFIG_KSU=y; susfs features depend on susfs.ko
